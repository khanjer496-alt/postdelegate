---
// Real customer reviews only. They come from the in-app review form: approved by
// an admin and published with the author's consent. src/data/testimonials.json
// is written by scripts/pull-testimonials.mjs before a deploy and stays an
// empty array until there are reviews, in which case nothing is rendered.
import data from '../data/testimonials.json';
import { strings, type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings(lang).testimonials;
interface Testimonial { displayName: string; roleCompany?: string | null; rating: number; text: string; date?: string }
const items = (Array.isArray(data) ? (data as Testimonial[]) : []).filter((t) => t && typeof t.displayName === 'string' && t.displayName.trim() && typeof t.text === 'string' && t.text.trim() && Number.isInteger(t.rating) && t.rating >= 1 && t.rating <= 5).slice(0, 6);
---
{items.length > 0 && (
  <section class="testimonials-section section" aria-labelledby="testimonials-title">
    <div class="container">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-heading" id="testimonials-title">{t.title}</h2>
      <div class="testimonial-grid">
        {items.map((item) => (
          <figure class="testimonial-card">
            <div class="testimonial-stars" role="img" aria-label={t.stars(item.rating)}>{'★'.repeat(item.rating)}<span aria-hidden="true">{'★'.repeat(5 - item.rating)}</span></div>
            <blockquote>{item.text}</blockquote>
            <figcaption><b>{item.displayName}</b>{item.roleCompany ? <span>{item.roleCompany}</span> : null}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .testimonials-section{text-align:center;padding-top:130px}.testimonials-section .eyebrow{margin-bottom:24px}.testimonial-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;margin-top:60px;text-align:start}.testimonial-card{display:flex;flex-direction:column;gap:20px;margin:0;padding:30px;border-radius:24px;border:1px solid #343434;background:#181818}.testimonial-stars{color:#c8ff4d;font-size:17px;letter-spacing:2px}.testimonial-stars span{color:#444}.testimonial-card blockquote{margin:0;flex:1;color:#dedede;font-size:16px;line-height:1.7;white-space:pre-line;overflow-wrap:anywhere}.testimonial-card figcaption{display:flex;flex-direction:column;gap:3px;font-size:14px}.testimonial-card figcaption b{font-weight:650}.testimonial-card figcaption span{color:#999;font-size:13px}@media(max-width:767px){.testimonials-section{padding-top:70px}.testimonial-grid{grid-template-columns:1fr;margin-top:35px;gap:15px}.testimonial-card{padding:25px}}
</style>
