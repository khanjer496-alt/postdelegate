---
import { SITE } from '../data/site';
// Affiliate links point here (postdelegate.com/?ref=CODE); sign-up happens on
// app.postdelegate.com. A visitor with a referral code is asked first. On a yes
// the code goes in the first-touch pd_ref cookie the app also writes
// ("<code>.<ms>", 60 days, shared across *.postdelegate.com). On a no, or no
// answer, nothing is stored: the code and any utm_* values ride along in the
// links of this visit, and the sign-up form sends them to the app.
// The answer itself is kept in pd_consent for 6 months, shared with the app,
// and the footer's Cookie settings button reopens it to change it.
---
<div class="ref-consent" role="region" aria-label="Referral cookie" tabindex="-1" data-ref-consent hidden>
  <p data-ref-mode="ask">Allow a cookie to remember who referred you, so they get credit if you sign up? <a href={`${SITE.legal.privacy}#cookies`}>Learn more</a></p>
  <div data-ref-mode="settings" hidden>
    <p class="ref-consent-title">Cookie settings</p>
    <p>This site only uses the cookies it needs to work, plus one optional referral cookie that remembers who referred you, so they get credit if you sign up. Nothing else, no analytics or advertising. <a href={`${SITE.legal.privacy}#cookies`}>Privacy policy</a></p>
    <p class="ref-consent-status">Referral cookie: <strong data-ref-status></strong></p>
  </div>
  <div class="ref-consent-actions">
    <button type="button" class="ref-consent-button" data-ref-answer="no">No thanks</button>
    <button type="button" class="ref-consent-button" data-ref-answer="yes">Accept</button>
  </div>
</div>
<script>
  import { SITE } from '../data/site';

  const CODE = /^[a-z0-9][a-z0-9-]{2,23}$/;
  const CARRIED = ['ref', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm'];
  const DAY = 86400;
  const app = new URL(SITE.app).origin;

  const params = new URLSearchParams(location.search);
  const code = (params.get('ref') || '').trim().toLowerCase();
  const ref = CODE.test(code) ? code : '';
  const carried = CARRIED.flatMap((name) => {
    const value = name === 'ref' ? ref : (params.get(name) || '').slice(0, 200);
    return value ? [[name, value] as const] : [];
  });

  const cookie = (name: string) => document.cookie.split('; ').find((row) => row.startsWith(`${name}=`))?.slice(name.length + 1);
  const domain = /(^|\.)postdelegate\.com$/.test(location.hostname) ? '; domain=.postdelegate.com' : '';
  const write = (name: string, value: string, days: number) => {
    document.cookie = `${name}=${value}; max-age=${days * DAY}; path=/; samesite=lax${location.protocol === 'https:' ? '; secure' : ''}${domain}`;
  };
  // first touch: a referral already remembered is never replaced
  const saveReferral = () => {
    if (ref && !cookie('pd_ref')) write('pd_ref', `${ref}.${Date.now()}`, 60);
  };
  const removeReferral = () => {
    document.cookie = `pd_ref=; max-age=0; path=/${domain}`;
    document.cookie = 'pd_ref=; max-age=0; path=/';
  };

  // Carry the values in this visit's own links and the sign-up links, nothing stored
  if (carried.length) {
    document.querySelectorAll<HTMLAnchorElement>('a[href]:not([href^="#"])').forEach((link) => {
      const url = new URL(link.href, location.href);
      const internal = url.origin === location.origin;
      // the app's home sends a signed-out visitor to /auth with the same query
      const signup = url.origin === app && (url.pathname === '/' || url.pathname.startsWith('/auth'));
      if (!internal && !signup) return;
      carried.forEach(([name, value]) => {
        if (!url.searchParams.has(name)) url.searchParams.set(name, value);
      });
      link.href = url.href;
    });
  }

  if (ref && cookie('pd_consent') === 'yes') saveReferral();

  const prompt = document.querySelector<HTMLElement>('[data-ref-consent]');
  if (prompt) {
    let opener: HTMLElement | null = null;
    const hide = () => {
      prompt.hidden = true;
      document.removeEventListener('keydown', onKey);
      opener?.focus();
      opener = null;
    };
    // Escape closes it without answering, nothing is stored
    const onKey = (event: KeyboardEvent) => event.key === 'Escape' && hide();
    const show = (mode: 'ask' | 'settings') => {
      prompt.querySelectorAll<HTMLElement>('[data-ref-mode]').forEach((part) => (part.hidden = part.dataset.refMode !== mode));
      const consent = cookie('pd_consent');
      const status = prompt.querySelector<HTMLElement>('[data-ref-status]');
      if (status) status.textContent = consent === 'yes' ? 'allowed' : consent === 'no' ? 'not allowed' : 'not chosen yet';
      document.addEventListener('keydown', onKey);
      prompt.hidden = false;
    };
    prompt.querySelectorAll<HTMLButtonElement>('[data-ref-answer]').forEach((button) => button.addEventListener('click', () => {
      const answer = button.dataset.refAnswer === 'yes' ? 'yes' : 'no';
      write('pd_consent', answer, 180);
      if (answer === 'yes') saveReferral();
      else removeReferral();
      hide();
    }));
    // the footer link reopens the choice, so it can be changed as easily as it was given
    document.querySelectorAll<HTMLElement>('[data-cookie-settings]').forEach((button) => button.addEventListener('click', () => {
      opener = button;
      show('settings');
      prompt.focus();
    }));
    const consent = cookie('pd_consent');
    if (ref && consent !== 'yes' && consent !== 'no') show('ask');
  }
</script>
<style>
  .ref-consent{position:fixed;z-index:90;left:16px;right:16px;bottom:16px;margin-inline:auto;max-width:440px;display:flex;flex-direction:column;gap:14px;padding:18px;border:1px solid #303030;border-radius:18px;background:#171717;box-shadow:0 20px 60px #000a;color:#fff;font-size:14px;line-height:1.55}
  .ref-consent:focus{outline:none}.ref-consent:focus-visible{outline:2px solid #c8ff4d;outline-offset:3px}
  .ref-consent p{margin:0}.ref-consent [data-ref-mode="settings"]{display:flex;flex-direction:column;gap:8px}.ref-consent [data-ref-mode][hidden]{display:none}
  .ref-consent-title{font-size:15px;font-weight:700}.ref-consent-status{color:#b9b9b9}.ref-consent-status strong{color:#fff;font-weight:650}
  .ref-consent a{color:#d1bfff;text-decoration:underline;text-underline-offset:3px}.ref-consent a:hover{color:#fff}
  .ref-consent-actions{display:flex;justify-content:flex-end;gap:8px}
  /* both answers look the same: saying no is as easy as saying yes */
  .ref-consent-button{min-height:40px;padding:8px 18px;border:1px solid #777;border-radius:100px;background:transparent;color:#fff;font-size:14px;font-weight:650;transition:background .18s,border-color .18s}.ref-consent-button:hover{background:#222;border-color:#fff}
</style>
