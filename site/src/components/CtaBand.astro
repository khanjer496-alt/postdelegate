---
import { SITE } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Your next great post starts here.', text = 'Give your ideas a home. Plan your content, find your rhythm, and bring your social channels together.' } = Astro.props;
---
<section class="cta-section">
  <div class="cta-panel">
    <span class="cta-orbit orbit-one" aria-hidden="true"></span><span class="cta-orbit orbit-two" aria-hidden="true"></span>
    <div class="cta-content"><p class="cta-eyebrow">MAKE ROOM FOR YOUR NEXT IDEA</p><h2>{title}</h2><p class="cta-description">{text}</p><a href={SITE.signup} class="cta-button">Create your workspace <span aria-hidden="true">↗</span></a><p class="cta-note">7-day free trial · More networks open as platform approvals are completed.</p></div>
  </div>
</section>
<style>
  .cta-section{padding:70px 24px 90px;background:var(--bg,#0d0d0d)}.cta-panel{position:relative;isolation:isolate;overflow:hidden;width:min(1160px,100%);margin:auto;border:1px solid #323232;border-radius:28px;background:radial-gradient(ellipse at 50% 130%,#3b245c 0%,#171419 52%,#151515 80%);padding:78px 30px 64px;text-align:center;color:#fff}.cta-content{position:relative;z-index:1}.cta-eyebrow{margin:0 0 22px;color:#bfb2d0;font-size:10px;letter-spacing:1.7px;font-weight:600}.cta-panel h2{max-width:760px;margin:0 auto;font-size:clamp(32px,4.8vw,58px);line-height:1.16;font-weight:500;letter-spacing:-2.6px;text-wrap:balance}.cta-description{max-width:510px;margin:22px auto 0;font-size:14px;line-height:1.9;color:#a6a6a6;text-wrap:pretty}.cta-button{display:inline-flex;align-items:center;justify-content:center;gap:23px;min-height:49px;padding:0 26px;margin-top:29px;border-radius:999px;background:#fff;color:#101010;text-decoration:none;font-size:12px;font-weight:700;transition:background .2s,transform .2s}.cta-button span{font-size:18px}.cta-button:hover{background:#e5e5e5;transform:translateY(-2px)}.cta-button:focus-visible{outline:2px solid #bdaaff;outline-offset:5px}.cta-note{margin:19px auto 0;max-width:520px;color:#8e8595;font-size:10px;line-height:1.7}.cta-orbit{position:absolute;z-index:0;left:50%;top:50%;width:1300px;height:420px;border:1px solid #ffffff08;border-radius:50%;pointer-events:none;transform:translate(-50%,-50%) rotate(-26deg)}.orbit-two{transform:translate(-50%,-50%) rotate(26deg)}@media(max-width:600px){.cta-section{padding:35px 20px 55px}.cta-panel{border-radius:22px;padding:51px 23px 40px}.cta-panel h2{font-size:34px;letter-spacing:-1.6px}.cta-eyebrow{font-size:9px;letter-spacing:1.2px}.cta-description{font-size:12px;line-height:1.8}.cta-note{font-size:9px;max-width:260px}.cta-button{font-size:12px}}@media(prefers-reduced-motion:reduce){.cta-button{transition:none}}
</style>
