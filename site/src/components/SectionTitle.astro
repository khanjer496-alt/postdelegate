---
import OrbitAccent from './OrbitAccent.astro';
// Centered title; `mark` words get an orbit arc underneath or an orbit ring around them.
interface Props { title: string; mark?: string; kind?: 'arc' | 'ring'; sub?: string; id?: string }
const { title, mark, kind = 'arc', sub, id } = Astro.props;
const parts = mark ? title.split(mark) : [title];
---
<div class="mx-auto max-w-3xl text-center">
  <h2 class="h2" id={id}>
    {parts[0]}{mark && (<span class="relative inline-block whitespace-nowrap">{mark}{kind === 'arc' ? <OrbitAccent kind="arc" class="absolute inset-x-0 -bottom-2 h-3 text-brand" /> : <OrbitAccent kind="ring" class="absolute -inset-x-3 -inset-y-2 text-brand" />}</span>)}{parts[1] ?? ''}
  </h2>
  {sub && <p class="lead mx-auto mt-5 max-w-2xl">{sub}</p>}
</div>
