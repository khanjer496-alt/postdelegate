---
// Original PostDelegate illustrations for the "Built for how you publish" section.
// Each scene is built around the orbit from the logo mark: a tilted ring with a
// Signal Lime dot that travels along it (only when motion is allowed).
interface Props { kind: 'creator' | 'team' | 'developer' }
const { kind } = Astro.props;

type Orbit = { cx: number; cy: number; rx: number; ry: number; tilt: number };
const rad = (deg: number) => (deg * Math.PI) / 180;
const r1 = (n: number) => Math.round(n * 10) / 10;
// A point on a tilted ellipse, t in degrees (0 = right end, 90 = front/bottom).
const at = (o: Orbit, t: number) => {
  const c = Math.cos(rad(o.tilt)), s = Math.sin(rad(o.tilt));
  const x = o.rx * Math.cos(rad(t)), y = o.ry * Math.sin(rad(t));
  return { x: r1(o.cx + x * c - y * s), y: r1(o.cy + x * s + y * c) };
};
// The whole ellipse as a path.
const ring = (o: Orbit) => {
  const a = at(o, 0), b = at(o, 180);
  return `M${a.x} ${a.y}A${o.rx} ${o.ry} ${o.tilt} 1 1 ${b.x} ${b.y}A${o.rx} ${o.ry} ${o.tilt} 1 1 ${a.x} ${a.y}Z`;
};
// The front half only, drawn over the scene for depth.
const front = (o: Orbit) => {
  const a = at(o, 0), b = at(o, 180);
  return `M${a.x} ${a.y}A${o.rx} ${o.ry} ${o.tilt} 0 1 ${b.x} ${b.y}`;
};

const orbits: Record<Props['kind'], Orbit> = {
  creator: { cx: 180, cy: 160, rx: 162, ry: 58, tilt: -7 },
  team: { cx: 180, cy: 122, rx: 152, ry: 54, tilt: -14 },
  developer: { cx: 180, cy: 120, rx: 150, ry: 68, tilt: 8 },
};
const o = orbits[kind];
// The lime dot rides the orbit the same way the hero orbit does: a spinning group
// plus a counter-spinning one. The squash that turns the circle path into the
// tilted ellipse is undone inside, so the dot stays round at every angle.
const startAngle = { creator: 43, team: 137, developer: 223 }[kind];
const squash = Number((o.ry / o.rx).toFixed(4));
const unsquash = Number((o.rx / o.ry).toFixed(4));
const id = `pa-${kind}`;
const avatars = [
  { t: 196, fill: '#7357FF', ink: '#fff', letter: 'M' },
  { t: 338, fill: '#C8FF4D', ink: '#0d0d0d', letter: 'A' },
  { t: 104, fill: '#D1BFFF', ink: '#1b1530', letter: 'J' },
].map((a) => ({ ...a, ...at(o, a.t) }));
const tones: Record<number, string> = { 2: '#7357FF', 6: '#C8FF4D', 9: '#D1BFFF', 13: '#7357FF', 15: '#C8FF4D', 18: '#D1BFFF' };
const cells = Array.from({ length: 20 }, (_, i) => ({ x: 124 + (i % 5) * 23, y: 84 + Math.floor(i / 5) * 23, fill: tones[i] ?? '#E7E2EF' }));
const sky = [[26, 30], [312, 22], [338, 92], [20, 118], [300, 214], [58, 214], [250, 12], [118, 16]];
---
<svg class:list={['persona-svg', `persona-svg-${kind}`]} viewBox="0 0 360 240" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-violet`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8E78FF"/><stop offset="1" stop-color="#4B33D6"/></linearGradient>
    <radialGradient id={`${id}-glow`} cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#7357FF" stop-opacity=".45"/><stop offset="1" stop-color="#7357FF" stop-opacity="0"/></radialGradient>
  </defs>
  {sky.map(([x, y], i) => <circle cx={x} cy={y} r={i % 3 === 0 ? 1.6 : 1} fill="#F7F7F2" opacity={i % 2 ? .22 : .38}/>)}
  <ellipse cx={o.cx} cy={o.cy} rx={o.rx * .62} ry={o.ry * 1.9} fill={`url(#${id}-glow)`}/>
  <path d={ring(o)} stroke="#7357FF" stroke-opacity=".38" stroke-width="1.5" stroke-dasharray="1 7" stroke-linecap="round"/>

  {kind === 'creator' && <>
    {/* A week in the calendar with one open slot */}
    <rect x="40" y="114" width="280" height="96" rx="16" fill="#16141C" stroke="#2F2B3B"/>
    {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, i) => <text x={60 + i * 40} y="134" text-anchor="middle" font-size="9" font-weight="700" fill={i === 3 ? '#C8FF4D' : '#8B849C'}>{d}</text>)}
    {[1, 2, 3, 4, 5, 6].map((i) => <path d={`M${40 + i * 40} 142V198`} stroke="#25222E"/>)}
    <rect x="46" y="150" width="28" height="9" rx="4.5" fill="#7357FF" opacity=".55"/>
    <rect x="126" y="170" width="28" height="9" rx="4.5" fill="#B39AFF" opacity=".45"/>
    <rect x="246" y="156" width="28" height="9" rx="4.5" fill="#7357FF" opacity=".55"/>
    <rect x="286" y="178" width="28" height="9" rx="4.5" fill="#B39AFF" opacity=".35"/>
    <rect x="164" y="148" width="32" height="44" rx="8" fill="#C8FF4D" fill-opacity=".12" stroke="#C8FF4D" stroke-dasharray="3 3"/>
    <text x="180" y="204" text-anchor="middle" font-size="8" font-weight="700" fill="#C8FF4D">09:00</text>
    {/* The post on its way into the slot */}
    <path d="M178 104C190 116 188 130 181 144" stroke="#C8FF4D" stroke-width="1.6" stroke-dasharray="2 4" stroke-linecap="round"/>
    <path d="M176 139l5 6 5-5" stroke="#C8FF4D" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    <g class="persona-float" transform="rotate(-7 128 66)">
      <rect x="76" y="22" width="112" height="88" rx="13" fill="#F7F7F2"/>
      <rect x="84" y="30" width="96" height="44" rx="8" fill={`url(#${id}-violet)`}/>
      <circle cx="162" cy="44" r="7" fill="#C8FF4D"/>
      <path d="M84 66l20-17 14 11 13-9 32 23v1a8 8 0 0 1-8 8H92a8 8 0 0 1-8-8Z" fill="#2A1F6E" opacity=".75"/>
      <circle cx="91" cy="88" r="5" fill="#7357FF"/>
      <rect x="101" y="84" width="58" height="4.5" rx="2.25" fill="#2A2535"/>
      <rect x="101" y="94" width="38" height="4.5" rx="2.25" fill="#B9B1C9"/>
    </g>
    <g transform="translate(232 40)">
      <rect width="98" height="30" rx="15" fill="#1C1A24" stroke="#36314A"/>
      <circle cx="16" cy="15" r="4" fill="#C8FF4D"/>
      <text x="27" y="19" font-size="10" font-weight="700" fill="#ECE8F6">Thu, 09:00</text>
    </g>
  </>}

  {kind === 'team' && <>
    {avatars.filter((a) => a.y < o.cy).map((a) => <g><circle cx={a.x} cy={a.y} r="19" fill="#0F0E13"/><circle cx={a.x} cy={a.y} r="15" fill={a.fill}/><text x={a.x} y={a.y + 4.5} text-anchor="middle" font-size="13" font-weight="800" fill={a.ink}>{a.letter}</text></g>)}
    {/* One shared calendar */}
    <rect x="110" y="48" width="140" height="140" rx="16" fill="#F7F7F2"/>
    <rect x="124" y="62" width="54" height="7" rx="3.5" fill="#2A2535"/>
    <circle cx="228" cy="65.5" r="5" fill="#7357FF"/>
    <circle cx="216" cy="65.5" r="5" fill="#C8FF4D" stroke="#F7F7F2" stroke-width="1.5"/>
    {cells.map((c) => <rect x={c.x} y={c.y} width="18" height="18" rx="5" fill={c.fill}/>)}
  </>}

  {kind === 'developer' && <>
    {/* API braces around a terminal */}
    <path d="M78 56c-16 0-18 8-18 22v18c0 12-6 18-16 24 10 6 16 12 16 24v18c0 14 2 22 18 22" stroke={`url(#${id}-violet)`} stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M282 56c16 0 18 8 18 22v18c0 12 6 18 16 24-10 6-16 12-16 24v18c0 14-2 22-18 22" stroke={`url(#${id}-violet)`} stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="98" y="60" width="164" height="120" rx="14" fill="#121117" stroke="#36314A"/>
    <path d="M98 74a14 14 0 0 1 14-14h136a14 14 0 0 1 14 14v8H98Z" fill="#1C1A24"/>
    {[0, 1, 2].map((i) => <circle cx={112 + i * 11} cy="71" r="3.2" fill="#3C3650"/>)}
    <text x="112" y="104" font-size="11" font-weight="800" fill="#C8FF4D" font-family="ui-monospace,Menlo,monospace">$</text>
    <rect x="124" y="97" width="74" height="6" rx="3" fill="#D1BFFF"/>
    <rect x="204" y="97" width="30" height="6" rx="3" fill="#6E6585"/>
    <rect x="112" y="115" width="44" height="6" rx="3" fill="#6E6585"/>
    <rect x="162" y="115" width="62" height="6" rx="3" fill="#7357FF"/>
    <rect x="112" y="133" width="96" height="6" rx="3" fill="#4A4460"/>
    <text x="112" y="161" font-size="11" font-weight="800" fill="#C8FF4D" font-family="ui-monospace,Menlo,monospace">$</text>
    <rect class="persona-caret" x="124" y="152" width="8" height="12" rx="1.5" fill="#C8FF4D"/>
    <g transform="translate(206 152)">
      <rect width="44" height="18" rx="9" fill="#C8FF4D" fill-opacity=".14" stroke="#C8FF4D" stroke-opacity=".6"/>
      <text x="22" y="12.5" text-anchor="middle" font-size="8.5" font-weight="800" fill="#C8FF4D" font-family="ui-monospace,Menlo,monospace">200</text>
    </g>
  </>}

  <path d={front(o)} stroke="#7357FF" stroke-width="2" stroke-linecap="round" opacity=".9"/>
  {kind === 'team' ? <>
    {avatars.filter((a) => a.y >= o.cy).map((a) => <g><circle cx={a.x} cy={a.y} r="19" fill="#0F0E13"/><circle cx={a.x} cy={a.y} r="15" fill={a.fill}/><text x={a.x} y={a.y + 4.5} text-anchor="middle" font-size="13" font-weight="800" fill={a.ink}>{a.letter}</text></g>)}
    <g transform="translate(18 20)">
      <rect width="78" height="28" rx="14" fill="#1C1A24" stroke="#36314A"/>
      <circle cx="15" cy="14" r="4" fill="#C8FF4D"/>
      <text x="25" y="18" font-size="10" font-weight="700" fill="#ECE8F6">Shared</text>
    </g>
  </> : <circle class="persona-planet" cx={at(o, 160).x} cy={at(o, 160).y} r="5" fill="#B39AFF"/>}
  <g transform={`translate(${o.cx} ${o.cy}) rotate(${o.tilt}) scale(1 ${squash})`}>
    <g class="persona-spin" transform={`rotate(${startAngle})`}><g transform={`translate(${o.rx} 0)`}><g class="persona-counter" transform={`rotate(${-startAngle}) scale(1 ${unsquash})`}>
      <circle r="6" fill="#C8FF4D" stroke="#0D0D0D" stroke-width="2.5"/>
    </g></g></g>
  </g>
</svg>
