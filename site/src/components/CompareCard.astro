---
// Comparison card for the home page and /compare. The PostDelegate mark sits beside a neutral
// monogram for each other tool: we do not reproduce other companies' logos.
interface Props { href: string; title: string; text: string; tools: string[]; as?: 'h2' | 'h3'; cta?: string }
const { href, title, text, tools, as = 'h3', cta = 'Read the comparison' } = Astro.props;
const Heading = as;
const monogram = (name: string) => { const words = name.replace(/[^A-Za-z ]/g, '').split(' ').filter(Boolean); return words.length > 1 ? words.map((w) => w[0]).join('').slice(0, 2).toUpperCase() : name.slice(0, 2); };
---
<a class="cc" href={href}>
  <span class="cc-logos" aria-hidden="true">
    {tools.map((t, i) => <>
      {i > 0 && <span class="cc-vs">vs</span>}
      {t === 'PostDelegate' ? <img class="cc-mark" src="/mark.svg" width="36" height="36" alt="" /> : <span class="cc-mono">{monogram(t)}</span>}
    </>)}
  </span>
  <Heading class="cc-title">{title}</Heading>
  <p class="cc-text">{text}</p>
  <span class="cc-cta">{cta} <span aria-hidden="true">↗</span></span>
</a>
<style>
  .cc { display: flex; flex-direction: column; height: 100%; padding: 22px; border: 1px solid #2c2c2c; border-radius: 20px; background: linear-gradient(180deg, #17151c, #131313); color: #fff; text-decoration: none !important; transition: border-color .2s, transform .2s; }
  .cc:hover { border-color: #7357ff; transform: translateY(-3px); }
  .cc-logos { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
  .cc-mark { width: 36px; height: 36px; border-radius: 10px; }
  .cc-mono { display: inline-grid; place-items: center; width: 36px; height: 36px; border: 1px solid #3a3a3a; border-radius: 10px; background: #222; color: #e6e6e6; font-size: 12px; font-weight: 800; letter-spacing: .02em; }
  .cc-vs { color: #8e8e8e; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .cc .cc-title { margin: 0; color: #fff; font-size: 18px; font-weight: 750; letter-spacing: -.02em; line-height: 1.3; }
  .cc .cc-text { margin: 8px 0 0; color: #acacac; font-size: 14px; line-height: 1.6; }
  .cc-cta { margin-top: auto; padding-top: 18px; color: #d1bfff; font-size: 13.5px; font-weight: 700; }
</style>
