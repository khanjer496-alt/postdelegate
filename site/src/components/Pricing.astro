---
import { PLANS } from '../data/plans';
import { SITE } from '../data/site';
interface Props { heading?: boolean }
const { heading = true } = Astro.props;
---
<div class="pricing">
  {heading && (
    <div class="pricing-heading">
      <p class="eyebrow">Early access</p>
      <h2>Find your publishing rhythm.</h2>
      <p class="muted">Start with a workspace. Paid plans and their full details will be announced before checkout opens.</p>
    </div>
  )}
  <div class="plan-grid">
    {PLANS.map((plan) => (
      <article class:list={['plan-card', { 'plan-featured': plan.popular }]}>
        <div class="plan-topline">
          <h3>{plan.name}</h3>
          {plan.popular && <span class="plan-badge">Built for collaboration</span>}
        </div>
        <p class="plan-tagline">{plan.tagline}</p>
        <p class="plan-status">Plans coming soon</p>
        <p class="plan-description muted">{plan.description}</p>
        <a href={plan.slug === 'custom' ? `mailto:${SITE.email}` : SITE.signup} class:list={['button', { 'button-outline': !plan.popular }]}>
          {plan.slug === 'custom' ? 'Talk to us' : 'Create a workspace'}
        </a>
        <ul>
          {plan.features.map((feature) => <li><span aria-hidden="true">✓</span>{feature}</li>)}
        </ul>
      </article>
    ))}
  </div>
  <p class="pricing-note muted">These are use cases, not paid packages. Checkout is not active, and no prices, trial terms or usage allowances are being offered here.</p>
</div>
<style>
  .pricing-heading { text-align: center; max-width: 730px; margin: 0 auto 48px; }
  .pricing-heading h2 { font-size: clamp(34px, 5vw, 58px); line-height: 1.07; letter-spacing: -.045em; margin: 16px 0 20px; }
  .pricing-heading > p:last-child { line-height: 1.75; font-size: 17px; }
  .plan-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .plan-card { display: flex; flex-direction: column; padding: 28px 23px; border: 1px solid #383838; border-radius: 22px; background: #171717; color: #fff; }
  .plan-featured { border: 2px solid #f3f3f3; padding: 27px 22px; background: #f3f3f3; color: #151515; }
  .plan-topline { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; min-height: 70px; }
  .plan-topline h3 { font-size: 24px; line-height: 1.15; font-weight: 800; letter-spacing: -.035em; }
  .plan-badge { padding: 5px 9px; border-radius: 100px; color: #fff; background: #151515; font-size: 10px; line-height: 1.3; font-weight: 700; }
  .plan-tagline { margin-top: 12px; font-size: 14px; line-height: 1.6; }
  .plan-status { margin-top: 28px; font-size: 23px; line-height: 1.25; font-weight: 800; letter-spacing: -.035em; }
  .plan-description { color: #b9b9b9; margin: 12px 0 24px; font-size: 14px; line-height: 1.75; min-height: 76px; }
  .plan-card .button { width: 100%; margin-top: auto; color: #fff; border-color: #777; background: transparent; }
  .plan-card .button:hover { color: #151515; background: #fff; border-color: #fff; }
  .plan-featured .plan-description { color: #62626b; }
  .plan-featured .button { color: #fff; background: #151515; border-color: #151515; }
  .plan-featured .button:hover { color: #fff; background: #333; border-color: #333; }
  .plan-card ul { display: grid; gap: 13px; margin: 28px 0 0; padding: 24px 0 0; list-style: none; border-top: 1px solid #383838; font-size: 13px; line-height: 1.65; }
  .plan-featured ul { border-top-color: #d7d7dc; }
  .plan-card li { display: flex; align-items: flex-start; gap: 9px; }
  .plan-card li > span { flex: none; font-weight: 800; }
  .pricing-note { max-width: 750px; margin: 28px auto 0; text-align: center; font-size: 13px; line-height: 1.8; }
  @media (max-width: 1000px) { .plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .plan-grid { grid-template-columns: 1fr; } .plan-topline { min-height: auto; } .plan-description { min-height: auto; } }
</style>
