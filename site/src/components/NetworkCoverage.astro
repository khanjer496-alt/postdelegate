---
import { AVAILABLE_NETWORKS, WAITING_NETWORKS } from '../data/networks';
import { strings, localeHref, type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings(lang);
---
<aside class="network-coverage" aria-label={t.platformsPage.h1(AVAILABLE_NETWORKS.length)}>
  <div class="coverage-available"><strong>{t.launch.available(AVAILABLE_NETWORKS.length)}</strong><p>{t.launch.examples}</p><a href={localeHref(lang, '/platforms')}>{t.networkGrid.status} ↗</a></div>
  <div><strong>{t.launch.pending}</strong><p>{WAITING_NETWORKS.map((n) => n.name).join(' · ')}</p></div>
  <div><strong>{t.launch.unavailable}</strong><p>X</p></div>
</aside>
<style>
  .network-coverage{display:grid;grid-template-columns:1.15fr 1.4fr .45fr;gap:20px;margin:24px auto 32px;padding:20px 24px;border:1px solid #363636;border-radius:18px;background:#151515;color:#b9b9b9;text-align:start;font-size:13px;line-height:1.6}
  strong{color:#eee;font-size:14px} .coverage-available strong{color:#c8ff4d} p{margin:5px 0 0} a{display:inline-flex;align-items:center;min-height:32px;color:#d1bfff;text-decoration:underline;text-underline-offset:3px} a:focus-visible{outline:2px solid #c8ff4d;outline-offset:3px}
  @media(max-width:700px){.network-coverage{grid-template-columns:1fr;gap:14px;padding:18px;margin-block:20px 28px}.network-coverage>div+div{border-top:1px solid #333;padding-top:12px}}
</style>
