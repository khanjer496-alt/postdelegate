---
import Doc from '../../layouts/Doc.astro';
import CompareCard from '../CompareCard.astro';
import { localeHref, localizeLinks, strings, type Lang } from '../../i18n';
import { TOOLS } from '../../data/tools';
import { COMPARE_PAIRS, pairHref } from '../../data/compare-pairs';
import { BEST_LISTS, bestHref } from '../../data/best-lists';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = strings(lang).comparePage;
// PostDelegate against one other tool, then head-to-head pages built on CompareTool and
// Alternatives; add each new page to the matching list, and its words to comparePage in every locale.
const VERSUS = [
  { href: '/compare/postiz', tools: ['PostDelegate', 'Postiz'] },
  { href: '/compare/buffer', tools: ['PostDelegate', 'Buffer'] },
  { href: '/compare/hootsuite', tools: ['PostDelegate', 'Hootsuite'] },
  { href: '/compare/later', tools: ['PostDelegate', 'Later'] },
  { href: '/compare/sprout-social', tools: ['PostDelegate', 'Sprout Social'] },
  { href: '/compare/publer', tools: ['PostDelegate', 'Publer'] },
  { href: '/compare/post-bridge', tools: ['PostDelegate', 'Post Bridge'], cta: p.postBridgeCta },
].map((card, index) => ({ ...card, ...p.versus[index], href: localeHref(lang, card.href) }));
const PAIRS = [
  { href: '/compare/postiz-vs-buffer', tools: ['Postiz', 'Buffer'] },
  { href: '/compare/postiz-vs-mixpost', tools: ['Postiz', 'Mixpost'] },
  { href: '/compare/postiz-vs-post-bridge', tools: ['Postiz', 'Post Bridge'] },
  { href: '/compare/postiz-vs-blotato', tools: ['Postiz', 'Blotato'] },
  { href: '/compare/postiz-vs-zernio', tools: ['Postiz', 'Zernio'] },
  { href: '/compare/publer-vs-buffer', tools: ['Publer', 'Buffer'] },
  { href: '/compare/publer-vs-metricool', tools: ['Publer', 'Metricool'] },
  { href: '/alternatives/postiz', tools: ['Postiz', 'PostDelegate'] },
].map((card, index) => ({ ...card, ...p.pairs[index], href: localeHref(lang, card.href) }));
// The newer head-to-heads. The cards above take their copy from the localised
// `versus` and `pairs` arrays by position, so adding to those would need a
// translation for every locale before the page could build; these pages are
// English only, so they are listed as plain links on the English page.
const MORE = [
  ['/compare/metricool', 'Metricool'],
  ['/compare/sendible', 'Sendible'],
  ['/compare/agorapulse', 'Agorapulse'],
  ['/compare/socialbee', 'SocialBee'],
  ['/compare/loomly', 'Loomly'],
  ['/compare/planable', 'Planable'],
  ['/compare/vista-social', 'Vista Social'],
  ['/compare/zoho-social', 'Zoho Social'],
  ['/compare/coschedule', 'CoSchedule'],
  ['/compare/typefully', 'Typefully'],
];
---
<Doc title={p.title} description={p.description} h1={p.h1} eyebrow={p.eyebrow} lead={p.lead} lang={lang}>
  <div class="compare-grid">
    {VERSUS.map((card) => <CompareCard {...card} as="h2" lang={lang} />)}
  </div>
  <h2>{p.pairsTitle}</h2>
  <p>{p.pairsIntro}</p>
  <div class="compare-grid">
    {PAIRS.map((card) => <CompareCard {...card} lang={lang} />)}
  </div>
  {!!COMPARE_PAIRS.length && <>
    <h2>{p.morePairsTitle}</h2>
    <ul class="pair-links">{COMPARE_PAIRS.map((pair) => <li><a href={pairHref(pair)}>{TOOLS[pair.a].name} vs {TOOLS[pair.b].name}</a></li>)}</ul>
  </>}
  {lang === 'en' && (
    <Fragment>
      <h2>More comparisons</h2>
      <p>Each of these reads the other tool's own pricing page for its prices, says where that tool is the better pick, and works out what it costs at ten and thirty accounts wherever the vendor publishes enough to do so.</p>
      <ul>
        {MORE.map(([href, name]) => <li><a href={href}>PostDelegate vs {name}</a></li>)}
      </ul>
      <h2>Best-of lists</h2>
      <p>Lists of the tools in this comparison data that meet one stated rule, such as documenting an MCP server, in an order set by a second rule. PostDelegate is on them where it meets the rule, placed like everyone else.</p>
      <ul>
        {BEST_LISTS.map((list) => <li><a href={bestHref(list)}>{list.h1}</a></li>)}
      </ul>
    </Fragment>
  )}
  <Fragment set:html={localizeLinks(lang, p.body)} />
</Doc>
<style>
  .compare-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 28px 0 36px; }
  .pair-links { columns: 2; column-gap: 32px; }
  @media (max-width: 600px) { .compare-grid { grid-template-columns: 1fr; } .pair-links { columns: 1; } }
</style>
