---
interface Props { id?: string; compact?: boolean; }
const { id, compact = false } = Astro.props;
const days = Array.from({ length: 35 }, (_, i) => i + 1);
const posts: Record<number, { title: string; time: string; art: string; channel: string; draft?: boolean }> = {
  1: { title: 'A fresh perspective', time: '09:00', art: 'peach', channel: '◎' },
  3: { title: 'Inside the studio', time: '12:30', art: 'lilac', channel: 'in' },
  5: { title: 'Small things, made well', time: '10:00', art: 'lime', channel: '◎', draft: true },
  8: { title: 'Room for a new idea', time: '09:00', art: 'blue', channel: 'in' },
  10: { title: 'The details matter', time: '15:00', art: 'peach', channel: '◎' },
  12: { title: 'Meet the makers', time: '11:00', art: 'lime', channel: '▶' },
  16: { title: 'Something to share', time: '09:30', art: 'lilac', channel: '◎', draft: true },
  18: { title: 'A little behind the scenes', time: '14:00', art: 'blue', channel: 'in' },
  23: { title: 'Notes from the studio', time: '10:00', art: 'lime', channel: '◎', draft: true },
  26: { title: 'From an idea to a story', time: '12:00', art: 'peach', channel: '▶' },
  29: { title: 'Make space for what’s next', time: '09:00', art: 'lilac', channel: 'in', draft: true },
};
const navigation = [
  { name: 'Calendar', path: 'M5 3v3m10-3v3M3 9h14M4 5h12a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z' },
  { name: 'Media', path: 'M4 3h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm-1 11 4-4 3 3 2-2 5 5M12 7h.01' },
  { name: 'Analytics', path: 'M4 16V9m6 7V4m6 12v-5M2 18h16' },
  { name: 'Team', path: 'M7 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm6-5a3 3 0 0 1 0 6M2 17v-2a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v2m3-4a3 3 0 0 1 3 3v1' },
  { name: 'Settings', path: 'M10 3v2m0 10v2M3 10h2m10 0h2M5 5l1.5 1.5m7 7L15 15m0-10-1.5 1.5m-7 7L5 15M10 6a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z' },
];
---

<figure id={id} class:list={['pp-preview', { 'pp-compact': compact }]} aria-label="Illustrative PostDelegate calendar with original sample drafts and scheduled posts">
  <figcaption class="pp-browser"><span class="pp-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="pp-address">Your content, in one place</span><span class="pp-example"><i></i>Illustrative workspace</span></figcaption>
  <div class="pp-workspace" aria-hidden="true">
    <aside class="pp-sidebar">
      <div class="pp-brand"><span class="pp-mark"><img src="/mark.svg?v=orbit-slot" alt="" width="25" height="25"/></span><strong>PostDelegate<small>WORKSPACE</small></strong></div>
      <div class="pp-picker"><span>S</span><b>Studio workspace</b><i>⌄</i></div>
      <span class="pp-aside-label">YOUR STUDIO</span>
      <div class="pp-navigation">{navigation.map(({ name, path }) => <div class:list={['pp-nav', { 'pp-active': name === 'Calendar' }]}><svg viewBox="0 0 20 20"><path d={path} /></svg><span>{name}</span>{name === 'Calendar' && <i></i>}</div>)}</div>
      <div class="pp-channels"><span class="pp-aside-label">CHANNELS <b>+</b></span>{[{ name: 'Studio journal', network: 'Instagram', icon: '◎', initial: 'S', tone: 'peach' }, { name: 'Made by Studio', network: 'LinkedIn', icon: 'in', initial: 'M', tone: 'lilac' }, { name: 'Studio films', network: 'YouTube', icon: '▶', initial: 'S', tone: 'blue' }].map((channel) => <div class="pp-channel-row"><span class:list={['pp-avatar', `pp-avatar-${channel.tone}`]}>{channel.initial}<i>{channel.icon}</i></span><span>{channel.name}<small>{channel.network}</small></span><b></b></div>)}</div>
      <div class="pp-aside-bottom"><span class="pp-orbit">✳</span><strong>A home for your ideas.</strong><p>From the first draft to the next post.</p><div class="pp-profile"><span>M</span><div>Maya’s workspace<small>Personal workspace</small></div><b>⌄</b></div></div>
    </aside>
    <div class="pp-content">
      <header class="pp-topbar"><div><span>Workspace <i>/</i></span>Calendar</div><div class="pp-top-actions"><span class="pp-search"><svg viewBox="0 0 20 20"><circle cx="8" cy="8" r="5"/><path d="m12 12 4 4"/></svg><span>Search anything</span><kbd>⌘ K</kbd></span><span class="pp-user">M</span></div></header>
      <div class="pp-toolbar"><div><span class="pp-eyebrow">YOUR NEXT CHAPTER</span><div class="pp-month">June 2026 <span class="pp-month-arrows">‹ <i>›</i></span><span class="pp-today">Today</span></div></div><div class="pp-toolbar-actions"><span class="pp-view"><b>Month</b><span>List</span></span><span class="pp-create">+ <span>Create post</span></span></div></div>
      <div class="pp-filters"><span class="pp-filter"><i></i>All channels <b>⌄</b></span><span class="pp-key"><i></i>Scheduled <b></b>Draft</span><span class="pp-timezone">Your timezone <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6"/><path d="M8 4v4l3 2"/></svg></span></div>
      <div class="pp-weekdays">{['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'].map((day) => <span>{day}</span>)}</div>
      <div class="pp-calendar">{days.map((day) => {
        const post = posts[day];
        return <div class:list={['pp-day', { 'pp-outside': day > 30, 'pp-selected': day === 10 }]}><span class="pp-number">{day > 30 ? day - 30 : day}</span>{post && <div class:list={['pp-post', { 'pp-draft': post.draft }]}><div class:list={['pp-art', `pp-art-${post.art}`]}><i></i><b></b><span>{post.art === 'lime' ? 'MAKE SPACE.' : post.art === 'blue' ? 'A NEW PERSPECTIVE.' : 'studio notes.'}</span><small>{post.channel}</small></div><strong>{post.title}</strong><div class="pp-post-meta"><i class:list={{ 'pp-is-draft': post.draft }}></i>{post.draft ? 'Draft' : post.time}<span>···</span></div></div>}{day === 10 && <span class="pp-add-hint">+</span>}</div>;
      })}</div>
      <div class="pp-footer"><span><i></i>A little planning. A lot more breathing room.</span><span>Sample content</span></div>
    </div>
  </div>
</figure>

<style>
  .pp-preview{--pp-line:#eae8ed;--pp-ink:#29262e; margin:0;overflow:hidden;border:1px solid #dedbe4;border-radius:19px;background:#fff;color:var(--pp-ink);font-family:inherit;text-align:left;box-shadow:0 24px 65px -35px #1711264d,0 3px 12px #24202b08}.pp-preview *{box-sizing:border-box}
  .pp-browser{height:36px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 15px;border-bottom:1px solid #e7e4ec;background:#f7f6f9;color:#8f8798;font-size:9px}.pp-dots{display:flex;gap:5px;min-width:45px}.pp-dots i{width:6px;height:6px;border-radius:50%;background:#d2ccd9}.pp-dots i:first-child{background:#c4bdcd}.pp-address{font-size:8px}.pp-example{display:flex;align-items:center;gap:5px;font-size:7px;white-space:nowrap}.pp-example i{width:5px;height:5px;background:#ae9ac7;border-radius:50%}
  .pp-workspace{display:grid;grid-template-columns:177px minmax(0,1fr)}.pp-sidebar{display:flex;flex-direction:column;padding:23px 12px 0;border-right:1px solid var(--pp-line);background:#fbfafc}.pp-brand{display:flex;align-items:center;gap:7px;margin:0 5px 25px}.pp-mark{display:grid;place-items:center;width:25px;height:25px;border-radius:7px;background:#252229;color:white}.pp-mark svg{width:19px;height:19px}.pp-brand strong{font-size:13px;font-weight:750;letter-spacing:-.45px;line-height:1.15}.pp-brand small{display:block;margin-top:4px;font-size:6px;font-weight:500;letter-spacing:2px;color:#aaa0b3}.pp-picker{display:flex;align-items:center;gap:7px;margin:0 2px 24px;padding:8px 6px;border:1px solid #e7e1ee;border-radius:7px;background:white}.pp-picker>span{display:grid;place-items:center;width:21px;height:21px;border-radius:5px;background:#e8e1f1;color:#8d75a8;font-size:10px}.pp-picker>b{font-size:8px;font-weight:550}.pp-picker>i{margin-left:auto;font-style:normal;color:#b3a7c0;font-size:11px}.pp-aside-label{display:flex;justify-content:space-between;margin:0 8px 9px;font-size:6px;font-weight:600;letter-spacing:1.2px;color:#aaa0b5}.pp-aside-label>b{font-size:10px;font-weight:400;line-height:7px}
  .pp-navigation{display:flex;flex-direction:column;gap:4px}.pp-nav{display:flex;align-items:center;gap:9px;height:32px;padding:0 10px;border-radius:7px;color:#8c8197;font-size:9px}.pp-nav svg{height:14px;width:14px;stroke:currentColor;fill:none;stroke-width:1.25;stroke-linecap:round;stroke-linejoin:round}.pp-active{background:#eae5f1;color:#564263;font-weight:650}.pp-nav>i{height:4px;width:4px;margin-left:auto;background:#ad8bc5;border-radius:50%}.pp-channels{margin-top:27px}.pp-channel-row{display:flex;align-items:center;gap:8px;padding:8px;font-size:8px}.pp-channel-row>span:nth-child(2){font-weight:500}.pp-channel-row small{display:block;margin-top:3px;color:#b4a8bf;font-size:6px;font-weight:400}.pp-avatar{position:relative;display:grid;place-items:center;height:25px;width:25px;border-radius:50%;font-size:9px;font-weight:600}.pp-avatar-peach{background:#f1dcd0;color:#ac7b63}.pp-avatar-lilac{background:#e6dfee;color:#967fa9}.pp-avatar-blue{background:#dce7e9;color:#8aadb3}.pp-avatar>i{position:absolute;right:-3px;bottom:-2px;display:grid;place-items:center;width:12px;height:12px;border:2px solid #fbfafc;border-radius:50%;background:#aa93b7;color:#fff;font-style:normal;font-size:5px}.pp-channel-row>b{width:4px;height:4px;margin-left:auto;border-radius:50%;background:#b3c79e}
  .pp-aside-bottom{margin-top:auto;padding-top:25px;text-align:center}.pp-orbit{display:grid;place-items:center;width:38px;height:38px;margin:0 auto 11px;border:1px solid #e7dfef;border-radius:50%;color:#b59bce;font-size:28px;transform:rotate(-20deg)}.pp-aside-bottom>strong{display:block;font-size:9px;font-weight:600;letter-spacing:-.2px}.pp-aside-bottom>p{margin:6px 0 20px;font-size:6px;color:#b4a7c0}.pp-profile{display:flex;align-items:center;gap:7px;padding:13px 4px;border-top:1px solid var(--pp-line);text-align:left}.pp-profile>span,.pp-user{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#ebe0d3;color:#9c8063;font-size:9px;font-weight:600}.pp-profile>div{font-size:7px;font-weight:550}.pp-profile small{display:block;margin-top:3px;color:#b3a5bd;font-size:6px;font-weight:400}.pp-profile>b{margin-left:auto;font-size:10px;font-weight:400;color:#ad9cbb}
  .pp-content{min-width:0}.pp-topbar{display:flex;align-items:center;justify-content:space-between;height:55px;padding:0 24px;border-bottom:1px solid var(--pp-line);font-size:9px;font-weight:500}.pp-topbar>div>span{font-weight:400;color:#b1a4bc}.pp-topbar>div>span>i{margin:0 10px;font-style:normal;color:#d5cbdc}.pp-top-actions{display:flex;align-items:center;gap:18px}.pp-search{display:flex;align-items:center;gap:6px;color:#b9acc4;font-size:7px}.pp-search svg{height:12px;width:12px;fill:none;stroke:currentColor;stroke-width:1.3}.pp-search kbd{margin-left:11px;padding:2px 4px;border:1px solid #ece5f2;border-radius:3px;font-size:6px;font-family:inherit}.pp-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:23px 23px 16px}.pp-eyebrow{display:block;margin-bottom:6px;font-size:6px;letter-spacing:1.4px;font-weight:550;color:#b2a2c0}.pp-month{display:flex;align-items:center;gap:13px;font-size:20px;font-weight:650;letter-spacing:-.9px;line-height:1.2}.pp-month-arrows{font-size:16px;font-weight:400;letter-spacing:0;color:#a68db8}.pp-month-arrows>i{margin-left:11px;font-style:normal}.pp-today{padding:4px 7px;border:1px solid #eae2f1;border-radius:5px;font-size:7px;font-weight:500;letter-spacing:0}.pp-toolbar-actions{display:flex;align-items:center;gap:10px}.pp-view{display:flex;align-items:center;gap:12px;padding:3px;border:1px solid #ece5f2;border-radius:6px;font-size:7px;color:#b6a5c4}.pp-view>b{padding:5px 9px;border-radius:3px;background:#f0ebf6;color:#9880aa;font-weight:550}.pp-view>span{padding-right:9px}.pp-create{display:flex;align-items:center;gap:6px;padding:8px 11px;border-radius:6px;background:#29262e;color:white;font-size:11px}.pp-create>span{font-size:8px}
  .pp-filters{display:flex;align-items:center;gap:20px;padding:0 23px 17px;color:#ae9bbb;font-size:7px}.pp-filter{display:flex;align-items:center;gap:6px;padding:5px 7px;border:1px solid #ece3f3;border-radius:5px;color:#9e87af}.pp-filter>i{width:5px;height:5px;border-radius:50%;background:#bca2d0}.pp-filter>b{margin-left:4px;font-size:9px;font-weight:400}.pp-key{display:flex;align-items:center;gap:5px;font-size:6px}.pp-key>i,.pp-key>b{height:4px;width:4px;border-radius:50%;background:#bacd9e}.pp-key>b{margin-left:8px;background:#c9b9d8}.pp-timezone{display:flex;gap:5px;align-items:center;margin-left:auto;font-size:6px}.pp-timezone svg{height:9px;width:9px;fill:none;stroke:currentColor}.pp-weekdays{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));padding:10px 0;border-block:1px solid var(--pp-line);background:#fdfcfe;color:#b4a2c1;font-size:6px;letter-spacing:1px;text-align:center}.pp-weekdays>span:nth-last-child(-n+2){color:#c9bdd3}
  .pp-calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr))}.pp-day{position:relative;min-width:0;min-height:99px;padding:7px 5px 5px;border-right:1px solid #efebf3;border-bottom:1px solid #efebf3}.pp-day:nth-child(7n){border-right:0}.pp-day:nth-child(7n),.pp-day:nth-child(7n - 1){background:#fdfcfe}.pp-day:nth-last-child(-n+7){border-bottom:0}.pp-number{display:block;margin:0 2px 5px;color:#aa96b9;font-size:7px;line-height:1}.pp-outside .pp-number{color:#d6cbdc}.pp-selected{background:#fcf9fe}.pp-selected>.pp-number{display:grid;place-items:center;height:16px;width:16px;margin-top:-3px;border-radius:50%;background:#ad8cc3;color:#fff}.pp-post{position:relative;padding:3px;border:1px solid #e9e1ef;border-radius:6px;background:white;box-shadow:0 2px 3px #40314e04}.pp-draft{border-style:dashed}.pp-art{position:relative;height:35px;overflow:hidden;border-radius:3px;background:#efd7c8;color:#a57961}.pp-art>i{position:absolute;display:block;height:47px;width:47px;right:-2px;bottom:-14px;border:8px solid #d3a08280;border-radius:50%}.pp-art>b{position:absolute;height:45px;width:17px;top:-8px;left:12px;transform:rotate(23deg);background:#faeade}.pp-art>span{position:absolute;z-index:1;left:6px;top:6px;max-width:52px;font-size:7px;line-height:.95;letter-spacing:-.3px;font-weight:700}.pp-art>small{position:absolute;z-index:2;right:3px;bottom:3px;display:grid;place-items:center;height:11px;width:11px;border:1px solid #fff9;border-radius:3px;background:#fffd;color:#9c7ba7;font-size:6px;font-weight:700}.pp-art-lilac{background:#e2d8ed;color:#a081b5}.pp-art-lilac>i{right:12px;bottom:-17px;height:51px;width:51px;border:0;border-radius:50% 50% 0 0;background:#b9a1cf}.pp-art-lilac>b{left:18px;top:5px;width:14px;height:30px;background:#f3ecfa;transform:rotate(-27deg)}.pp-art-lime{background:#e1e8bf;color:#8a9a5c}.pp-art-lime>i{height:40px;width:40px;border:0;right:3px;bottom:-5px;border-radius:0;background:#c0ce7e;transform:rotate(26deg)}.pp-art-lime>b{left:18px;background:#f3f6df;transform:rotate(26deg)}.pp-art-blue{background:#dbe5ed;color:#7f9eaf}.pp-art-blue>i{background:#adc4d1;right:-1px;bottom:-21px;border:0;height:58px;width:58px}.pp-art-blue>b{left:17px;background:#edf3f7;transform:rotate(-20deg)}.pp-post>strong{display:block;overflow:hidden;margin:5px 1px;color:#94809f;font-size:6px;font-weight:500;text-overflow:ellipsis;white-space:nowrap;line-height:1.3}.pp-post-meta{display:flex;align-items:center;gap:3px;color:#bba7c9;font-size:5px}.pp-post-meta>i{height:3px;width:3px;border-radius:50%;background:#b4ca94}.pp-post-meta>.pp-is-draft{background:#cfb9df}.pp-post-meta>span{margin-left:auto;font-size:8px;line-height:4px}.pp-add-hint{position:absolute;right:7px;top:4px;color:#bba0cf;font-size:11px}.pp-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 20px;border-top:1px solid var(--pp-line);color:#b8a4c7;font-size:6px}.pp-footer>span:first-child{display:flex;align-items:center;gap:5px}.pp-footer i{height:4px;width:4px;border-radius:50%;background:#bdcd9f}
  .pp-compact .pp-day{min-height:84px}.pp-compact .pp-art{height:25px}.pp-compact .pp-channels{margin-top:18px}.pp-compact .pp-aside-bottom{padding-top:12px}.pp-compact .pp-orbit{display:none}
  @media(max-width:900px){.pp-workspace{grid-template-columns:145px minmax(0,1fr)}.pp-sidebar{padding:18px 8px 0}.pp-brand strong{font-size:11px}.pp-picker{font-size:7px;gap:5px}.pp-toolbar{padding:20px 16px 14px}.pp-filters{padding:0 16px 14px}.pp-month{font-size:18px;gap:10px}.pp-day{min-height:91px;padding:6px 4px}.pp-view{display:none}.pp-topbar{padding:0 16px}.pp-art{height:31px}.pp-post>strong{font-size:5.5px}}
  @media(max-width:680px){.pp-preview{border-radius:13px}.pp-workspace{grid-template-columns:49px minmax(0,1fr)}.pp-sidebar{padding:15px 5px 0}.pp-brand{margin:0 auto 20px;justify-content:center}.pp-brand strong,.pp-picker,.pp-aside-label,.pp-nav>span,.pp-nav>i,.pp-channels,.pp-aside-bottom>strong,.pp-aside-bottom>p,.pp-orbit,.pp-profile>div,.pp-profile>b{display:none}.pp-nav{justify-content:center;padding:0;height:32px}.pp-aside-bottom{padding-top:20px}.pp-profile{justify-content:center;padding:13px 0}.pp-topbar{height:44px;padding:0 13px;font-size:8px}.pp-top-actions{gap:10px}.pp-search>span,.pp-search>kbd{display:none}.pp-user{height:21px;width:21px;font-size:8px}.pp-topbar>div>span>i{margin:0 5px}.pp-toolbar{padding:17px 12px 13px}.pp-eyebrow{font-size:5px;letter-spacing:1px}.pp-month{font-size:16px;gap:9px;letter-spacing:-.6px}.pp-month-arrows{font-size:13px}.pp-month-arrows>i{margin-left:6px}.pp-today{font-size:6px;padding:3px 5px}.pp-create{padding:7px 8px;font-size:10px;gap:4px}.pp-create>span{font-size:6px}.pp-filters{padding:0 12px 12px;gap:10px}.pp-key{font-size:5px;gap:3px}.pp-key>b{margin-left:3px}.pp-timezone{display:none}.pp-filter{font-size:6px;padding:4px 5px}.pp-weekdays{padding:8px 0;font-size:5px;letter-spacing:.4px}.pp-day,.pp-compact .pp-day{min-height:80px;padding:6px 3px 4px}.pp-number{font-size:6px;margin-left:1px}.pp-art,.pp-compact .pp-art{height:27px}.pp-art>span{font-size:5px;left:3px;top:5px;max-width:30px}.pp-post{padding:2px;border-radius:4px}.pp-post>strong{font-size:5px;margin:4px 0}.pp-post-meta{font-size:4px;gap:2px}.pp-art>small{width:9px;height:9px;font-size:5px;right:1px;bottom:1px}.pp-footer{padding:9px 12px;font-size:5px}.pp-browser{height:29px;padding:0 10px}.pp-dots{min-width:28px;gap:4px}.pp-dots i{height:5px;width:5px}.pp-address{font-size:7px}.pp-example{font-size:6px;gap:4px}}
  @media(max-width:440px){.pp-workspace{grid-template-columns:1fr}.pp-sidebar{display:none}.pp-address{display:none}.pp-month{font-size:15px}.pp-day,.pp-compact .pp-day{min-height:72px;padding:5px 3px}.pp-post>strong{font-size:4.5px}.pp-art,.pp-compact .pp-art{height:25px}.pp-key{margin-left:auto}.pp-footer>span:last-child{display:none}}
</style>
