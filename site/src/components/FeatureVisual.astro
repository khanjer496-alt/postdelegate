  .fv-week{position:absolute;top:23px;left:22px;width:298px;height:188px;padding:18px 16px;border:1px solid #e6ddec;border-radius:12px;background:#fff;box-shadow:0 11px 30px -20px #604a7040;transform:rotate(-3deg)}.fv-week .fv-card-top{margin-bottom:17px}.fv-columns{display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}.fv-columns>div{text-align:center}.fv-columns>div>span{display:inline-block;padding:4px 3px;color:#ad96bd;font-size:6px;white-space:nowrap}.fv-columns .fv-current{border-radius:4px;background:#f0e8f7;color:#a385ba;font-weight:600}.fv-columns>div>i{display:block;height:104px;margin-top:9px;border-right:1px solid #f1eaf6}.fv-columns>div:last-child>i{border:0}.fv-plan{position:absolute;display:flex;align-items:center;gap:7px;padding:8px;border:1px solid #e3d7ed;border-radius:7px;background:#f0e8f7;box-shadow:0 2px 3px #5d456c03}.fv-plan b{display:block;color:#9a7bad;font-size:7px;font-weight:600}.fv-plan small{display:block;margin-top:4px;color:#b9a0cb;font-size:5px}.fv-plan-one{top:88px;left:22px;width:135px}.fv-plan-two{top:129px;left:120px;width:144px;border-color:#e1e8d2;background:#f1f4e7}.fv-plan-two b{color:#95a571}.fv-plan-two small{color:#b7c498}.fv-plan-three{top:170px;left:74px;width:180px;padding:6px 8px;border-style:dashed;background:white}.fv-plan-three>b{font-size:6px;font-weight:450;color:#b6a0c5}.fv-plan-three>span{margin-left:auto;color:#c2aed1;font-size:5px}.fv-plan-three>i{width:4px;height:4px;border-radius:50%;background:#cdb4df}.fv-channel{display:grid;place-items:center;width:21px;height:21px;border:1px solid #e6d9ee;border-radius:6px;background:#fff;color:#ad8bad;font-size:12px;font-weight:600}.fv-linkedin{color:#8ba2c0;font-size:8px}.fv-plan-note{left:115px;bottom:0;width:223px;gap:9px;padding:12px;transform:rotate(2deg)}.fv-clock{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;background:#f0e8f7;color:#ad8fc3}.fv-plan-note>div{font-size:9px}.fv-plan-note small{font-size:6px}
  .fv-media{background:#f5f1ed}.fv-library{position:absolute;top:25px;left:19px;width:310px;padding:17px 16px 13px;border:1px solid #e6ded8;border-radius:13px;background:white;box-shadow:0 10px 25px -20px #57443366;transform:rotate(2deg)}.fv-tabs{display:flex;gap:15px;margin:17px 0 12px;color:#bdadbd;font-size:6px}.fv-tabs>b{position:relative;color:#a28aaf;font-weight:550}.fv-tabs>b:after{content:'';position:absolute;left:0;right:0;bottom:-7px;height:1px;background:#b09bc0}.fv-media-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;padding-top:5px}.fv-art{position:relative;height:83px;overflow:hidden;border-radius:6px}.fv-art>b{position:absolute;z-index:1;left:8px;top:11px;font-size:13px;font-weight:650;line-height:.95;letter-spacing:-.8px}.fv-art>span{position:absolute;left:8px;bottom:7px;font-size:5px;letter-spacing:1px}.fv-art>i{position:absolute;display:block;right:-21px;bottom:-28px;width:75px;height:75px;border-radius:50%}.fv-peach{background:#efd4c2;color:#a9795b}.fv-peach>i{border:15px solid #d0a183}.fv-lime{background:#dee8b0;color:#91a166}.fv-lime>i{border-radius:4px;background:#bdcd81;transform:rotate(24deg)}.fv-lime>b{font-size:16px}.fv-lilac{background:#e3d9ee;color:#a389b7}.fv-lilac>i{right:4px;bottom:-19px;width:53px;border-radius:50% 50% 3px 3px;background:#bea7d3}.fv-lilac>b{font-size:10px;letter-spacing:-.4px}.fv-library-bottom{display:flex;justify-content:space-between;margin-top:13px;color:#bda9b6;font-size:5px}.fv-library-bottom>span:first-child{display:flex;align-items:center;gap:4px;color:#ae98a7}.fv-library-bottom svg{width:9px;height:9px;stroke:currentColor;fill:none}.fv-file-note{left:44px;bottom:0;width:246px;gap:9px;padding:12px;transform:rotate(-3deg)}.fv-file-icon{display:grid;place-items:center;width:32px;height:32px;border-radius:8px;background:#f2e8de;color:#bfa287}.fv-file-note>div{font-size:9px}.fv-file-note small{font-size:6px}.fv-file-note>.fv-check{margin-left:auto}
