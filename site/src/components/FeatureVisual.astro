  .fv-analytics{background:#f2f1f6}.fv-report{position:absolute;top:22px;left:22px;width:312px;padding:19px 18px 14px;border:1px solid #e5ddeb;border-radius:14px;background:#fff;box-shadow:0 13px 30px -23px #49375555;transform:rotate(-2deg)}.fv-eyebrow{display:block;margin-bottom:5px;color:#c5add5;font-size:5px;letter-spacing:1.1px}.fv-card-top>div>strong{font-size:13px;font-weight:550;letter-spacing:-.5px}.fv-report .fv-card-top>span{padding:5px 7px;border:1px solid #ede3f4;border-radius:5px;font-size:6px}.fv-chart{position:relative;height:118px;margin-top:16px}.fv-chart-lines{position:absolute;inset:0 0 18px;display:flex;flex-direction:column;justify-content:space-between}.fv-chart-lines>i{border-top:1px dashed #eee5f4}.fv-bars{position:absolute;inset:0 4px;display:flex;align-items:flex-end;justify-content:space-around;gap:13px}.fv-bars>div{display:flex;flex:1;flex-direction:column;align-items:center;gap:8px}.fv-bars>div>span{width:100%;max-width:21px;height:var(--fv-bar);border-radius:4px 4px 1px 1px;background:#e8dfef}.fv-bars>div>.fv-bar-lime{background:#cddd9f}.fv-bars>div>.fv-bar-purple{background:#b79ed1}.fv-bars small{color:#c0a9ce;font-size:5px}.fv-legend{display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding-top:12px;border-top:1px solid #f0e6f6;color:#c0a7ce;font-size:5px}.fv-legend>span:first-child{display:flex;align-items:center;gap:4px}.fv-legend i{width:4px;height:4px;border-radius:50%;background:#ccb3df}
