---
interface Props { kind?: 'planning' | 'media' | 'teams' | 'analytics' | 'composer' | 'bulk'; }
const { kind = 'planning' } = Astro.props;
const labels = {
  planning: 'Illustrative weekly content plan',
  media: 'Illustrative media library with original artwork',
  teams: 'Illustrative team review with sample members Maya and Alex',
  analytics: 'Example Views report with sample daily views gained',
  composer: 'Illustrative post composer with an original sample draft',
  bulk: 'Illustrative bulk video scheduling with sample files spread over time slots',
};
---

<figure class:list={['fv-visual', `fv-${kind}`]} aria-label={labels[kind]}>
  <div class="fv-scene" aria-hidden="true">
    {kind === 'planning' && <>
      <div class="fv-week"><div class="fv-card-top"><strong>This week</strong><span>June 8 – 12 <b>⌄</b></span></div><div class="fv-columns">{['Mon 08','Tue 09','Wed 10','Thu 11','Fri 12'].map((day, i) => <div><span class:list={{ 'fv-current': i === 2 }}>{day}</span><i></i></div>)}</div><div class="fv-plan fv-plan-one"><span class="fv-channel">◎</span><div><b>Weekly notes</b><small>09:00 · Instagram</small></div></div><div class="fv-plan fv-plan-two"><span class="fv-channel fv-linkedin">in</span><div><b>A new perspective</b><small>12:30 · LinkedIn</small></div></div><div class="fv-plan fv-plan-three"><i></i><b>Behind the scenes</b><span>Draft</span></div></div><div class="fv-floating fv-plan-note"><span class="fv-clock"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg></span><div>A time for every idea.<small>One calendar. A clearer week.</small></div></div>
    </>}
    {kind === 'media' && <>
      <div class="fv-library"><div class="fv-card-top"><strong>Media library</strong><span><svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" /></svg>Upload</span></div><div class="fv-tabs"><b>All media</b><span>Images</span><span>Videos</span></div><div class="fv-media-grid"><div class="fv-art fv-peach"><i></i><b>the art<br/>of less.</b><span>01</span></div><div class="fv-art fv-lime"><i></i><b>MAKE<br/>SPACE.</b><span>02</span></div><div class="fv-art fv-lilac"><i></i><b>another<br/>perspective.</b><span>03</span></div></div><div class="fv-library-bottom"><span><svg viewBox="0 0 16 16"><path d="M2 4h5l2 2h5v7H2z" /></svg>Brand collection</span><span>Original sample artwork</span></div></div><div class="fv-floating fv-file-note"><span class="fv-file-icon"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7zM14 3v5h4M10 12h5M10 15h5" /></svg></span><div>weekly-notes.png<small>Ready for your next draft</small></div><span class="fv-check">✓</span></div>
    </>}
    {kind === 'teams' && <>
      <div class="fv-team"><div class="fv-card-top"><strong>Maya’s workspace, together</strong><span class="fv-more">···</span></div><div class="fv-person"><span class="fv-avatar fv-maya">M</span><div><b>Maya <small>You</small></b><span>Workspace owner</span></div><span class="fv-role">Owner <b>⌄</b></span></div><div class="fv-person"><span class="fv-avatar fv-alex">A</span><div><b>Alex</b><span>Content collaborator</span></div><span class="fv-role">Editor <b>⌄</b></span></div><div class="fv-invite"><span>+</span>A little more room for your team</div></div><div class="fv-floating fv-comment"><span class="fv-avatar fv-alex">A</span><div><b>Alex <small>Sample comment</small></b><p>Love this direction.<br/>Ready for your review.</p></div><span class="fv-comment-dot"></span></div>
    </>}
    {kind === 'analytics' && <>
      <div class="fv-report"><div class="fv-card-top"><div><span class="fv-eyebrow">VIEWS · EXAMPLE REPORT</span><strong>Views gained per day</strong></div><span><i class="fv-live"></i>YouTube · Live</span></div><div class="fv-chart"><div class="fv-chart-lines"><i></i><i></i><i></i><i></i></div><div class="fv-bars">{[34,54,42,77,63,96,79].map((height, i) => <div><span style={`--fv-bar:${height}px`} class:list={{ 'fv-bar-lime': i === 3, 'fv-bar-purple': i === 5 }}></span><small>{['M','T','W','T','F','S','S'][i]}</small></div>)}</div></div><div class="fv-legend"><span><i></i>Daily views gained</span><span>Sample data, not results</span></div></div>
    </>}
    {kind === 'composer' && <>
      <div class="fv-composer-card"><div class="fv-card-top"><strong>A new post</strong><span class="fv-close">×</span></div><div class="fv-compose-channels"><span class="fv-channel fv-youtube"><svg viewBox="0 0 24 24"><path d="M9 7.5v9l7.5-4.5z"/></svg></span><span class="fv-channel fv-bluesky"><svg viewBox="0 0 24 24"><path d="M12 11.2C10.6 8.4 7 4.4 4.8 5.3c-1.9.8-.6 6.1 2.7 6.9-3.1.7-3.2 3.6-.9 5 2.4 1.4 4.3-1.4 5.4-3.6 1.1 2.2 3 5 5.4 3.6 2.3-1.4 2.2-4.3-.9-5 3.3-.8 4.6-6.1 2.7-6.9-2.2-.9-5.8 3.1-7.2 5.9Z"/></svg></span><span class="fv-add">+</span><small>Your channels</small></div><div class="fv-editor"><span>THE FIRST WORDS ARE YOURS.</span><p>A fresh perspective.<br/>A little space to make something<br/>worth sharing.<i></i></p><div class="fv-attachment"><span><i></i></span><div>weekly-notes.png<small>Original sample artwork</small></div><b>×</b></div></div><div class="fv-composer-bottom"><span>◷ <small>Save as draft</small></span><b>Schedule <span>↗</span></b></div></div>
    </>}
    {kind === 'bulk' && <>
      <div class="fv-batch"><div class="fv-card-top"><strong>Bulk schedule videos</strong><span>12 videos · 2 channels</span></div><div class="fv-batch-list">{[{ file: 'launch-teaser.mp4', len: '0:24', slot: 'Mon 09:00', tone: 'fv-thumb-lilac' }, { file: 'behind-the-scenes.mp4', len: '0:41', slot: 'Tue 12:30', tone: 'fv-thumb-lime' }].map((row) => <div class="fv-batch-row"><span class:list={['fv-thumb', row.tone]}><i></i></span><div><b>{row.file}</b><small>{row.len} · Sample file</small></div><span class="fv-slot">{row.slot}</span></div>)}</div><div class="fv-batch-more">+ 10 more in the preview</div></div><div class="fv-floating fv-batch-note"><span class="fv-clock"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg></span><div>Spread over your time slots<small>Check every date before it is scheduled</small></div><span class="fv-check">✓</span></div>
    </>}
  </div>
  <figcaption class="fv-caption">{kind === 'analytics' ? 'Example report' : 'Illustrative workspace'}</figcaption>
</figure>

<style>
