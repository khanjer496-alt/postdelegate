---
interface Props { kind?: 'planning' | 'media' | 'teams' | 'analytics' | 'workflow' | 'composer'; }
const { kind = 'planning' } = Astro.props;
const labels = {
  planning: 'Illustrative weekly content plan',
  media: 'Illustrative media library with original artwork',
  teams: 'Illustrative team review with sample members Maya and Alex',
  analytics: 'Example report with illustrative activity bars',
  workflow: 'Illustrative draft, review and calendar workflow',
  composer: 'Illustrative post composer with an original sample draft',
};
---

<figure class:list={['fv-visual', `fv-${kind}`]} aria-label={labels[kind]}>
  <div class="fv-scene" aria-hidden="true">
    {kind === 'planning' && <>
      <div class="fv-week"><div class="fv-card-top"><strong>This week</strong><span>June 8 – 12 <b>⌄</b></span></div><div class="fv-columns">{['Mon 08','Tue 09','Wed 10','Thu 11','Fri 12'].map((day, i) => <div><span class:list={{ 'fv-current': i === 2 }}>{day}</span><i></i></div>)}</div><div class="fv-plan fv-plan-one"><span class="fv-channel">◎</span><div><b>Studio notes</b><small>09:00 · Instagram</small></div></div><div class="fv-plan fv-plan-two"><span class="fv-channel fv-linkedin">in</span><div><b>A new perspective</b><small>12:30 · LinkedIn</small></div></div><div class="fv-plan fv-plan-three"><i></i><b>Behind the scenes</b><span>Draft</span></div></div><div class="fv-floating fv-plan-note"><span class="fv-clock"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg></span><div>A time for every idea.<small>One calendar. A clearer week.</small></div></div>
    </>}
    {kind === 'media' && <>
      <div class="fv-library"><div class="fv-card-top"><strong>Media library</strong><span><svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" /></svg>Upload</span></div><div class="fv-tabs"><b>All media</b><span>Images</span><span>Videos</span></div><div class="fv-media-grid"><div class="fv-art fv-peach"><i></i><b>the art<br/>of less.</b><span>01</span></div><div class="fv-art fv-lime"><i></i><b>MAKE<br/>SPACE.</b><span>02</span></div><div class="fv-art fv-lilac"><i></i><b>another<br/>perspective.</b><span>03</span></div></div><div class="fv-library-bottom"><span><svg viewBox="0 0 16 16"><path d="M2 4h5l2 2h5v7H2z" /></svg>Brand collection</span><span>Original sample artwork</span></div></div><div class="fv-floating fv-file-note"><span class="fv-file-icon"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7zM14 3v5h4M10 12h5M10 15h5" /></svg></span><div>studio-notes.png<small>Ready for your next draft</small></div><span class="fv-check">✓</span></div>
    </>}
    {kind === 'teams' && <>
      <div class="fv-team"><div class="fv-card-top"><strong>Your studio, together</strong><span class="fv-more">···</span></div><div class="fv-person"><span class="fv-avatar fv-maya">M</span><div><b>Maya <small>You</small></b><span>Workspace owner</span></div><span class="fv-role">Owner <b>⌄</b></span></div><div class="fv-person"><span class="fv-avatar fv-alex">A</span><div><b>Alex</b><span>Content collaborator</span></div><span class="fv-role">Editor <b>⌄</b></span></div><div class="fv-invite"><span>+</span>A little more room for your team</div></div><div class="fv-floating fv-comment"><span class="fv-avatar fv-alex">A</span><div><b>Alex <small>Sample comment</small></b><p>Love this direction.<br/>Ready for your review.</p></div><span class="fv-comment-dot"></span></div>
    </>}
    {kind === 'analytics' && <>
      <div class="fv-report"><div class="fv-card-top"><div><span class="fv-eyebrow">EXAMPLE REPORT</span><strong>A little perspective.</strong></div><span>Weekly view <b>⌄</b></span></div><div class="fv-chart"><div class="fv-chart-lines"><i></i><i></i><i></i><i></i></div><div class="fv-bars">{[34,54,42,77,63,96,79].map((height, i) => <div><span style={`--fv-bar:${height}px`} class:list={{ 'fv-bar-lime': i === 3, 'fv-bar-purple': i === 5 }}></span><small>{['M','T','W','T','F','S','S'][i]}</small></div>)}</div></div><div class="fv-legend"><span><i></i>Illustrative activity</span><span>Sample data, not results</span></div></div>
    </>}
    {kind === 'workflow' && <>
      <span class="fv-workflow-label">A LITTLE STRUCTURE. MORE ROOM TO CREATE.</span><div class="fv-track">{[{ title: 'Draft', note: 'Find the words', icon: 'm5 16 10-10 3 3L8 19H5v-3ZM13 8l3 3' }, { title: 'Review', note: 'Make it yours', icon: 'm7 12 3 3 7-7M12 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16Z' }, { title: 'Calendar', note: 'Choose a moment', icon: 'M7 3v4m10-4v4M4 10h16M5 5h14a1 1 0 0 1 1 1v13H4V6a1 1 0 0 1 1-1Z' }].map((step, i) => <>{i > 0 && <span class="fv-join">→</span>}<div class:list={['fv-step', { 'fv-review': i === 1 }]}><span><svg viewBox="0 0 24 24"><path d={step.icon}/></svg></span><b>{step.title}</b><small>{step.note}</small></div></>)}</div><div class="fv-floating fv-flow-note"><span class="fv-note-mark">✳</span><div><b>Studio notes</b><small>Sample workflow · Ready to schedule</small></div><span class="fv-check">✓</span></div>
    </>}
    {kind === 'composer' && <>
      <div class="fv-composer-card"><div class="fv-card-top"><strong>A new post</strong><span class="fv-close">×</span></div><div class="fv-compose-channels"><span class="fv-channel">◎</span><span class="fv-channel fv-linkedin">in</span><span class="fv-add">+</span><small>Your channels</small></div><div class="fv-editor"><span>THE FIRST WORDS ARE YOURS.</span><p>A fresh perspective.<br/>A little space to make something<br/>worth sharing.<i></i></p><div class="fv-attachment"><span><i></i></span><div>studio-notes.png<small>Original sample artwork</small></div><b>×</b></div></div><div class="fv-composer-bottom"><span>◷ <small>Save as draft</small></span><b>Schedule <span>↗</span></b></div></div>
    </>}
  </div>
  <figcaption class="fv-caption">{kind === 'analytics' ? 'Example report' : 'Illustrative workspace'}</figcaption>
</figure>

<style>
  .fv-visual{--fv-ink:#3b3241;--fv-muted:#b3a4bd;position:relative;isolation:isolate;display:flex;flex-direction:column;width:100%;min-width:0;height:260px;margin:0;overflow:hidden;border:1px solid #e8e1ed;border-radius:24px;background:#f5f2f8;color:var(--fv-ink);font-family:inherit;text-align:left}.fv-visual *{box-sizing:border-box}.fv-scene{position:relative;flex:1;width:360px;max-width:100%;margin:auto}.fv-caption{position:relative;z-index:3;padding:0 16px 11px;text-align:right;font-size:7px;letter-spacing:.15px;color:#a99ab4}.fv-card-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.fv-card-top>strong{font-size:11px;font-weight:650;letter-spacing:-.3px}.fv-card-top>span{display:flex;align-items:center;gap:4px;font-size:7px;font-weight:450;color:#a08aaf}.fv-card-top>span>b{font-size:9px;font-weight:400}.fv-card-top svg{height:11px;width:11px;fill:none;stroke:currentColor;stroke-width:1.3}
