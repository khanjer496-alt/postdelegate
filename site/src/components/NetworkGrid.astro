---
// "Schedule posts for every network": one card per live network, linking to its scheduler page,
// then the networks that are not live yet, greyed out and labelled. Never mix the two.
import NetworkBadge from './NetworkBadge.astro';
import { NETWORKS, AVAILABLE_NETWORKS, NOT_LIVE_KEYS, type Network } from '../data/networks';
import { SCHEDULERS } from '../data/schedulers';
import { localeHref, strings, type Lang } from '../i18n';
interface Props { exclude?: string; headingLevel?: 'h3' | 'h4'; lang?: Lang }
const { exclude, headingLevel = 'h3', lang = 'en' } = Astro.props;
const t = strings(lang);
const g = t.networkGrid;
const Heading = headingLevel;
const live = AVAILABLE_NETWORKS.filter((n) => n.key !== exclude);
const href = (n: Network) => localeHref(lang, n.scheduler ? `/${n.scheduler}` : `/docs/channels/${n.key}`);
// Same wording as /docs/channels/coming-soon: networks waiting on a platform review are
// "Pending approval"; the others are "Coming soon".
const pending = NOT_LIVE_KEYS
  .map((key) => NETWORKS.find((n) => n.key === key))
  .filter((n): n is Network => Boolean(n) && !n!.available && n!.key !== exclude)
  .map((n) => ({ n, label: SCHEDULERS.find((s) => s.key === n.key)?.pending ? g.pendingApproval : g.comingSoon }));
---
<ul class="ng-grid" aria-label={g.label}>
  {live.map((n) => (
    <li><a class="ng-card" href={href(n)}>
      <NetworkBadge n={n} size="md" />
      <span class="ng-copy"><Heading class="ng-name">{n.name}<span class="sr-only">{g.scheduler}</span></Heading>{(t.networkBlurbs[n.key] ?? n.blurb) && <span class="ng-blurb">{t.networkBlurbs[n.key] ?? n.blurb}</span>}</span>
      <span class="ng-arrow" aria-hidden="true">↗</span>
    </a></li>
  ))}
</ul>
{pending.length > 0 && (
  <div class="ng-pending">
    <p class="ng-pending-title" set:html={g.pendingTitle} />
    <ul class="ng-pending-list" aria-label={g.pendingLabel}>
      {pending.map(({ n, label }) => <li>{n.scheduler
        ? <a class="ng-chip" href={`/${n.scheduler}`}><NetworkBadge n={n} size="xs" /><span>{n.name}</span><small>{label}</small></a>
        : <span class="ng-chip"><NetworkBadge n={n} size="xs" /><span>{n.name}</span><small>{label}</small></span>}</li>)}
    </ul>
    <a class="ng-pending-link" href={localeHref(lang, '/platforms')}>{g.status} <span aria-hidden="true">↗</span></a>
  </div>
)}
<style>
  .ng-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: 0 !important; padding: 0 !important; list-style: none !important; }
  .ng-grid > li, .ng-pending-list > li { margin: 0 !important; padding-inline-start: 0 !important; }
  .ng-card { position: relative; display: flex; align-items: flex-start; gap: 14px; height: 100%; padding-block: 18px; padding-inline: 18px 40px; border: 1px solid #2a2a2a; border-radius: 18px; background: #141414; transition: border-color .2s, background .2s, transform .2s; color: #fff; text-decoration: none !important; }
  .ng-card:hover { border-color: #c8ff4d80; background: #171a12; transform: translateY(-2px); }
  .ng-copy { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .ng-card .ng-name { margin: 0; color: #fff; font-size: 16px; font-weight: 750; letter-spacing: -.015em; line-height: 1.3; }
  .ng-card .ng-blurb { color: #a9a9a9; font-size: 13px; line-height: 1.5; }
  .ng-arrow { position: absolute; top: 16px; inset-inline-end: 16px; color: #c8ff4d; font-size: 14px; }
  .ng-pending { display: flex; margin-bottom: 0; flex-wrap: wrap; align-items: center; gap: 14px 18px; margin-top: 18px; padding: 18px 20px; border: 1px dashed #333; border-radius: 18px; }
  .ng-pending .ng-pending-title { flex: 1 1 260px; margin: 0; color: #9c9c9c; font-size: 13.5px; line-height: 1.6; }
  .ng-pending-title b { color: #d6d6d6; }
  .ng-pending-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 !important; padding: 0 !important; list-style: none !important; }
  .ng-pending-list .ng-chip { display: inline-flex; align-items: center; gap: 7px; padding-block: 4px; padding-inline: 4px 10px; border: 1px solid #2c2c2c; border-radius: 99px; color: #a3a3a3; font-size: 12px; }
  .ng-chip > :global(span[aria-hidden]) { filter: grayscale(1); opacity: .55; }
  a.ng-chip { text-decoration: none !important; color: #a3a3a3 !important; }
  a.ng-chip:hover { border-color: #4a4a4a; color: #d6d6d6 !important; }
  .ng-pending-list small { color: #8a8a8a; font-size: 10.5px; }
  .ng-pending-list small::before { content: '·'; margin-inline-end: 6px; }
  .ng-pending a.ng-pending-link { color: #d1bfff; text-decoration: none; font-size: 13.5px; font-weight: 650; white-space: nowrap; }
  .ng-pending a.ng-pending-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 1000px) { .ng-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .ng-grid { gap: 10px; }
    .ng-card { flex-direction: column; gap: 10px; padding: 14px 14px 16px; border-radius: 16px; }
    .ng-card .ng-name { font-size: 15px; }
    .ng-card .ng-blurb { font-size: 12px; }
    .ng-arrow { top: 14px; inset-inline-end: 14px; }
    .ng-pending { padding: 16px; }
  }
</style>
