---
// A screenshot of the product, captured from the running app rather than drawn.
// Width and height are set so the space is reserved before it loads, and the
// caption says what is on screen - the alt text carries the same information
// for anyone who cannot see it.
interface Props { shot: 'calendar' | 'composer'; caption: string; class?: string }
const { shot, caption, class: className } = Astro.props;
const SHOTS = {
  calendar: {
    src: '/images/postdelegate-calendar-month.webp',
    alt: 'The PostDelegate calendar in month view: a sidebar of six connected channels on the left, and scheduled posts laid out across a week of November.',
  },
  composer: {
    src: '/images/postdelegate-composer.webp',
    alt: 'The PostDelegate composer: a post being written for Bluesky with a live character count of 205 of 300, and a preview of the finished post beside it.',
  },
} as const;
const { src, alt } = SHOTS[shot];
---
<figure class:list={['app-shot', className]}>
  <img src={src} alt={alt} width="800" height="500" loading="lazy" decoding="async" />
  <figcaption>{caption}</figcaption>
</figure>
<style>
  .app-shot { margin: 32px 0; }
  .app-shot img {
    display: block;
    width: 100%;
    max-width: 800px;
    height: auto;
    border: 1px solid var(--line, #2a2a2a);
    border-radius: 14px;
  }
  .app-shot figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted, #9aa0ad);
    max-width: 800px;
  }
</style>
