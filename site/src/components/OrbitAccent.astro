---
// PostDelegate's own heading accents, taken from the orbit in the logo mark:
// precise, thin orbit lines with a Signal Lime dot, never hand-drawn marker strokes.
// kind: arc (under a word) | ring (a tilted orbit around a word) | planet (a small ringed body)
interface Props { kind: 'arc' | 'ring' | 'planet'; class?: string }
const { kind, class: cls = '' } = Astro.props;
---
{kind === 'arc' && (<span class:list={['pd-accent pd-arc', cls]} aria-hidden="true"><svg viewBox="0 0 300 20" fill="none" preserveAspectRatio="none"><path d="M2 15C70 3 190 1 290 9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" vector-effect="non-scaling-stroke"/></svg><i></i></span>)}
{kind === 'ring' && (<span class:list={['pd-accent pd-ring', cls]} aria-hidden="true"><svg viewBox="0 0 200 80" fill="none" preserveAspectRatio="none"><ellipse cx="100" cy="40" rx="98" ry="38" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"/></svg><i></i></span>)}
{kind === 'planet' && (<svg class:list={['pd-accent pd-planet floaty', cls]} viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="11" fill="#7357FF"/><ellipse cx="32" cy="32" rx="27" ry="9" transform="rotate(-20 32 32)" stroke="currentColor" stroke-width="2"/><path d="M21.2 26.3a11 11 0 0 1 21.6 1.9" stroke="#7357FF" stroke-width="3"/><circle cx="56" cy="22" r="4" fill="#C8FF4D"/></svg>)}
