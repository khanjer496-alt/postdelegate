---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((item) => <details class="faq-item"><summary><span>{item.q}</span><span class="faq-plus" aria-hidden="true"></span></summary><div class="faq-answer" set:html={item.a} /></details>)}
</div>
<style>
  .faq-list{display:grid;gap:12px;width:100%;text-align:start}.faq-item{border:1px solid var(--line,#2d2d2d);border-radius:16px;background:var(--surface,#151515);overflow:hidden;transition:border-color .2s}.faq-item[open]{border-color:#484848}.faq-item summary{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:75px;padding:22px 26px;list-style:none;cursor:pointer;color:var(--text,#fff);font-size:14px;font-weight:500;line-height:1.6;letter-spacing:-.2px}.faq-item summary::-webkit-details-marker{display:none}.faq-item summary:hover{background:#ffffff03}.faq-item summary:focus-visible{outline:2px solid var(--accent,#7357ff);outline-offset:-4px;border-radius:14px}.faq-plus{position:relative;width:14px;height:14px;flex:0 0 14px;color:#adadad}.faq-plus::before,.faq-plus::after{content:'';position:absolute;background:currentColor;border-radius:2px}.faq-plus::before{left:0;top:6px;width:14px;height:1.5px}.faq-plus::after{left:6px;top:0;height:14px;width:1.5px;transition:transform .2s}.faq-item[open] .faq-plus::after{transform:rotate(90deg)}.faq-answer{padding:0 26px 25px;color:var(--muted,#a6a6a6);font-size:13px;line-height:1.85}.faq-answer :global(a){color:#fff;text-decoration:underline;text-underline-offset:3px}.faq-answer :global(p){margin:0 0 12px}.faq-answer :global(p:last-child){margin-bottom:0}@media(max-width:600px){.faq-item summary{padding:19px 20px;min-height:70px;font-size:13px;gap:18px}.faq-answer{padding:0 20px 22px;font-size:12px}}
</style>
