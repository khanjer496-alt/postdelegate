---
import Logo from './Logo.astro';
import { SITE, CTA_SHORT } from '../data/site';
const columns = [
  { title: 'Product', links: [['Features', '/#features'], ['Pricing', '/pricing'], ['Channels', '/platforms'], [CTA_SHORT, SITE.signup], ['Sign in', SITE.login]] },
  { title: 'AI & developers', links: [['Documentation', '/docs'], ['AI workflows', '/agents'], ['Claude', '/claude-cowork'], ['Codex & coding agents', '/codex'], ['MCP', '/mcp'], ['REST API', '/api'], ['API reference', '/docs/api'], ['MCP setup', '/docs/mcp']] },
  { title: 'Social schedulers', links: [['Instagram', '/instagram-scheduler'], ['Facebook', '/facebook-scheduler'], ['LinkedIn', '/linkedin-scheduler'], ['TikTok', '/tiktok-scheduler'], ['YouTube', '/youtube-scheduler'], ['Threads', '/threads-scheduler'], ['Bluesky', '/bluesky-scheduler'], ['Pinterest', '/pinterest-scheduler']] },
  { title: 'Resources', links: [['Free tools', '/tools'], ['Caption checker', '/tools/caption-checker'], ['UTM builder', '/tools/utm-builder'], ['Compare', '/compare'], ['About', '/about'], ['Support', '/support'], ['Status', '/status']] },
  { title: 'Legal & open source', links: [['Privacy policy', '/privacy'], ['Terms of service', '/terms'], ['Data deletion', '/data-deletion'], ['Licenses', '/licenses'], ['App source code', `${SITE.app}/source`], ['Website source code', '/website-source.tar.gz']] },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-intro"><a href="/" aria-label="PostDelegate home"><Logo /></a><p>A little planning.<br />A lot more presence.</p><a class="footer-email" href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
    <div class="footer-columns">{columns.map((column) => <div><h2>{column.title}</h2><ul>{column.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></div>)}</div>
    <div class="footer-bottom"><p>© {new Date().getFullYear()} {SITE.operator}. All rights reserved.</p><p>Built on <a href="https://github.com/gitroomhq/postiz-app" rel="noopener noreferrer">Postiz</a> · AGPL-3.0</p><p>Network names and logos belong to their respective owners.</p></div>
  </div>
</footer>
<style>
  .site-footer{border-top:1px solid var(--line,#2b2b2b);background:#0b0b0b;color:#fff}.footer-inner{width:min(1160px,calc(100% - 48px));margin:auto;padding:70px 0 26px}.footer-intro{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-bottom:52px;border-bottom:1px solid var(--line,#2b2b2b)}.footer-intro>a:first-child{display:inline-flex;min-height:44px;align-items:center;text-decoration:none}.footer-intro p{font-size:17px;line-height:1.5;letter-spacing:-.5px;font-weight:500;color:#c4c4c4;margin:0}.footer-email{color:#a6a6a6;font-size:13px;text-decoration:none;min-height:44px;display:flex;align-items:center}.footer-email:hover{color:#fff}.footer-columns{display:grid;grid-template-columns:1fr 1.2fr 1.15fr 1fr 1.25fr;gap:30px;padding:48px 0 54px}.footer-columns h2{margin:0 0 16px;font-size:13px;line-height:1.5;font-weight:600;color:#fff}.footer-columns ul{list-style:none;padding:0;margin:0}.footer-columns a{display:inline-flex;align-items:center;min-height:36px;color:#929292;font-size:12px;line-height:1.5;text-decoration:none;transition:color .15s}.footer-columns a:hover{color:#fff}.footer-bottom{display:flex;flex-wrap:wrap;justify-content:space-between;gap:14px 24px;border-top:1px solid var(--line,#2b2b2b);padding-top:24px;color:#858585;font-size:10px;line-height:1.6}.footer-bottom p{margin:0}.footer-bottom a{color:#aaa;text-decoration:underline;text-underline-offset:3px}a:focus-visible{outline:2px solid var(--accent,#7357ff);outline-offset:4px;border-radius:3px}
  @media(max-width:900px){.footer-columns{grid-template-columns:repeat(3,1fr);gap:32px}.footer-intro p{font-size:15px}.footer-email{font-size:12px}.footer-bottom{justify-content:flex-start}}
  @media(max-width:600px){.footer-inner{width:calc(100% - 40px);padding-top:46px}.footer-intro{align-items:flex-start;flex-direction:column;gap:20px;padding-bottom:32px}.footer-intro p{font-size:17px}.footer-columns{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 22px;padding:34px 0}.footer-columns a{font-size:12px;min-height:40px}.footer-bottom{flex-direction:column;gap:10px}}
</style>
