---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Lang } from '../i18n';
interface Props { title: string; description: string; h1: string; eyebrow?: string; lead?: string; jsonLd?: object[]; cta?: boolean; noindex?: boolean; lang?: Lang }
const { title, description, h1, eyebrow, lead, jsonLd = [], cta = true, noindex, lang = 'en' } = Astro.props;
---
<Base title={title} description={description} jsonLd={jsonLd} noindex={noindex} lang={lang}>
  <PageHero eyebrow={eyebrow} title={h1} lead={lead}><slot name="actions" /></PageHero>
  <section class="doc-section"><div class="container"><article class="doc-copy"><slot /></article></div></section>
  {cta && <CtaBand lang={lang} />}
</Base>
<style>
  .doc-section { padding: 62px 0 80px; background: var(--bg, #0d0d0d); color: var(--text, #fff); }
  .doc-copy { max-width: 820px; margin: 0 auto; font-size: 16px; line-height: 1.85; color: var(--muted, #b9b9b9); }
  .doc-copy :global(h2) { margin: 42px 0 16px; color: var(--text, #fff); font-size: clamp(24px, 3vw, 31px); letter-spacing: -.035em; line-height: 1.2; font-weight: 800; }
  .doc-copy :global(h2:first-child) { margin-top: 0; }
  .doc-copy :global(h3) { margin: 24px 0 12px; color: var(--text, #fff); font-size: 20px; font-weight: 750; letter-spacing: -.025em; line-height: 1.35; }
  .doc-copy :global(p) { margin: 15px 0; }
  .doc-copy :global(ul), .doc-copy :global(ol) { padding-inline-start: 24px; margin: 18px 0; }
  .doc-copy :global(ul) { list-style: disc; }
  .doc-copy :global(ol) { list-style: decimal; }
  .doc-copy :global(li) { margin: 7px 0; padding-inline-start: 3px; }
  .doc-copy :global(a:not(.button)) { color: var(--text, #fff); text-decoration: underline; text-underline-offset: 4px; }
  .doc-copy :global(strong) { color: var(--text, #fff); font-weight: 750; }
  .doc-copy :global(.doc-note) { padding: 22px 25px; margin: 28px 0; border: 1px solid #363636; border-radius: 18px; background: #191919; }
  .doc-copy :global(.document-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin: 28px 0; }
  .doc-copy :global(.document-card) { display: flex; flex-direction: column; padding: 25px; border: 1px solid #363636; border-radius: 18px; background: #171717; text-decoration: none !important; }
  .doc-copy :global(.document-card h2), .doc-copy :global(.document-card h3) { margin-top: 0; font-size: 22px; }
  .doc-copy :global(.document-card p) { color: #b9b9b9; font-size: 14px; line-height: 1.8; }
  .doc-copy :global(.document-card span) { margin-top: auto; font-size: 13px; font-weight: 750; }
  .doc-copy :global(.document-card:hover) { border-color: var(--text, #fff); }
  .doc-copy :global(code) { padding: 2px 6px; border-radius: 5px; background: #242424; color: #e5dcff; font-size: .86em; }
  .doc-copy :global(table:not([class])) { display: block; width: 100%; max-width: 100%; overflow-x: auto; margin: 22px 0; border-collapse: collapse; font-size: 14.5px; line-height: 1.6; }
  .doc-copy :global(table:not([class]) th), .doc-copy :global(table:not([class]) td) { padding: 11px 14px; border-bottom: 1px solid #2a2a2a; text-align: start; vertical-align: top; }
  .doc-copy :global(table:not([class]) thead th) { color: var(--text, #fff); font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; border-bottom-color: #3a3a3a; }
  .doc-copy :global(pre) { padding: 20px; margin: 22px 0; border: 1px solid #363636; border-radius: 15px; overflow-x: auto; background: #191919; }
  @media (max-width: 600px) { .doc-section { padding: 42px 0 56px; } .doc-copy :global(.document-grid) { grid-template-columns: 1fr; } }
</style>
