---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE, SOCIAL_PROFILES } from '../data/site';
// markdown: path of the page's Markdown version, announced to agents with rel=alternate.
interface Props { title: string; description: string; ogImage?: string; jsonLd?: object[]; noindex?: boolean; type?: string; markdown?: string }
const { title, description, ogImage = '/og.png', jsonLd = [], noindex = false, type = 'website', markdown } = Astro.props;
const canonicalPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const canonical = new URL(canonicalPath, SITE.url).href;
const og = new URL(ogImage, SITE.url).href;
const logo = { '@type': 'ImageObject', '@id': `${SITE.url}/#logo`, url: new URL('/postdelegate-icon-512.png', SITE.url).href, contentUrl: new URL('/postdelegate-icon-512.png', SITE.url).href, width: 512, height: 512, caption: 'PostDelegate logo' };
const org = { '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: 'PostDelegate', legalName: SITE.operator, url: SITE.url, logo, image: { '@id': `${SITE.url}/#logo` }, email: SITE.email, sameAs: SOCIAL_PROFILES.map((profile) => profile.href) };
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'PostDelegate', url: SITE.url };
const safeJson = (value: object) => JSON.stringify(value).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="preload" href="/fonts/plus-jakarta-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/postdelegate.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/postdelegate-apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content="PostDelegate" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable product facts" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="This page as Markdown" />}
    {[org, website, ...jsonLd].map((value) => <script type="application/ld+json" set:html={safeJson(value)} />)}
  </head>
  <body>
    {/* Cloudflare's email obfuscation would swap support@ and every other address
    for a link that only works with JavaScript; email_off keeps them plain */}
    <!--email_off-->
    <a href="#main" class="skip-link">Skip to content</a>
    <CookieConsent />
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <!--/email_off-->
  </body>
</html>
<style>.skip-link{position:fixed;top:12px;left:16px;z-index:100;transform:translateY(-180%);padding:12px 18px;background:#fff;border-radius:999px;color:#111;font-size:13px;font-weight:600;text-decoration:none}.skip-link:focus{transform:translateY(0);outline:2px solid var(--accent,#7357ff);outline-offset:4px}</style>
