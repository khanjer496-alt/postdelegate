---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE, SOCIAL_PROFILES, NOINDEX_PATHS } from '../data/site';
import { LOCALES, LANGUAGES, TRANSLATED_PATHS, localePath, splitPath, strings, type Lang } from '../i18n';
import { OG_CARDS, ogCardFor } from '../data/og-cards.mjs';
// markdown: path of the page's Markdown version, announced to agents with rel=alternate.
// lang: the page's language; pages that exist in every language get hreflang alternates.
interface Props { title: string; description: string; jsonLd?: object[]; noindex?: boolean; type?: string; markdown?: string; lang?: Lang }
const { title, description, jsonLd = [], type = 'website', markdown, lang = 'en' } = Astro.props;
const canonicalPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const noindex = Astro.props.noindex || NOINDEX_PATHS.includes(canonicalPath);
const canonical = new URL(canonicalPath, SITE.url).href;
const { path: englishPath } = splitPath(canonicalPath);
const alternates = TRANSLATED_PATHS.has(englishPath)
  ? [...LOCALES.map((code) => ({ hreflang: code as string, href: new URL(localePath(code, englishPath), SITE.url).href })), { hreflang: 'x-default', href: new URL(englishPath, SITE.url).href }]
  : [];
const language = LANGUAGES[lang];
const t = strings(lang);
// The page's own share card when it has one (src/data/og-cards.mjs), so a
// guide or a comparison does not unfurl as the generic brand card. Localised
// paths are not in that list and fall back on purpose: an English card over a
// Spanish page reads worse than the brand one.
const card = OG_CARDS[canonicalPath];
const og = new URL(ogCardFor(canonicalPath) ?? '/og.png', SITE.url).href;
const ogAlt = card ? `${card.title} — PostDelegate` : t.common.ogImageAlt;
const logo = { '@type': 'ImageObject', '@id': `${SITE.url}/#logo`, url: new URL('/postdelegate-icon-512.png', SITE.url).href, contentUrl: new URL('/postdelegate-icon-512.png', SITE.url).href, width: 512, height: 512, caption: 'PostDelegate logo' };
const org = { '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: 'PostDelegate', legalName: SITE.operator, url: SITE.url, logo, image: { '@id': `${SITE.url}/#logo` }, email: SITE.email, sameAs: SOCIAL_PROFILES.map((profile) => profile.href) };
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'PostDelegate', url: SITE.url };
const safeJson = (value: object) => JSON.stringify(value).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---
<!doctype html>
<html lang={lang} dir={language.dir === 'rtl' ? 'rtl' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0d0d" />
    <!-- Toolradar's claim check reads this public token; it keeps our listing on
         their Buffer and Publer alternatives pages. -->
    <meta name="toolradar-verify" content="toolradar-verify-1lCvvc8aA5UVlE6CAObc3M" />
    <link rel="preload" href="/fonts/plus-jakarta-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/postdelegate.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/postdelegate-apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Pulse: our self-hosted, cookie-free analytics. It stores nothing on the
         device, so it needs no cookie-banner choice; public/_headers allows it. -->
    <script defer src="https://pulse.nasidaapps.com/js/script.js" data-site="postdelegate"></script>
    <meta property="og:site_name" content="PostDelegate" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {alternates.length > 0 && <meta property="og:locale" content={language.ogLocale} />}
    {alternates.length > 0 && LOCALES.filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={LANGUAGES[code].ogLocale} />)}
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable product facts" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="This page as Markdown" />}
    {[org, website, ...jsonLd].map((value) => <script type="application/ld+json" set:html={safeJson(value)} />)}
  </head>
  <body>
    {/* Cloudflare's email obfuscation would swap support@ and every other address
    for a link that only works with JavaScript; email_off keeps them plain */}
    <!--email_off-->
    <a href="#main" class="skip-link">{t.common.skipToContent}</a>
    <CookieConsent lang={lang} />
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <!--/email_off-->
    <script>
      import { SITE } from '../data/site';
    
      // Pulse's visitor id rides along in this visit's links to the app's sign-up
      // and sign-in, and the app saves it on the Stripe checkout (pulse_vid) so
      // the revenue is credited to the visit. Nothing is stored on the device.
      // Without Pulse (blocked, or no visitor id to give) the links stay as they
      // are.
      type Pulse = { visitorId?: () => Promise<string> };
      const VISITOR = /^[0-9a-f]{32}$/;
      const app = new URL(SITE.app).origin;
    
      const pulse = () => (window as Window & { pulse?: Pulse }).pulse;
      const carry = () => {
        const tracker = pulse();
        if (typeof tracker?.visitorId !== 'function') return;
        Promise.resolve()
          .then(() => tracker.visitorId!())
          .then((id) => {
            if (!VISITOR.test(id)) return;
            document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
              const url = new URL(link.href, location.href);
              // the app's home sends a signed-out visitor to /auth with the same query
              if (url.origin !== app || !(url.pathname === '/' || url.pathname.startsWith('/auth'))) return;
              url.searchParams.set('pulse_vid', id);
              link.href = url.href;
            });
          })
          .catch(() => {});
      };
    
      // the tracker is a deferred script, it is there once the page has loaded
      if (typeof pulse()?.visitorId === 'function' || document.readyState === 'complete') carry();
      else addEventListener('load', carry, { once: true });
    </script>
  </body>
</html>

<style>.skip-link{position:fixed;top:12px;inset-inline-start:16px;z-index:100;transform:translateY(-180%);padding:12px 18px;background:#fff;border-radius:999px;color:#111;font-size:13px;font-weight:600;text-decoration:none}.skip-link:focus{transform:translateY(0);outline:2px solid var(--accent,#7357ff);outline-offset:4px}</style>
