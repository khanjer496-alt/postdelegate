---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import NetworkBadge from '../components/NetworkBadge.astro';
import Icon from '../components/Icon.astro';
import OrbitAccent from '../components/OrbitAccent.astro';
import PersonaArt from '../components/PersonaArt.astro';
import ProductPreview from '../components/ProductPreview.astro';
import FeatureVisual from '../components/FeatureVisual.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import { NETWORKS, AVAILABLE_NETWORKS, type Network } from '../data/networks';
import { FAQ } from '../data/faq';
import { PLANS, TRIAL_DAYS } from '../data/plans';
import { SITE, CTA_LABEL, CTA_SHORT, CTA_NOTE } from '../data/site';
import { AGENT_FILES } from '../data/agent-files';
import '../styles/home.css';
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:FAQ.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
const appLd={'@context':'https://schema.org','@type':'SoftwareApplication',name:'PostDelegate',applicationCategory:'BusinessApplication',operatingSystem:'Web',url:SITE.url,description:`A social media scheduler for planning, writing and scheduling posts from one visual calendar, with Content Studio for vertical videos and bulk video scheduling. Every plan starts with a ${TRIAL_DAYS}-day free trial with no credit card needed. Channel connections are rolling out in stages.`,featureList:['Visual content calendar','Post composer with per-channel settings','Content Studio: vertical 1080×1920 videos with a hook line or word-by-word captions','Bulk video scheduling across your posting time slots','Bulk post import from CSV','Daily views gained analytics for YouTube channels','YouTube publish later and AI content label','Media library','Workspaces and team members','REST API and MCP server','Agent files for Claude, ChatGPT, Cursor and coding agents'],offers:{'@type':'AggregateOffer',priceCurrency:'USD',lowPrice:Math.min(...PLANS.map(p=>p.monthly)),highPrice:Math.max(...PLANS.map(p=>p.monthly)),offerCount:PLANS.length}};
const liveCount=AVAILABLE_NETWORKS.length;
const soonNetworks=NETWORKS.filter(n=>!n.available);
const lowestPrice=Math.min(...PLANS.map(p=>p.monthly));
// Hero orbit: only networks marked available sit on the bright inner rings; a few
// coming-soon networks sit greyed out on the dashed outer ring.
const pick=(keys:string[])=>keys.map(k=>NETWORKS.find(n=>n.key===k)).filter((n):n is Network=>Boolean(n));
const innerKeys=['youtube','bluesky','wordpress','devto'];
const orbitInner=AVAILABLE_NETWORKS.filter(n=>innerKeys.includes(n.key));
const orbitMiddle=AVAILABLE_NETWORKS.filter(n=>!innerKeys.includes(n.key));
// The comet sits in the gap halfway round the middle ring, whatever its size.
const cometAngle=(Math.floor(orbitMiddle.length/2)-0.5)*360/orbitMiddle.length;
const orbitOuter=pick(['instagram','linkedin','tiktok','x','threads','facebook','pinterest','mastodon','reddit','discord','telegram','google_business']).filter(n=>!n.available);
const orbitLabel=`${liveCount} networks connect today: ${AVAILABLE_NETWORKS.map(n=>n.name).join(', ')}. Instagram, LinkedIn, TikTok, X and other networks are coming soon.`;
const days=[1,2,3,4,5,6,7];
const trialSteps=[
 {title:'Sign up in a minute',text:'Use Google or an email and password. No credit card, no sales call.',when:'Day 1',days:[1]},
 {title:'Connect a channel',text:`YouTube, Bluesky, WordPress and ${liveCount-3} more networks connect today.`,when:'Day 1',days:[1]},
 {title:'Plan your first week',text:'Write, schedule and see every post on one calendar.',when:'Days 2 to 6',days:[2,3,4,5,6]},
 {title:'Keep what works',text:'Add a card any time before the trial ends to stay on your plan.',when:'By day 7',days:[7]},
];
const personas:{kind:'creator'|'team'|'developer';kicker:string;title:string;copy:string;tools:string[]}[]=[
 {kind:'creator',kicker:'On your own',title:'Creators & marketers',copy:'A place for the ideas, drafts and assets that make your next post. Give your content a little more room to come together.',tools:['Visual calendar','Composer','Content Studio','Media library']},
 {kind:'team',kicker:'With a team',title:'Brands & teams',copy:'Bring a clearer view to your content calendar. Organize your workspace around the brands and channels you manage.',tools:['Shared calendar','Workspaces','Team members']},
 {kind:'developer',kicker:'From your code',title:'Developers & builders',copy:'A public REST API and an MCP server on every plan. Connect your own code, scripts and agents, and build the workflow your team needs.',tools:['REST API','MCP server','Webhooks']},
];
// Hotspots on the real workspace screenshot (percent of the 1280x720 image), set on
// the corner of each control so the pin never hides the label it points at.
const demoPins=[
 {x:26.6,y:29.2,title:'Create once',text:'Write a post, choose its channels and pick a time from one composer.'},
 {x:52.8,y:33,title:'Posts in their slots',text:'Every scheduled post sits on the calendar, right where it goes out.'},
 {x:72.7,y:15.8,title:'Day, week or month',text:'Zoom from today’s time slots out to the whole month.'},
 {x:19,y:41,title:'Channels at hand',text:'Your connected channels stay beside the calendar, ready to use.'},
];
const integrations=[
 {name:'Claude',route:'/claude-cowork',style:'claude-card',text:'Turn a rough idea into a thoughtful content plan.',prompt:'Help me plan a week of useful posts for our new launch.',response:'Start with the story, the audience and three ideas worth sharing.',label:'Plan with Claude'},
 {name:'ChatGPT',route:'/mcp',style:'chatgpt-card',text:'Find the angle. Refine the words. Keep your voice.',prompt:'Give me three different angles for this launch announcement.',response:'Three directions: the problem, the process and the people.',label:'Explore ChatGPT workflows'},
 {name:'Codex & coding agents',route:'/codex',style:'codex-card',text:'Bring your content workflow closer to the tools you build with.',prompt:'Launch notes → draft ideas',response:'ideas → draft → review → calendar',label:'Explore coding agents'},
 {name:'Automation tools',route:'/api',style:'automation-card',text:'Create a repeatable path from your ideas to your calendar.',prompt:'New idea → prepare a draft',response:'Review content → choose a channel → pick a time',label:'Explore the API'},
];
type FeatureKind='planning'|'media'|'teams'|'analytics'|'bulk'|'composer';
const features:{kind:FeatureKind;tag:string;title:string;text:string;points?:string[];theme:string;link:string;cta:string}[]=[
 {kind:'planning',tag:'Planning',title:'See the whole week. Make room for the good stuff.',text:'Bring your content into a visual calendar. Give every idea a place, keep your plans in view, and make the next step easier to see.',theme:'feature-purple',link:SITE.signup,cta:'Try the calendar free'},
 {kind:'composer',tag:'Composing',title:'One idea. Your own way of telling it.',text:'Shape your content in a composer designed around social publishing. Keep the message together while making room for each channel’s format and settings.',points:['YouTube publish later: the video uploads as private and YouTube makes it public at the time you set','YouTube’s label for realistic altered or AI-made content, one setting away'],theme:'feature-blue',link:'/docs/channels/youtube',cta:'See the YouTube settings'},
 {kind:'bulk',tag:'Bulk video',title:'A folder of videos. Weeks of posts.',text:'Drop in up to 50 videos, pick your channels, and PostDelegate spreads them across your posting time slots. You check every date in a preview before anything is scheduled.',theme:'feature-pink',link:'/docs/bulk-import#bulk-schedule-videos',cta:'How bulk video works'},
 {kind:'analytics',tag:'Views analytics',title:'See which posts keep earning views.',text:'The Views tab charts the views each channel gains per day and ranks your top posts by views gained. YouTube shares view counts today. Other networks join as their connections are approved.',theme:'feature-blue',link:'/docs/analytics#views',cta:'How analytics work'},
 {kind:'media',tag:'Media library',title:'Your content deserves a place of its own.',text:'Keep your public-use images and videos close to your drafts. Upload, find and organize media without losing your place in the workflow.',theme:'feature-purple',link:SITE.signup,cta:'Try the media library free'},
 {kind:'teams',tag:'Workspaces',title:'A little more clarity for every brand.',text:'Start with an organized workspace for your content and channels. Team, Pro and Ultimate plans add team members and room for more channels.',theme:'feature-violet',link:'/about',cta:'Get to know PostDelegate'},
];
// Content Studio (docs/studio.md). The phone on the right is an illustration, not a screenshot.
const studioPoints=[
 {title:'Two templates',text:'Hook over clip puts a bold line over your footage. Talking head + captions burns in captions that light up word by word.',icon:'M4 5h16v14H4zM4 9h16M9 9v10'},
 {title:'Trim, crop and speed',text:'Drag the handles to trim, move the vertical frame to choose what stays in view, and play at 0.5× to 2×.',icon:'M6 4v16M18 4v16M6 8h12M6 16h12'},
 {title:'Captions, your way',text:'From your own OpenAI key with Whisper, billed to you by OpenAI, or from a script you type. Fix any word before you render.',icon:'M4 6h16v10H8l-4 4zM8 10h3m2 0h3M8 13h6'},
 {title:'Ready for the calendar',text:'A 1080×1920 MP4 of up to 90 seconds, saved to your media library. Open in composer and schedule it like any other video.',icon:'M7 3v4m10-4v4M4 10h16M5 5h14v15H5zM9 15l2 2 4-4'},
];
const captionWords=['here’s','the','first','one'];
// The hosted instruction files with a body, linked to their section of /docs/mcp/agent-files.
const agentFileAnchors:Record<string,string>={'Claude skill':'claude-skill','AGENTS.md':'agents-md','ChatGPT instructions':'chatgpt','Cursor rule':'cursor'};
const agentFiles=AGENT_FILES.filter(f=>f.body&&agentFileAnchors[f.title]).map(f=>({title:f.title,file:f.path.split('/').pop(),href:`/docs/mcp/agent-files#${agentFileAnchors[f.title]}`}));
const leadFeatures=features.slice(0,2);
const moreFeatures=features.slice(2);
const channelHref=(n:Network)=>n.scheduler?'/'+n.scheduler:'/platforms';
---
<Base title="PostDelegate: Social Media Scheduler for Teams and AI Agents" description={`Schedule social posts from one visual calendar, turn clips into vertical videos, and let Claude or ChatGPT draft for your approval. ${TRIAL_DAYS}-day free trial, no card.`} jsonLd={[appLd,faqLd]}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-sky" aria-hidden="true"><span class="hero-grid"></span><span class="hero-glow"></span></div>
    <OrbitAccent kind="planet" class="hero-star-one" />
    <div class="home-wide hero-layout">
      <div class="hero-copy">
        <ul class="hero-proof" aria-label="PostDelegate at a glance">
          <li><a href="/pricing">{TRIAL_DAYS}-day free trial <span>No credit card</span></a></li>
          <li><a href="/docs/mcp">REST API + MCP <span>Every plan</span></a></li>
          <li><a href="/platforms">{liveCount} channels <span>Connect today</span></a></li>
        </ul>
        <h1 id="hero-title">Your social media, all in <span class="hero-mark">one place.<OrbitAccent kind="arc" /></span></h1>
        <p class="hero-description">Plan, write and schedule your posts from one visual calendar. Turn clips into vertical videos, and bring your team and the AI assistant you already use.</p>
        <div class="hero-actions">
          <a class="hero-cta" href={SITE.signup}><span>{CTA_LABEL}</span><span class="cta-orb" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h9m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
          <p class="hero-trial-note"><span class="note-dot" aria-hidden="true"></span><strong>{CTA_NOTE}</strong><span class="note-extra">Plans from ${lowestPrice}/month after your trial</span></p>
        </div>
      </div>
      <div class="hero-visual">
        <div class="orbit" role="img" aria-label={orbitLabel}>
          <span class="orbit-ring ring-outer" style="--r:46.5cqw">{orbitOuter.map((n,i)=><span class="orbit-slot" style={`--a:${i*360/orbitOuter.length+15}deg`}><span class="orbit-body orbit-soon"><NetworkBadge n={n} size="sm"/></span></span>)}</span>
          <span class="orbit-ring ring-middle" style="--r:34cqw">{orbitMiddle.map((n,i)=><span class="orbit-slot" style={`--a:${i*360/orbitMiddle.length}deg`}><span class="orbit-body orbit-live"><NetworkBadge n={n} size="md"/></span></span>)}<span class="orbit-slot" style={`--a:${cometAngle}deg`}><span class="orbit-comet"></span></span></span>
          <span class="orbit-ring ring-inner" style="--r:21.5cqw">{orbitInner.map((n,i)=><span class="orbit-slot" style={`--a:${i*90+45}deg`}><span class="orbit-body orbit-live"><NetworkBadge n={n} size="md"/></span></span>)}</span>
          <span class="orbit-core"><img src="/mark.svg?v=orbit-slot" width="56" height="56" alt=""/><b>Your calendar</b></span>
          <span class="orbit-card orbit-card-scheduled"><i class="card-check">✓</i><span><b>Scheduled</b><small>YouTube · Tue 09:00</small></span></span>
          <span class="orbit-card orbit-card-draft"><i class="card-spark">✦</i><span><b>Draft ready to review</b><small>From your own AI, via MCP</small></span></span>
        </div>
        <p class="orbit-legend"><span><i class="legend-live" aria-hidden="true"></i>Connect today</span><span><i class="legend-soon" aria-hidden="true"></i>Coming soon</span><span class="legend-note">Illustration</span></p>
      </div>
    </div>
  </section>
  <section class="workspace-section" aria-label="Workspace preview">
    <div class="container">
      <div class="mode-tabs" role="tablist" aria-label="Choose a workflow preview">
        <button id="classic-tab" role="tab" aria-selected="true" aria-controls="classic-panel" data-preview-tab="classic">Plan on the calendar</button>
        <button id="agents-tab" role="tab" aria-selected="false" aria-controls="agents-panel" tabindex="-1" data-preview-tab="agents">Plan with your assistant <span>MCP</span></button>
      </div>
      <div class="workspace-stage">
        <div role="tabpanel" id="classic-panel" aria-labelledby="classic-tab" data-preview-panel="classic"><ProductPreview id="hero-workspace" /></div>
        <div role="tabpanel" id="agents-panel" aria-labelledby="agents-tab" data-preview-panel="agents" hidden>
          <div class="agent-workspace-preview"><div class="agent-preview-sidebar"><img src="/mark.svg?v=orbit-slot" width="34" height="34" alt=""/><b>PostDelegate</b><small>WORKFLOW PREVIEW</small><span>✦ &nbsp; Your ideas</span><span>▦ &nbsp; Calendar</span><span>▧ &nbsp; Media library</span></div><div class="agent-preview-content"><span class="preview-label">Illustrative example · Your own assistant, connected through MCP</span><h2>A good week starts<br/>with a good idea.</h2><div class="prompt-bubble">Help me turn our launch notes into a week of content.</div><div class="agent-response"><span class="agent-avatar">✦</span><div><strong>Start with a plan you can review.</strong><p>Three angles. A few useful stories. Space to make them your own.</p><div class="draft-pills"><span>Brand story</span><span>Behind the scenes</span><span>Launch day</span></div></div></div><a href="/mcp" class="text-link">See how MCP works <span>↗</span></a></div></div>
        </div>
      </div>
    </div>
  </section>
  <section class="trial-section section" aria-labelledby="trial-title">
    <div class="container">
      <div class="trial-heading reveal"><span class="eyebrow">How the free trial works</span><h2 class="section-heading" id="trial-title">Seven days to see<br/>if it <span class="ink-underline">fits.<OrbitAccent kind="arc"/></span></h2></div>
      <ol class="trial-steps">{trialSteps.map((step,i)=><li class="reveal"><div class="step-top"><span class="step-number" aria-hidden="true">0{i+1}</span><span class="step-days" aria-hidden="true">{days.map(d=><i class:list={{on:step.days.includes(d)}}></i>)}</span></div><span class="step-when">{step.when}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      <div class="trial-footer reveal"><a class="button button-lime" href={SITE.signup}>{CTA_SHORT} <span aria-hidden="true">↗</span></a><p>No card when the trial ends? Your workspace pauses until you choose a plan. Your posts are kept, and channels and team members switch back on with a plan that includes them. One trial per email.</p></div>
    </div>
  </section>
  <section class="persona-section section" aria-labelledby="persona-title">
    <div class="container">
      <div class="persona-head reveal"><div><span class="eyebrow">Three ways in, one calendar</span><h2 class="section-heading" id="persona-title">Built for how<br/>you <span class="ink-underline">publish.<OrbitAccent kind="arc"/></span></h2></div><p class="section-intro">Post on your own, plan with a team or wire it into your own code. Every route ends in the same calendar slot.</p></div>
      <div class="persona-grid">{personas.map((p,i)=><article class:list={['persona-card','reveal',`persona-${p.kind}`]}><div class="persona-art"><PersonaArt kind={p.kind}/></div><div class="persona-copy"><span class="persona-kicker"><b>0{i+1}</b>{p.kicker}</span><h3>{p.title}</h3><p>{p.copy}</p><ul class="persona-tools" aria-label={`Built for ${p.title.toLowerCase()} with`}>{p.tools.map(t=><li>{t}</li>)}</ul></div></article>)}</div>
    </div>
  </section>
  <section class="demo-section section" id="workspace" aria-labelledby="demo-title">
    <div class="container">
      <div class="demo-head reveal"><span class="eyebrow">The real workspace</span><h2 id="demo-title" class="section-heading">Meet your new content workspace.</h2><p class="section-intro">A calendar for the big picture.<br/>A home for the details that make it yours.</p></div>
      <figure class="demo-frame">
        <div class="demo-browser" aria-hidden="true"><span></span><span></span><span></span><span class="demo-address">app.postdelegate.com</span><span class="demo-live"><i></i>Current workspace</span></div>
        <div class="demo-shot">
          <img src="/images/postdelegate-workspace.jpg" width="1280" height="720" alt="The current PostDelegate calendar workspace in week view, with a Create Post button, a connected YouTube channel and a scheduled post on Tuesday" loading="lazy" decoding="async"/>
          {demoPins.map((p,i)=><span class="demo-pin" style={`left:${p.x}%;top:${p.y}%;--d:${i*0.15}s`} aria-hidden="true">{i+1}</span>)}
        </div>
      </figure>
      <ol class="demo-notes">{demoPins.map((p,i)=><li class="reveal"><span class="pin-num" aria-hidden="true">{i+1}</span><div><h3>{p.title}</h3><p>{p.text}</p></div></li>)}</ol>
      <div class="demo-cta reveal"><a class="button button-lime" href={SITE.signup}>Try it free for {TRIAL_DAYS} days <span aria-hidden="true">↗</span></a><p class="demo-caption">A screenshot of the real PostDelegate workspace. {CTA_NOTE}.</p></div>
    </div>
  </section>
  <section class="studio-section section" id="studio" aria-labelledby="studio-title">
    <div class="home-wide">
      <div class="studio-card">
        <div class="studio-copy reveal">
          <span class="studio-kicker"><b>New</b>Content Studio</span>
          <h2 class="section-heading" id="studio-title">Turn a clip into a <span class="ink-underline">vertical video.<OrbitAccent kind="arc"/></span></h2>
          <p class="studio-intro">Pick a video from your media library, trim it, choose what stays in frame and add a hook or captions. PostDelegate renders it and hands it to your composer, ready to schedule.</p>
          <ul class="studio-points">{studioPoints.map(p=><li><span class="studio-point-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={p.icon}/></svg></span><div><h3>{p.title}</h3><p>{p.text}</p></div></li>)}</ul>
          <div class="studio-actions"><a class="button button-lime" href={SITE.signup}>Try Studio free <span aria-hidden="true">↗</span></a><a class="text-link" href="/docs/studio">Read the Studio guide <span aria-hidden="true">↗</span></a></div>
          <p class="studio-terms">Included on every paid plan with fair use. The free trial includes 10 videos. More templates coming.</p>
        </div>
        <div class="studio-visual reveal">
          <div class="studio-stage" role="img" aria-label="Illustration of Content Studio: a vertical 9:16 video that takes turns showing the two templates, Hook over clip with a bold hook line and Talking head + captions with the spoken word highlighted, above a trim bar with two handles.">
            <div class="studio-templates"><span>Hook over clip</span><span class="is-on">Talking head + captions</span></div>
            <div class="studio-phone">
              <div class="studio-screen">
                <svg class="studio-scene" viewBox="0 0 270 480" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="studio-bg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a2a66"/><stop offset="1" stop-color="#120f1c"/></linearGradient><radialGradient id="studio-light" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#c8ff4d" stop-opacity=".22"/><stop offset="1" stop-color="#c8ff4d" stop-opacity="0"/></radialGradient></defs><rect width="270" height="480" fill="url(#studio-bg)"/><circle cx="205" cy="150" r="130" fill="url(#studio-light)"/><rect x="160" y="96" width="78" height="118" rx="6" fill="#ffffff0a" stroke="#ffffff1a"/><path d="M199 96v118M160 155h78" stroke="#ffffff1a"/><rect x="16" y="246" width="74" height="4" rx="2" fill="#ffffff1f"/><rect x="24" y="214" width="10" height="32" rx="2" fill="#7357ff73"/><rect x="36" y="221" width="8" height="25" rx="2" fill="#c8ff4d59"/><rect x="46" y="210" width="11" height="36" rx="2" fill="#ffffff26"/><rect x="62" y="226" width="20" height="20" rx="10" fill="#ffffff14"/><path d="M40 480c0-92 46-132 95-132s95 40 95 132z" fill="#2a2147"/><rect x="120" y="322" width="30" height="34" rx="12" fill="#2f2550"/><circle cx="135" cy="290" r="44" fill="#352a5c"/><path d="M91 284c2-30 22-46 44-46s44 16 44 46c-10-14-26-20-44-20s-34 6-44 20z" fill="#211a38"/><path d="M175 270a44 44 0 0 1 0 40" stroke="#c8ff4d" stroke-opacity=".55" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>
                <span class="studio-hook">3 things I wish<br/>I knew <mark>sooner</mark></span>
                <p class="studio-captions">{captionWords.map((w,i)=><span class:list={{'is-now':i===2}} style={`--i:${i}`}>{w}</span>)}</p>
                <span class="studio-meta"><span>1080×1920</span><span>0:07 / 0:24</span></span>
              </div>
            </div>
            <div class="studio-trim">
              <div class="trim-top"><span>Trim</span><span class="trim-speed"><span>0.5×</span><b>1×</b><span>1.5×</span><span>2×</span></span></div>
              <div class="trim-strip"><span class="trim-frames"></span><span class="trim-window"><i></i><i></i></span><span class="trim-playhead"></span></div>
              <div class="trim-times"><span>0:00</span><span class="trim-kept">24 s kept</span><span>0:41</span></div>
            </div>
            <span class="studio-float studio-float-captions"><i class="card-spark">✦</i><span><b>Word-by-word captions</b><small>Your OpenAI key or a typed script</small></span></span>
            <span class="studio-float studio-float-compose"><i class="card-check">✓</i><span><b>Rendered</b><small>Open in composer</small></span></span>
          </div>
          <p class="orbit-legend studio-legend"><span><i class="legend-live" aria-hidden="true"></i>The word being spoken</span><span class="legend-note">Illustration</span></p>
        </div>
      </div>
    </div>
  </section>
  <section class="integrations-section section" id="ai" aria-labelledby="ai-title"><div class="home-wide"><div class="section-heading-wrap reveal"><span class="eyebrow">BRING YOUR OWN AI</span><h2 class="section-heading" id="ai-title">Your ideas. Your tools.<br/>A more connected <span class="ink-circle">workflow.<OrbitAccent kind="ring"/></span></h2><p class="section-intro">PostDelegate doesn’t sell AI. Connect the assistant you already use through MCP, or automate with the REST API.</p></div><div class="integration-grid">{integrations.map((item,i)=><article class:list={['integration-card','reveal',item.style]}><div class="integration-copy"><span class="integration-symbol">{i===0?<Icon name="claude" class="size-9"/>:i===1?'❋':i===2?'>_':<Icon name="zapier" class="size-9"/>}</span><h3>{item.name}</h3><p>{item.text}</p></div><div class="chat-preview" aria-hidden="true"><div class="chat-title"><span class="chat-dot"></span>{item.name}<small>Example workflow</small></div><div class="chat-prompt">{item.prompt}</div><div class="chat-answer"><span>✦</span><p>{item.response}</p></div><div class="chat-draft"><span class="mini-tag">Draft idea</span><div></div><div></div><div></div></div></div><a href={item.route} class="integration-link">{item.label}<span aria-hidden="true">↗</span></a></article>)}</div><p class="rollout-caption">Illustrative conversations. Your assistant does the writing under your own account; PostDelegate keeps the calendar.</p><div class="agent-files-band reveal"><div class="agent-files-copy"><span class="agent-files-kicker">Ready-made assistant files</span><h3>Teach your assistant the PostDelegate way.</h3><p>A Claude skill, AGENTS.md, ChatGPT instructions and a Cursor rule. Each one tells your assistant to draft first and never schedule or publish without your OK.</p><a class="text-link" href="/docs/mcp/agent-files">Get the agent files <span aria-hidden="true">↗</span></a></div><ul class="agent-files-list" aria-label="Agent files">{agentFiles.map(f=><li><a href={f.href}><span class="agent-file-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7zM14 3v5h4M10 12h5M10 15h5"/></svg></span><span><b>{f.title}</b><small>{f.file}</small></span></a></li>)}</ul></div></div></section>
