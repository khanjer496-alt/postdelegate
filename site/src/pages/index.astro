---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import NetworkBadge from '../components/NetworkBadge.astro';
import Icon from '../components/Icon.astro';
import OrbitAccent from '../components/OrbitAccent.astro';
import PersonaArt from '../components/PersonaArt.astro';
import ProductPreview from '../components/ProductPreview.astro';
import FeatureVisual from '../components/FeatureVisual.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import { NETWORKS, AVAILABLE_NETWORKS, type Network } from '../data/networks';
import { FAQ } from '../data/faq';
import { PLANS, TRIAL_DAYS } from '../data/plans';
import { SITE, CTA_LABEL, CTA_SHORT, CTA_NOTE } from '../data/site';
import '../styles/home.css';
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:FAQ.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
const appLd={'@context':'https://schema.org','@type':'SoftwareApplication',name:'PostDelegate',applicationCategory:'BusinessApplication',operatingSystem:'Web',url:SITE.url,description:`A social media scheduler for planning, writing and scheduling posts from one visual calendar. Every plan starts with a ${TRIAL_DAYS}-day free trial with no credit card needed. Channel connections are rolling out in stages.`,offers:{'@type':'AggregateOffer',priceCurrency:'USD',lowPrice:Math.min(...PLANS.map(p=>p.monthly)),highPrice:Math.max(...PLANS.map(p=>p.monthly)),offerCount:PLANS.length}};
const liveCount=AVAILABLE_NETWORKS.length;
const soonNetworks=NETWORKS.filter(n=>!n.available);
const lowestPrice=Math.min(...PLANS.map(p=>p.monthly));
// Hero orbit: only networks marked available sit on the bright inner rings; a few
// coming-soon networks sit greyed out on the dashed outer ring.
const pick=(keys:string[])=>keys.map(k=>NETWORKS.find(n=>n.key===k)).filter((n):n is Network=>Boolean(n));
const innerKeys=['youtube','bluesky','wordpress','devto'];
const orbitInner=AVAILABLE_NETWORKS.filter(n=>innerKeys.includes(n.key));
const orbitMiddle=AVAILABLE_NETWORKS.filter(n=>!innerKeys.includes(n.key));
// The comet sits in the gap halfway round the middle ring, whatever its size.
const cometAngle=(Math.floor(orbitMiddle.length/2)-0.5)*360/orbitMiddle.length;
const orbitOuter=pick(['instagram','linkedin','tiktok','x','threads','facebook','pinterest','mastodon','reddit','discord','telegram','google_business']).filter(n=>!n.available);
const orbitLabel=`${liveCount} networks connect today: ${AVAILABLE_NETWORKS.map(n=>n.name).join(', ')}. Instagram, LinkedIn, TikTok, X and other networks are coming soon.`;
const days=[1,2,3,4,5,6,7];
const trialSteps=[
 {title:'Sign up in a minute',text:'Use Google or an email and password. No credit card, no sales call.',when:'Day 1',days:[1]},
 {title:'Connect a channel',text:`YouTube, Bluesky, WordPress and ${liveCount-3} more networks connect today.`,when:'Day 1',days:[1]},
 {title:'Plan your first week',text:'Write, schedule and see every post on one calendar.',when:'Days 2 to 6',days:[2,3,4,5,6]},
 {title:'Keep what works',text:'Add a card any time before the trial ends to stay on your plan.',when:'By day 7',days:[7]},
];
const personas:{kind:'creator'|'team'|'developer';kicker:string;title:string;copy:string;tools:string[]}[]=[
 {kind:'creator',kicker:'On your own',title:'Creators & marketers',copy:'A place for the ideas, drafts and assets that make your next post. Give your content a little more room to come together.',tools:['Visual calendar','Composer','Media library']},
 {kind:'team',kicker:'With a team',title:'Brands & teams',copy:'Bring a clearer view to your content calendar. Organize your workspace around the brands and channels you manage.',tools:['Shared calendar','Workspaces','Team members']},
 {kind:'developer',kicker:'From your code',title:'Developers & builders',copy:'An open-source foundation with a public REST API and an MCP server on every plan. Build the workflow your team needs.',tools:['REST API','MCP server','AGPL-3.0']},
];
// Hotspots on the real workspace screenshot (percent of the 1280x720 image), set on
// the corner of each control so the pin never hides the label it points at.
const demoPins=[
 {x:26.6,y:29.2,title:'Create once',text:'Write a post, choose its channels and pick a time from one composer.'},
 {x:52.8,y:33,title:'Posts in their slots',text:'Every scheduled post sits on the calendar, right where it goes out.'},
 {x:72.7,y:15.8,title:'Day, week or month',text:'Zoom from today’s time slots out to the whole month.'},
 {x:19,y:41,title:'Channels at hand',text:'Your connected channels stay beside the calendar, ready to use.'},
];
const integrations=[
 {name:'Claude',route:'/claude-cowork',style:'claude-card',text:'Turn a rough idea into a thoughtful content plan.',prompt:'Help me plan a week of useful posts for our new launch.',response:'Start with the story, the audience and three ideas worth sharing.',label:'Plan with Claude'},
 {name:'ChatGPT',route:'/mcp',style:'chatgpt-card',text:'Find the angle. Refine the words. Keep your voice.',prompt:'Give me three different angles for this launch announcement.',response:'Three directions: the problem, the process and the people.',label:'Explore ChatGPT workflows'},
 {name:'Codex & coding agents',route:'/codex',style:'codex-card',text:'Bring your content workflow closer to the tools you build with.',prompt:'Launch notes → draft ideas',response:'ideas → draft → review → calendar',label:'Explore coding agents'},
 {name:'Automation tools',route:'/api',style:'automation-card',text:'Create a repeatable path from your ideas to your calendar.',prompt:'New idea → prepare a draft',response:'Review content → choose a channel → pick a time',label:'Explore the API'},
];
type FeatureKind='planning'|'media'|'teams'|'analytics'|'workflow'|'composer';
const features:{kind:FeatureKind;tag:string;title:string;text:string;theme:string;link:string;cta:string}[]=[
 {kind:'planning',tag:'Planning',title:'See the whole week. Make room for the good stuff.',text:'Bring your content into a visual calendar. Give every idea a place, keep your plans in view, and make the next step easier to see.',theme:'feature-purple',link:SITE.signup,cta:'Try the calendar free'},
 {kind:'composer',tag:'Composing',title:'One idea. Your own way of telling it.',text:'Shape your content in a composer designed around social publishing. Keep the message together while making room for each channel’s format.',theme:'feature-blue',link:'/platforms',cta:'Explore channel workflows'},
 {kind:'media',tag:'Media library',title:'Your content deserves a place of its own.',text:'Keep your public-use images and assets close to your drafts. Upload, find and organize media without losing your place in the workflow.',theme:'feature-pink',link:SITE.signup,cta:'Try the media library free'},
 {kind:'teams',tag:'Workspaces',title:'A little more clarity for every brand.',text:'Start with an organized workspace for your content and channels. Team, Pro and Ultimate plans add team members and room for more channels.',theme:'feature-violet',link:'/about',cta:'Get to know PostDelegate'},
 {kind:'workflow',tag:'Your workflow',title:'Make a habit of showing up.',text:'Ideas, drafts and a calendar belong together. Build a content routine you can come back to, with channel publishing opening in stages.',theme:'feature-purple',link:'/platforms',cta:'View the channel directory'},
 {kind:'analytics',tag:'What’s next',title:'Learn from what you put out into the world.',text:'Channel analytics and connected workflows are part of the rollout ahead. Availability will depend on the networks and permissions you connect.',theme:'feature-blue',link:'/support',cta:'Ask about the rollout'},
];
const leadFeatures=features.slice(0,2);
const moreFeatures=features.slice(2);
const channelHref=(n:Network)=>n.scheduler?'/'+n.scheduler:'/platforms';
---
<Base title="PostDelegate — Your social media, all in one place" description={`Plan, write and schedule your social posts from one visual calendar. Start a ${TRIAL_DAYS}-day free trial of PostDelegate, no credit card needed.`} jsonLd={[appLd,faqLd]}>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-sky" aria-hidden="true"><span class="hero-grid"></span><span class="hero-glow"></span></div>
    <OrbitAccent kind="planet" class="hero-star-one" />
    <div class="home-wide hero-layout">
      <div class="hero-copy">
        <ul class="hero-proof" aria-label="PostDelegate at a glance">
          <li><a href={SITE.source}>Open source <span>AGPL-3.0</span></a></li>
          <li><a href="/docs/mcp">REST API + MCP <span>Every plan</span></a></li>
          <li><a href="/platforms">{liveCount} channels <span>Connect today</span></a></li>
        </ul>
        <h1 id="hero-title">Your social media, all in <span class="hero-mark">one place.<OrbitAccent kind="arc" /></span></h1>
        <p class="hero-description">Plan, write and schedule your posts from one visual calendar. Bring your team, your media and the AI assistant you already use.</p>
        <div class="hero-actions">
          <a class="hero-cta" href={SITE.signup}><span>{CTA_LABEL}</span><span class="cta-orb" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h9m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
          <p class="hero-trial-note"><span class="note-dot" aria-hidden="true"></span><strong>{CTA_NOTE}</strong><span class="note-extra">Plans from ${lowestPrice}/month after your trial</span></p>
        </div>
      </div>
      <div class="hero-visual">
        <div class="orbit" role="img" aria-label={orbitLabel}>
          <span class="orbit-ring ring-outer" style="--r:46.5cqw">{orbitOuter.map((n,i)=><span class="orbit-slot" style={`--a:${i*360/orbitOuter.length+15}deg`}><span class="orbit-body orbit-soon"><NetworkBadge n={n} size="sm"/></span></span>)}</span>
          <span class="orbit-ring ring-middle" style="--r:34cqw">{orbitMiddle.map((n,i)=><span class="orbit-slot" style={`--a:${i*360/orbitMiddle.length}deg`}><span class="orbit-body orbit-live"><NetworkBadge n={n} size="md"/></span></span>)}<span class="orbit-slot" style={`--a:${cometAngle}deg`}><span class="orbit-comet"></span></span></span>
          <span class="orbit-ring ring-inner" style="--r:21.5cqw">{orbitInner.map((n,i)=><span class="orbit-slot" style={`--a:${i*90+45}deg`}><span class="orbit-body orbit-live"><NetworkBadge n={n} size="md"/></span></span>)}</span>
          <span class="orbit-core"><img src="/mark.svg?v=orbit-slot" width="56" height="56" alt=""/><b>Your calendar</b></span>
          <span class="orbit-card orbit-card-scheduled"><i class="card-check">✓</i><span><b>Scheduled</b><small>YouTube · Tue 09:00</small></span></span>
          <span class="orbit-card orbit-card-draft"><i class="card-spark">✦</i><span><b>Draft ready to review</b><small>From your own AI, via MCP</small></span></span>
        </div>
        <p class="orbit-legend"><span><i class="legend-live" aria-hidden="true"></i>Connect today</span><span><i class="legend-soon" aria-hidden="true"></i>Coming soon</span><span class="legend-note">Illustration</span></p>
      </div>
    </div>
  </section>
  <section class="workspace-section" aria-label="Workspace preview">
    <div class="container">
      <div class="mode-tabs" role="tablist" aria-label="Choose a workflow preview">
        <button id="classic-tab" role="tab" aria-selected="true" aria-controls="classic-panel" data-preview-tab="classic">Plan on the calendar</button>
        <button id="agents-tab" role="tab" aria-selected="false" aria-controls="agents-panel" tabindex="-1" data-preview-tab="agents">Plan with your assistant <span>MCP</span></button>
      </div>
      <div class="workspace-stage">
        <div role="tabpanel" id="classic-panel" aria-labelledby="classic-tab" data-preview-panel="classic"><ProductPreview id="hero-workspace" /></div>
        <div role="tabpanel" id="agents-panel" aria-labelledby="agents-tab" data-preview-panel="agents" hidden>
          <div class="agent-workspace-preview"><div class="agent-preview-sidebar"><img src="/mark.svg?v=orbit-slot" width="34" height="34" alt=""/><b>PostDelegate</b><small>WORKFLOW PREVIEW</small><span>✦ &nbsp; Your ideas</span><span>▦ &nbsp; Calendar</span><span>▧ &nbsp; Media library</span></div><div class="agent-preview-content"><span class="preview-label">Illustrative example · Your own assistant, connected through MCP</span><h2>A good week starts<br/>with a good idea.</h2><div class="prompt-bubble">Help me turn our launch notes into a week of content.</div><div class="agent-response"><span class="agent-avatar">✦</span><div><strong>Start with a plan you can review.</strong><p>Three angles. A few useful stories. Space to make them your own.</p><div class="draft-pills"><span>Brand story</span><span>Behind the scenes</span><span>Launch day</span></div></div></div><a href="/mcp" class="text-link">See how MCP works <span>↗</span></a></div></div>
        </div>
      </div>
    </div>
  </section>
  <section class="trial-section section" aria-labelledby="trial-title">
    <div class="container">
      <div class="trial-heading reveal"><span class="eyebrow">How the free trial works</span><h2 class="section-heading" id="trial-title">Seven days to see<br/>if it <span class="ink-underline">fits.<OrbitAccent kind="arc"/></span></h2></div>
      <ol class="trial-steps">{trialSteps.map((step,i)=><li class="reveal"><div class="step-top"><span class="step-number" aria-hidden="true">0{i+1}</span><span class="step-days" aria-hidden="true">{days.map(d=><i class:list={{on:step.days.includes(d)}}></i>)}</span></div><span class="step-when">{step.when}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      <div class="trial-footer reveal"><a class="button button-lime" href={SITE.signup}>{CTA_SHORT} <span aria-hidden="true">↗</span></a><p>No card when the trial ends? Your workspace pauses until you choose a plan. Your posts are kept, and channels and team members switch back on with a plan that includes them. One trial per email.</p></div>
    </div>
  </section>
  <section class="persona-section section" aria-labelledby="persona-title">
    <div class="container">
      <div class="persona-head reveal"><div><span class="eyebrow">Three ways in, one calendar</span><h2 class="section-heading" id="persona-title">Built for how<br/>you <span class="ink-underline">publish.<OrbitAccent kind="arc"/></span></h2></div><p class="section-intro">Post on your own, plan with a team or wire it into your own code. Every route ends in the same calendar slot.</p></div>
      <div class="persona-grid">{personas.map((p,i)=><article class:list={['persona-card','reveal',`persona-${p.kind}`]}><div class="persona-art"><PersonaArt kind={p.kind}/></div><div class="persona-copy"><span class="persona-kicker"><b>0{i+1}</b>{p.kicker}</span><h3>{p.title}</h3><p>{p.copy}</p><ul class="persona-tools" aria-label={`Built for ${p.title.toLowerCase()} with`}>{p.tools.map(t=><li>{t}</li>)}</ul></div></article>)}</div>
    </div>
  </section>
  <section class="demo-section section" id="workspace" aria-labelledby="demo-title">
    <div class="container">
      <div class="demo-head reveal"><span class="eyebrow">The real workspace</span><h2 id="demo-title" class="section-heading">Meet your new content workspace.</h2><p class="section-intro">A calendar for the big picture.<br/>A home for the details that make it yours.</p></div>
      <figure class="demo-frame">
        <div class="demo-browser" aria-hidden="true"><span></span><span></span><span></span><span class="demo-address">app.postdelegate.com</span><span class="demo-live"><i></i>Current workspace</span></div>
        <div class="demo-shot">
          <img src="/images/postdelegate-workspace.jpg" width="1280" height="720" alt="The current PostDelegate calendar workspace in week view, with a Create Post button, a connected YouTube channel and a scheduled post on Tuesday" loading="lazy" decoding="async"/>
          {demoPins.map((p,i)=><span class="demo-pin" style={`left:${p.x}%;top:${p.y}%;--d:${i*0.15}s`} aria-hidden="true">{i+1}</span>)}
        </div>
      </figure>
      <ol class="demo-notes">{demoPins.map((p,i)=><li class="reveal"><span class="pin-num" aria-hidden="true">{i+1}</span><div><h3>{p.title}</h3><p>{p.text}</p></div></li>)}</ol>
      <div class="demo-cta reveal"><a class="button button-lime" href={SITE.signup}>Try it free for {TRIAL_DAYS} days <span aria-hidden="true">↗</span></a><p class="demo-caption">A screenshot of the real PostDelegate workspace. {CTA_NOTE}.</p></div>
    </div>
  </section>
  <section class="integrations-section section" id="ai" aria-labelledby="ai-title"><div class="home-wide"><div class="section-heading-wrap reveal"><span class="eyebrow">BRING YOUR OWN AI</span><h2 class="section-heading" id="ai-title">Your ideas. Your tools.<br/>A more connected <span class="ink-circle">workflow.<OrbitAccent kind="ring"/></span></h2><p class="section-intro">PostDelegate has no AI of its own. Connect the assistant you already use through MCP, or automate with the REST API.</p></div><div class="integration-grid">{integrations.map((item,i)=><article class:list={['integration-card','reveal',item.style]}><div class="integration-copy"><span class="integration-symbol">{i===0?<Icon name="claude" class="size-9"/>:i===1?'❋':i===2?'>_':<Icon name="zapier" class="size-9"/>}</span><h3>{item.name}</h3><p>{item.text}</p></div><div class="chat-preview" aria-hidden="true"><div class="chat-title"><span class="chat-dot"></span>{item.name}<small>Example workflow</small></div><div class="chat-prompt">{item.prompt}</div><div class="chat-answer"><span>✦</span><p>{item.response}</p></div><div class="chat-draft"><span class="mini-tag">Draft idea</span><div></div><div></div><div></div></div></div><a href={item.route} class="integration-link">{item.label}<span aria-hidden="true">↗</span></a></article>)}</div><p class="rollout-caption">Illustrative conversations. Your assistant does the writing under your own account; PostDelegate keeps the calendar.</p></div></section>
  <section class="features-section section" id="features" aria-labelledby="features-title">
    <div class="container"><div class="features-title reveal"><span class="eyebrow">Inside PostDelegate</span><h2 class="section-heading" id="features-title">Room for your ideas.<br/>Tools for your <span class="ink-underline">everyday.<OrbitAccent kind="arc"/></span></h2><OrbitAccent kind="planet" class="features-star"/></div></div>
    <div class="home-wide feature-list">
      {leadFeatures.map((f,i)=><article class:list={['feature-row','reveal',f.theme,{'feature-reverse':i%2===1}]}><div class="feature-copy"><span class="feature-tag"><b class="feature-index">0{i+1}</b>{f.tag}</span><h3>{f.title}</h3><p>{f.text}</p><a href={f.link} class="feature-link">{f.cta}<span aria-hidden="true">↗</span></a></div><div class="feature-art"><FeatureVisual kind={f.kind}/></div></article>)}
      <div class="feature-duo">{moreFeatures.map((f,i)=><article class:list={['feature-card','reveal',f.theme]}><div class="feature-art"><FeatureVisual kind={f.kind}/></div><div class="feature-copy"><span class="feature-tag"><b class="feature-index">0{i+3}</b>{f.tag}</span><h3>{f.title}</h3><p>{f.text}</p><a href={f.link} class="feature-link">{f.cta}<span aria-hidden="true">↗</span></a></div></article>)}</div>
    </div>
  </section>
  <section class="channels-section section" id="channels" aria-labelledby="channels-title">
    <div class="container channels-head">
      <div class="reveal"><span class="eyebrow">The channel directory</span><h2 class="section-heading" id="channels-title">Your channels.<br/>One place to plan.</h2><p class="section-intro">From YouTube to WordPress, connect a channel on day one. The rest are in the directory and open as each platform approves PostDelegate.</p></div>
      <p class="channels-stat reveal"><b>{liveCount}</b><span>networks connect today</span><small>+{soonNetworks.length} more in the directory, coming soon</small></p>
    </div>
    <div class="channel-wall">
      <div class="marquee">
        <ul class="marquee-track" aria-label="Networks you can connect today">{AVAILABLE_NETWORKS.map(n=><li><a class="channel-pill is-live" href={channelHref(n)}><NetworkBadge n={n} size="md"/><span><b>{n.name}</b><small><i aria-hidden="true"></i>Connect today</small></span></a></li>)}</ul>
        <ul class="marquee-track marquee-copy" aria-hidden="true">{AVAILABLE_NETWORKS.map(n=><li><a class="channel-pill is-live" href={channelHref(n)} tabindex="-1"><NetworkBadge n={n} size="md"/><span><b>{n.name}</b><small><i></i>Connect today</small></span></a></li>)}</ul>
      </div>
      <div class="marquee marquee-reverse">
        <ul class="marquee-track" aria-label="Networks coming soon">{soonNetworks.map(n=><li><a class="channel-pill is-soon" href={channelHref(n)}><NetworkBadge n={n} size="md"/><span><b>{n.name}</b><small>Coming soon</small></span></a></li>)}</ul>
        <ul class="marquee-track marquee-copy" aria-hidden="true">{soonNetworks.map(n=><li><a class="channel-pill is-soon" href={channelHref(n)} tabindex="-1"><NetworkBadge n={n} size="md"/><span><b>{n.name}</b><small>Coming soon</small></span></a></li>)}</ul>
      </div>
    </div>
    <div class="container channels-foot"><a class="button button-outline" href="/platforms">Explore all channels <span aria-hidden="true">↗</span></a><p class="rollout-caption">Account types and permissions still affect what each connection can do. Check the directory for current availability.</p></div>
  </section>
  <CtaBand eyebrow={`${TRIAL_DAYS} days free`} title="Try it with your own content." text="Connect a channel, plan a real week of posts and see how PostDelegate fits the way you work." />
  <section class="proof-section section" aria-labelledby="proof-title"><div class="container"><div class="reveal"><span class="eyebrow">A FOUNDATION YOU CAN CHECK</span><h2 class="section-heading" id="proof-title">Make it part of<br/>your own working day.</h2></div><div class="proof-grid"><a class="reveal" href={SITE.signup}><span class="proof-icon" aria-hidden="true">▦</span><h3>Try it for {TRIAL_DAYS} days</h3><p>Open the calendar, connect a channel and schedule a real post. {CTA_NOTE}.</p><span class="proof-link">{CTA_SHORT} ↗</span></a><a class="reveal" href={SITE.source}><span class="proof-icon" aria-hidden="true">&lt;/&gt;</span><h3>Built on open source</h3><p>The application is open source under AGPL-3.0. You can read the code behind it.</p><span class="proof-link">View the source ↗</span></a><a class="reveal" href="/docs"><span class="proof-icon" aria-hidden="true">↗</span><h3>Documented in the open</h3><p>Guides for every connectable channel, the REST API and MCP, written from the code.</p><span class="proof-link">Read the docs ↗</span></a></div></div></section>
  <Testimonials />
  <section class="section home-pricing" id="pricing" aria-label="Plans and pricing"><div class="container"><Pricing /><p class="home-pricing-more"><a class="text-link" href="/pricing">Compare every plan <span aria-hidden="true">↗</span></a></p></div></section>
  <section class="section home-faq" id="faq" aria-labelledby="faq-title"><div class="container"><h2 class="section-heading reveal" id="faq-title">Frequently asked <span class="ink-underline">questions.<OrbitAccent kind="arc"/></span></h2><Faq items={FAQ}/></div></section><CtaBand />
  <a class="support-bubble" href="/support"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12a8 8 0 0 1 16 0v6a3 3 0 0 1-3 3h-4M4 12v5H2v-5h2Zm16 0v5h2v-5h-2Z"/></svg>Support</a>
</Base>
<script>
 const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-preview-tab]'));
 const panels=Array.from(document.querySelectorAll<HTMLElement>('[data-preview-panel]'));
 function selectTab(tab:HTMLButtonElement){tabs.forEach(t=>{const selected=t===tab;t.setAttribute('aria-selected',String(selected));t.tabIndex=selected?0:-1});panels.forEach(p=>p.hidden=p.dataset.previewPanel!==tab.dataset.previewTab)}
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>selectTab(tab));tab.addEventListener('keydown',e=>{let next:number|undefined;if(e.key==='ArrowRight')next=(i+1)%tabs.length;if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;if(e.key==='Home')next=0;if(e.key==='End')next=tabs.length-1;if(next!==undefined){e.preventDefault();selectTab(tabs[next]);tabs[next].focus()}})});
</script>
