---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import NetworkBadge from '../components/NetworkBadge.astro';
import Icon from '../components/Icon.astro';
import Doodles from '../components/Doodles.astro';
import ProductPreview from '../components/ProductPreview.astro';
import FeatureVisual from '../components/FeatureVisual.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import { NETWORKS, AVAILABLE_NETWORKS } from '../data/networks';
import { FAQ } from '../data/faq';
import { PLANS, TRIAL_DAYS } from '../data/plans';
import { SITE, CTA_LABEL, CTA_SHORT, CTA_NOTE } from '../data/site';
import '../styles/home.css';
const faqLd={'@context':'https://schema.org','@type':'FAQPage',mainEntity:FAQ.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))};
const appLd={'@context':'https://schema.org','@type':'SoftwareApplication',name:'PostDelegate',applicationCategory:'BusinessApplication',operatingSystem:'Web',url:SITE.url,description:`A social media scheduler for planning, writing and scheduling posts from one visual calendar. Every plan starts with a ${TRIAL_DAYS}-day free trial with no credit card needed. Channel connections are rolling out in stages.`,offers:{'@type':'AggregateOffer',priceCurrency:'USD',lowPrice:Math.min(...PLANS.map(p=>p.monthly)),highPrice:Math.max(...PLANS.map(p=>p.monthly)),offerCount:PLANS.length}};
const liveCount=AVAILABLE_NETWORKS.length;
const lowestPrice=Math.min(...PLANS.map(p=>p.monthly));
const trialSteps=[
 {title:'Sign up in a minute',text:'Use Google or an email and password. No credit card, no sales call.'},
 {title:'Connect a channel',text:`YouTube, Bluesky, WordPress and ${liveCount-3} more networks connect today.`},
 {title:'Plan your first week',text:'Write, schedule and see every post on one calendar.'},
 {title:'Keep what works',text:'Add a card any time before the trial ends to stay on your plan.'},
];
const audiences=[
 {title:'Creators & marketers',copy:'A place for the ideas, drafts and assets that make your next post. Give your content a little more room to come together.',shape:'M12 2C5 2 2 8 3 15s7 9 13 6 7-10 5-15C19 2 15 1 12 2Zm-5 8h.1m8-1h.1M7 15c3 4 7 4 10-1',color:'#da94ef'},
 {title:'Brands & teams',copy:'Bring a clearer view to your content calendar. Organize your workspace around the brands and channels you manage.',shape:'M5 8h14l2 13H3L5 8Zm3 0V5a4 4 0 0 1 8 0v3',color:'#aa8bff'},
 {title:'Developers & builders',copy:'An open-source foundation with a public REST API and an MCP server on every plan. Build the workflow your team needs.',shape:'m3 11 9-9 9 9M6 9v13h12V9M10 22v-8h4v8',color:'#9698ff'},
];
const integrations=[
 {name:'Claude',route:'/claude-cowork',style:'claude-card',text:'Turn a rough idea into a thoughtful content plan.',prompt:'Help me plan a week of useful posts for our new launch.',response:'Start with the story, the audience and three ideas worth sharing.',label:'Plan with Claude'},
 {name:'ChatGPT',route:'/mcp',style:'chatgpt-card',text:'Find the angle. Refine the words. Keep your voice.',prompt:'Give me three different angles for this launch announcement.',response:'Three directions: the problem, the process and the people.',label:'Explore ChatGPT workflows'},
 {name:'Codex & coding agents',route:'/codex',style:'codex-card',text:'Bring your content workflow closer to the tools you build with.',prompt:'Launch notes → draft ideas',response:'ideas → draft → review → calendar',label:'Explore coding agents'},
 {name:'Automation tools',route:'/api',style:'automation-card',text:'Create a repeatable path from your ideas to your calendar.',prompt:'New idea → prepare a draft',response:'Review content → choose a channel → pick a time',label:'Explore the API'},
];
const features=[
 {kind:'planning',tag:'PLANNING',title:'See the whole week. Make room for the good stuff.',text:'Bring your content into a visual calendar. Give every idea a place, keep your plans in view, and make the next step easier to see.',theme:'feature-purple',link:SITE.signup,cta:'Try the calendar free'},
 {kind:'composer',tag:'COMPOSING',title:'One idea. Your own way of telling it.',text:'Shape your content in a composer designed around social publishing. Keep the message together while making room for each channel’s format.',theme:'feature-blue',link:'/platforms',cta:'Explore channel workflows'},
 {kind:'media',tag:'MEDIA LIBRARY',title:'Your content deserves a place of its own.',text:'Keep your public-use images and assets close to your drafts. Upload, find and organize media without losing your place in the workflow.',theme:'feature-pink',link:SITE.signup,cta:'Try the media library free'},
 {kind:'teams',tag:'WORKSPACES',title:'A little more clarity for every brand.',text:'Start with an organized workspace for your content and channels. Team, Pro and Ultimate plans add team members and room for more channels.',theme:'feature-violet',link:'/about',cta:'Get to know PostDelegate'},
 {kind:'workflow',tag:'YOUR WORKFLOW',title:'Make a habit of showing up.',text:'Ideas, drafts and a calendar belong together. Build a content routine you can come back to, with channel publishing opening in stages.',theme:'feature-purple',link:'/platforms',cta:'View the channel directory'},
 {kind:'analytics',tag:'WHAT’S NEXT',title:'Learn from what you put out into the world.',text:'Channel analytics and connected workflows are part of the rollout ahead. Availability will depend on the networks and permissions you connect.',theme:'feature-blue',link:'/support',cta:'Ask about the rollout'},
];
---
<Base title="PostDelegate — Your social media, all in one place" description={`Plan, write and schedule your social posts from one visual calendar. Start a ${TRIAL_DAYS}-day free trial of PostDelegate, no credit card needed.`} jsonLd={[appLd,faqLd]}>
  <section class="home-hero" aria-labelledby="hero-title">
    <Doodles kind="star" class="hero-star-one" /><Doodles kind="star" class="hero-star-two" />
    <svg class="hero-loop" viewBox="0 0 230 185" fill="none" aria-hidden="true"><path d="M-8 19c83-4 111 43 88 72-26 33-89 13-67-18 23-33 121-28 151 26 38 68-12 105-43 71-27-30-9-90 37-95 34-5 48 13 72 27" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
    <div class="container hero-inner">
      <ul class="hero-proof" aria-label="PostDelegate at a glance">
        <li><a href={SITE.source}>Open source <span>AGPL-3.0</span></a></li>
        <li><a href="/docs/mcp">REST API + MCP <span>Every plan</span></a></li>
        <li><a href="/platforms">{liveCount} channels <span>Connect today</span></a></li>
      </ul>
      <h1 id="hero-title">Your social media,<br/>all in <span class="hero-mark">one place.<Doodles kind="underline" /></span></h1>
      <p class="hero-description">Plan, write and schedule your posts from one visual calendar. Bring your team, your media and the AI assistant you already use.</p>
      <a class="button hero-cta" href={SITE.signup}>{CTA_LABEL} <svg width="21" height="18" viewBox="0 0 21 18" fill="none" aria-hidden="true"><path d="m5 4 5 5-5 5m6-10 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <p class="hero-trial-note"><span class="note-dot" aria-hidden="true"></span><strong>{CTA_NOTE}</strong><span class="note-extra"><span class="note-sep" aria-hidden="true"> · </span>Plans from ${lowestPrice}/month after your trial</span></p>
      <div class="hero-networks" aria-label="Social networks in the PostDelegate channel directory">
        <div class="hero-network-row">{NETWORKS.slice(0,16).map(n=><NetworkBadge n={n} size="sm"/>)}</div>
        <div class="hero-network-row">{NETWORKS.slice(16).map(n=><NetworkBadge n={n} size="sm"/>)}</div>
      </div>
      <p class="availability-note">{liveCount} networks connect today · The rest open as each platform approves PostDelegate</p>
    </div>
  </section>
  <section class="workspace-section" aria-label="Workspace preview">
    <div class="container">
      <div class="mode-tabs" role="tablist" aria-label="Choose a workflow preview">
        <button id="classic-tab" role="tab" aria-selected="true" aria-controls="classic-panel" data-preview-tab="classic">I like a clear calendar</button>
        <button id="agents-tab" role="tab" aria-selected="false" aria-controls="agents-panel" tabindex="-1" data-preview-tab="agents">I work with an AI assistant <span>MCP</span></button>
      </div>
      <div role="tabpanel" id="classic-panel" aria-labelledby="classic-tab" data-preview-panel="classic"><ProductPreview id="hero-workspace" /></div>
      <div role="tabpanel" id="agents-panel" aria-labelledby="agents-tab" data-preview-panel="agents" hidden>
        <div class="agent-workspace-preview"><div class="agent-preview-sidebar"><img src="/mark.svg" width="34" height="34" alt=""/><b>PostDelegate</b><small>WORKFLOW PREVIEW</small><span>✦ &nbsp; Your ideas</span><span>▦ &nbsp; Calendar</span><span>▧ &nbsp; Media library</span></div><div class="agent-preview-content"><span class="preview-label">Illustrative example · Your own assistant, connected through MCP</span><h2>A good week starts<br/>with a good idea.</h2><div class="prompt-bubble">Help me turn our launch notes into a week of content.</div><div class="agent-response"><span class="agent-avatar">✦</span><div><strong>Start with a plan you can review.</strong><p>Three angles. A few useful stories. Space to make them your own.</p><div class="draft-pills"><span>Brand story</span><span>Behind the scenes</span><span>Launch day</span></div></div></div><a href="/mcp" class="text-link">See how MCP works <span>↗</span></a></div></div>
      </div>
    </div>
  </section>
  <section class="trial-section section" aria-labelledby="trial-title">
    <div class="container">
      <div class="trial-heading"><span class="eyebrow">How the free trial works</span><h2 class="section-heading" id="trial-title">Seven days to see<br/>if it <span class="ink-underline">fits.<Doodles kind="underline"/></span></h2></div>
      <ol class="trial-steps">{trialSteps.map((step,i)=><li><span class="step-number" aria-hidden="true">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      <div class="trial-footer"><a class="button" href={SITE.signup}>{CTA_SHORT} <span aria-hidden="true">↗</span></a><p>No card when the trial ends? Your workspace pauses until you choose a plan. Your posts are kept, and channels and team members switch back on when you subscribe. One trial per email.</p></div>
    </div>
  </section>
  <section class="audience-section section" aria-labelledby="audience-title"><div class="container"><h2 class="section-heading" id="audience-title">Who is PostDelegate for?</h2><div class="audience-grid">{audiences.map(a=><article><svg viewBox="0 0 24 24" fill="none" stroke={a.color} stroke-width=".8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={a.shape}/></svg><h3>{a.title}</h3><p>{a.copy}</p></article>)}</div></div></section>
  <section class="demo-section section" aria-labelledby="demo-title"><div class="container"><h2 id="demo-title" class="section-heading">Meet your new content workspace.</h2><p class="section-intro">A calendar for the big picture.<br/>A home for the details that make it yours.</p><a class="demo-frame" href={SITE.signup} aria-label={`${CTA_LABEL}: open the PostDelegate workspace`}><div class="demo-browser"><span></span><span></span><span></span><span class="demo-address">app.postdelegate.com</span><span class="demo-live">Current workspace</span></div><img src="/images/postdelegate-workspace.jpg" width="1280" height="720" alt="The current PostDelegate calendar workspace, with calendar navigation and channel controls" loading="lazy"/><span class="demo-open"><span>↗</span> Try it free for {TRIAL_DAYS} days</span></a><p class="demo-caption">The real PostDelegate workspace. Start a free trial to make it yours, no credit card needed.</p></div></section>
  <section class="integrations-section section" id="ai" aria-labelledby="ai-title"><div class="home-wide"><div class="section-heading-wrap"><span class="eyebrow">BRING YOUR OWN AI</span><h2 class="section-heading" id="ai-title">Your ideas. Your tools.<br/>A more connected <span class="ink-circle">workflow.<Doodles kind="circle"/></span></h2><p class="section-intro">PostDelegate has no AI of its own. Connect the assistant you already use through MCP, or automate with the REST API.</p></div><div class="integration-grid">{integrations.map((item,i)=><article class:list={['integration-card',item.style]}><div class="integration-copy"><span class="integration-symbol">{i===0?<Icon name="claude" class="size-9"/>:i===1?'❋':i===2?'>_':<Icon name="zapier" class="size-9"/>}</span><h3>{item.name}</h3><p>{item.text}</p></div><div class="chat-preview"><div class="chat-title"><span class="chat-dot"></span>{item.name}<small>Example workflow</small></div><div class="chat-prompt">{item.prompt}</div><div class="chat-answer"><span>✦</span><p>{item.response}</p></div><div class="chat-draft"><span class="mini-tag">Draft idea</span><div></div><div></div><div></div></div></div><a href={item.route} class="integration-link">{item.label}<span aria-hidden="true">↗</span></a></article>)}</div><p class="rollout-caption">Illustrative conversations. Your assistant does the writing under your own account; PostDelegate keeps the calendar.</p></div></section>
  <section class="features-section section" id="features" aria-labelledby="features-title"><div class="container"><div class="features-title"><h2 class="section-heading" id="features-title">Room for your ideas.<br/>Tools for your <span class="ink-underline">everyday.<Doodles kind="underline"/></span></h2><Doodles kind="star" class="features-star"/></div></div><div class="home-wide feature-list">{features.map((f,i)=><article class:list={['feature-row',f.theme,{'feature-reverse':i%2===1}]}><div class="feature-copy"><span class="eyebrow">{f.tag}</span><h3>{f.title}</h3><p>{f.text}</p><a href={f.link} class="feature-link">{f.cta}<span aria-hidden="true">↗</span></a></div><div class="feature-art"><FeatureVisual kind={f.kind as 'planning'|'media'|'teams'|'analytics'|'workflow'|'composer'}/></div></article>)}</div></section>
  <section class="channels-section section" id="channels" aria-labelledby="channels-title"><div class="container"><h2 class="section-heading" id="channels-title">Your channels.<br/>One place to plan.</h2><p class="section-intro">{liveCount} networks connect today, from YouTube to WordPress. The rest are in the directory and open as each platform approves PostDelegate.</p><div class="channel-mosaic">{NETWORKS.map((n,i)=><a href={n.scheduler?'/'+n.scheduler:'/platforms'} aria-label={`${n.name}: ${n.available?'connect today':'coming soon'}`} style={'--tile-rotate:'+[-5,4,-2,6,0,-4,3,5][i%8]+'deg'}><NetworkBadge n={n} size="lg"/>{n.available&&<i class="tile-live" aria-hidden="true"></i>}</a>)}</div><p class="channel-legend" aria-hidden="true"><span><i class="tile-live"></i>Connect today</span><span><i class="tile-soon"></i>Coming soon</span></p><a class="button button-outline" href="/platforms">Explore all channels <span aria-hidden="true">↗</span></a><p class="rollout-caption">Account types and permissions still affect what each connection can do. Check the directory for current availability.</p></div></section>
  <CtaBand eyebrow={`${TRIAL_DAYS} days free`} title="Try it with your own content." text="Connect a channel, plan a real week of posts and see how PostDelegate fits the way you work." />
  <section class="proof-section section" aria-labelledby="proof-title"><div class="container"><span class="eyebrow">A FOUNDATION YOU CAN CHECK</span><h2 class="section-heading" id="proof-title">Make it part of<br/>your own working day.</h2><div class="proof-grid"><a href={SITE.signup}><span class="proof-icon">▦</span><h3>Try it for {TRIAL_DAYS} days</h3><p>Open the calendar, connect a channel and schedule a real post. {CTA_NOTE}.</p><span class="proof-link">{CTA_SHORT} ↗</span></a><a href={SITE.source}><span class="proof-icon">&lt;/&gt;</span><h3>Built on open source</h3><p>The application is open source under AGPL-3.0. You can read the code behind it.</p><span class="proof-link">View the source ↗</span></a><a href="/docs"><span class="proof-icon">↗</span><h3>Documented in the open</h3><p>Guides for every connectable channel, the REST API and MCP, written from the code.</p><span class="proof-link">Read the docs ↗</span></a></div></div></section>
  <Testimonials />
  <section class="section home-pricing" id="pricing" aria-label="Plans and pricing"><div class="container"><Pricing /><p class="home-pricing-more"><a class="text-link" href="/pricing">Compare every plan <span aria-hidden="true">↗</span></a></p></div></section>
  <section class="section home-faq" id="faq" aria-labelledby="faq-title"><div class="container"><h2 class="section-heading" id="faq-title">Frequently asked <span class="ink-underline">questions.<Doodles kind="underline"/></span></h2><Faq items={FAQ}/></div></section><CtaBand />
  <a class="support-bubble" href="/support"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 12a8 8 0 0 1 16 0v6a3 3 0 0 1-3 3h-4M4 12v5H2v-5h2Zm16 0v5h2v-5h-2Z"/></svg>Support</a>
</Base>
<script>
 const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-preview-tab]'));
 const panels=Array.from(document.querySelectorAll<HTMLElement>('[data-preview-panel]'));
 function selectTab(tab:HTMLButtonElement){tabs.forEach(t=>{const selected=t===tab;t.setAttribute('aria-selected',String(selected));t.tabIndex=selected?0:-1});panels.forEach(p=>p.hidden=p.dataset.previewPanel!==tab.dataset.previewTab)}
 tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>selectTab(tab));tab.addEventListener('keydown',e=>{let next:number|undefined;if(e.key==='ArrowRight')next=(i+1)%tabs.length;if(e.key==='ArrowLeft')next=(i+tabs.length-1)%tabs.length;if(e.key==='Home')next=0;if(e.key==='End')next=tabs.length-1;if(next!==undefined){e.preventDefault();selectTab(tabs[next]);tabs[next].focus()}})});
</script>
