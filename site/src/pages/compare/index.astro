---
import Doc from '../../layouts/Doc.astro';
import CompareCard from '../../components/CompareCard.astro';
// PostDelegate against one other tool, then head-to-head pages built on CompareTool and
// Alternatives; add each new page to the matching list.
const VERSUS = [
  { href: '/compare/postiz', title: 'PostDelegate vs Postiz', text: 'Plan prices, free trial, channel limits, AI approach and support side by side.', tools: ['PostDelegate', 'Postiz'] },
  { href: '/compare/buffer', title: 'PostDelegate vs Buffer', text: 'Flat plans or per-channel pricing, free trial, AI, approvals and networks.', tools: ['PostDelegate', 'Buffer'] },
  { href: '/compare/hootsuite', title: 'PostDelegate vs Hootsuite', text: 'Flat plans or per-seat pricing, approvals, AI, inbox and networks.', tools: ['PostDelegate', 'Hootsuite'] },
  { href: '/compare/later', title: 'PostDelegate vs Later', text: 'Plan prices, post and user limits, AI credits or your own key, and networks.', tools: ['PostDelegate', 'Later'] },
  { href: '/compare/sprout-social', title: 'PostDelegate vs Sprout Social', text: 'Per-seat or flat pricing, free trial, AI, API access and networks.', tools: ['PostDelegate', 'Sprout Social'] },
  { href: '/compare/publer', title: 'PostDelegate vs Publer', text: 'Per-account or flat pricing, entry options and trial, API and MCP access, and networks.', tools: ['PostDelegate', 'Publer'] },
  { href: '/compare/post-bridge', title: 'PostDelegate and Post Bridge', text: 'Questions to ask when choosing a social publishing workflow.', tools: ['PostDelegate', 'Post Bridge'], cta: 'Compare the approach' },
];
const PAIRS = [
  { href: '/compare/postiz-vs-buffer', title: 'Postiz vs Buffer', text: 'Flat plans or per-channel pricing, worked costs at 3, 10 and 30 accounts, self-hosting, API and MCP.', tools: ['Postiz', 'Buffer'] },
  { href: '/compare/postiz-vs-mixpost', title: 'Postiz vs Mixpost', text: 'Two self-hosted schedulers: AGPL or MIT and one-time licenses, server stack, 12-month cost and networks.', tools: ['Postiz', 'Mixpost'] },
  { href: '/compare/postiz-vs-post-bridge', title: 'Postiz vs Post Bridge', text: 'Flat plans by account count, worked costs, team seats, networks, API and MCP, and self-hosting.', tools: ['Postiz', 'Post Bridge'] },
  { href: '/compare/postiz-vs-blotato', title: 'Postiz vs Blotato', text: 'Scheduling first or AI content first: AI credits, account limits, networks and API access during the trial.', tools: ['Postiz', 'Blotato'] },
  { href: '/compare/postiz-vs-zernio', title: 'Postiz vs Zernio', text: 'A scheduling app or a social media API: per-channel or per-account pricing, MCP, webhooks and SDKs.', tools: ['Postiz', 'Zernio'] },
  { href: '/compare/publer-vs-buffer', title: 'Publer vs Buffer', text: 'Free plans and the X catch, per-account or per-channel pricing, bulk CSV, RSS, approvals, API and MCP.', tools: ['Publer', 'Buffer'] },
  { href: '/compare/publer-vs-metricool', title: 'Publer vs Metricool', text: 'Per-account or per-brand pricing, analytics and competitor tracking, bulk tools and the cost of adding X.', tools: ['Publer', 'Metricool'] },
  { href: '/alternatives/postiz', title: 'Postiz alternatives', text: 'Hosted, self-hosted and API options, with a fair section on when to stay on Postiz.', tools: ['Postiz', 'PostDelegate'] },
];
---
<Doc title="Choose your publishing workspace — PostDelegate" description="Compare PostDelegate with Buffer, Hootsuite, Later, Publer, Sprout Social and other social media schedulers: pricing, free trial, AI approach and workflow." h1="PostDelegate compared, with every price sourced." eyebrow="Compare" lead="Prices, limits, AI and networks side by side. Each competitor price links to the page we read it from.">
  <div class="compare-grid">
    {VERSUS.map((card) => <CompareCard {...card} as="h2" />)}
  </div>
  <h2>Head-to-head comparisons</h2>
  <p>Two other tools side by side, with prices read from each vendor's own pricing page and a separate note on where PostDelegate fits.</p>
  <div class="compare-grid">
    {PAIRS.map((card) => <CompareCard {...card} />)}
  </div>
  <p>PostDelegate is built on the open-source Postiz project (AGPL-3.0). See <a href="/licenses">/licenses</a>.</p>
  <p>Looking for a Buffer or Hootsuite alternative? See <a href="/alternatives">social media scheduler alternatives</a> for a short summary of each comparison.</p>
  <h2>Try the work you actually do</h2>
  <p>Choose an account you manage, prepare a representative post, and check the connection, review and scheduling experience. Confirm the platforms and features you need before choosing a paid service.</p>
</Doc>
<style>
  .compare-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 28px 0 36px; }
  @media (max-width: 600px) { .compare-grid { grid-template-columns: 1fr; } }
</style>
