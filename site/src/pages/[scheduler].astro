---
import Doc from '../layouts/Doc.astro';
import Faq from '../components/Faq.astro';
import { SCHEDULERS } from '../data/schedulers';
import { SITE, CTA_LABEL } from '../data/site';
import { PLANS, TRIAL_DAYS } from '../data/plans';
import { NETWORKS, AVAILABLE_NETWORKS } from '../data/networks';
import NetworkBadge from '../components/NetworkBadge.astro';
import LogoStack from '../components/LogoStack.astro';
import NetworkGrid from '../components/NetworkGrid.astro';
export function getStaticPaths() { return SCHEDULERS.map((s) => ({ params: { scheduler: s.slug }, props: { s } })); }
const { s } = Astro.props;
const availableKeys = new Set(AVAILABLE_NETWORKS.map((network) => network.key));
const isAvailable = (item: { key: string }) => availableKeys.has(item.key);
const available = isAvailable(s);
// Answers are plain text with optional [label](/path) links: the visible FAQ gets anchors, the JSON-LD plain text.
const escape = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const withLinks = (text: string) => escape(text).replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
const plain = (text: string) => text.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const pending = s.pending ?? 'the connection is ready';
const starter = PLANS[0];
const openCount = AVAILABLE_NETWORKS.length;
const network = NETWORKS.find((n) => n.key === s.key);
const alongside = AVAILABLE_NETWORKS.filter((n) => n.key !== s.key);

const action = s.action ?? `Schedule ${s.name} Posts`;
const howTo = `${action.charAt(0).toLowerCase()}${action.slice(1)}`;
const title = available ? `${s.name} Scheduler: ${action} | PostDelegate` : `${s.name} Scheduler (coming soon) | PostDelegate`;
const description = s.description ?? (available
  ? s.intro
  : `${s.name} scheduling on PostDelegate opens once ${pending}. Until then, try the ${openCount} networks open today: ${TRIAL_DAYS}-day free trial, no card.`);

const faq = available
  ? [
      { q: `Can I schedule ${s.name} posts for free?`, a: `Every PostDelegate plan starts with a ${TRIAL_DAYS}-day free trial, and no credit card is needed. During the trial you can connect ${s.name} and schedule posts like any other channel. There is no permanent free plan: to keep scheduling after the trial, choose a plan, which start at $${starter.monthly} a month.` },
      ...(s.faq ?? []),
      { q: `Can Claude or ChatGPT post to ${s.name}?`, a: `Yes, through MCP. Add PostDelegate to Claude or ChatGPT as a custom connector, and the assistant can list your channels, read the rules for ${s.name} and create a draft or scheduled post for you. Ask for a draft first and check it in the calendar before anything is scheduled. AI is bring-your-own, and PostDelegate never charges for it. See the [Claude setup](/docs/mcp/claude) and the [ChatGPT setup](/docs/mcp/chatgpt).` },
    ]
  : [
      { q: `Can I schedule ${s.name} posts with PostDelegate today?`, a: `Not yet. ${s.name} cannot be connected on PostDelegate today. It opens once ${pending}, and a network that is not marked available in the [platform directory](/platforms) does not work.` },
      { q: `When will ${s.name} be available?`, a: `We do not give dates, because platform review timelines are outside our control. When a connection opens it will appear under Add Channel in the app and get its own guide in the documentation. [Contact support](/support) to tell us you need it.` },
      { q: 'What can I do on PostDelegate while I wait?', a: `Start the ${TRIAL_DAYS}-day free trial, with no credit card, and connect any of the ${openCount} networks open today, such as YouTube, Bluesky, WordPress and Slack. The calendar, composer and media library work the same way for every channel.` },
      { q: `Can Claude or ChatGPT post to ${s.name}?`, a: `Not yet. An assistant connected over MCP can only work with channels that are connected in PostDelegate, so it cannot publish to ${s.name} until that connection exists. You can still use Claude or ChatGPT to draft the text, then bring it into PostDelegate. See the [MCP guide](/docs/mcp).` },
    ];

const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Platforms', item: `${SITE.url}/platforms` },
  { '@type': 'ListItem', position: 2, name: s.name, item: `${SITE.url}/${s.slug}` }] };
const howToLd = available && s.steps?.length ? { '@context': 'https://schema.org', '@type': 'HowTo', name: `How to ${howTo}`, description: s.intro, step: s.steps.map((step, index) => ({ '@type': 'HowToStep', position: index + 1, name: step.name, text: step.text })) } : undefined;
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: plain(item.a) } })) };
---
<Doc title={title} description={description} h1={s.h1} eyebrow={available ? `${s.name} · available now` : `${s.name} · coming soon`} lead={s.intro} jsonLd={[crumbs, ...(howToLd ? [howToLd] : []), faqLd]}>
  <a slot="actions" href={SITE.signup} class="button">{CTA_LABEL}</a>
  <a slot="actions" href="/tools/caption-checker" class="button button-outline">Try the caption checker</a>
  {network && <div class:list={['sch-head', { 'is-soon': !available }]}>
    <NetworkBadge n={network} size="lg" />
    <p><strong>{available ? `${s.name} is live on PostDelegate` : `${s.name}: ${s.pending ? 'pending approval' : 'coming soon'}`}</strong><span>{available ? `Plan it on one calendar with ${alongside.length} other live networks.` : `Meanwhile, ${openCount} networks connect today.`}</span></p>
    <LogoStack networks={alongside} max={6} size="xs" />
  </div>}
  {available
    ? <aside class="doc-note"><strong>Available now.</strong> Connect {s.name} from <strong>Add Channel</strong> on the calendar page. The <a href={s.docs}>{s.name} guide</a> has the exact fields and post settings.</aside>
    : <aside class="doc-note"><strong>Coming soon.</strong> {s.name} cannot be connected on PostDelegate yet. It opens once {pending}. See the <a href="/docs/channels">networks you can connect today</a>, or <a href="/support">contact support</a> to tell us you need it.</aside>}
  {available && !!s.steps?.length && <>
    <h2>How to {howTo}</h2>
    <ol>{s.steps.map((step, index) => <li id={`step-${index + 1}`}><strong>{step.name}.</strong> {step.text}</li>)}</ol>
  </>}
  <h2>{available ? `What you can publish to ${s.name}` : 'What is planned'}</h2>
  {available && s.about?.map((paragraph) => <p>{paragraph}</p>)}
  <ul>{s.plan.map((point) => <li>{point}</li>)}</ul>
  {available && !!s.settings?.length && <>
    <h2>{s.name} post settings</h2>
    <table>
      <thead><tr><th>Setting</th><th>Notes</th></tr></thead>
      <tbody>{s.settings.map((row) => <tr><td><strong>{row.label}</strong></td><td>{row.note}</td></tr>)}</tbody>
    </table>
  </>}
  <h2>Before connecting</h2>
  <ul>{s.limits.map((point) => <li>{point}</li>)}</ul>
  {available
    ? <p>Read the <a href={s.docs}>{s.name} guide</a> in our documentation for connection steps, post settings and troubleshooting.</p>
    : <p>See <a href={s.docs}>Coming soon</a> in our documentation for the networks that are not open yet.</p>}
  {available && <>
    <h2>Plan {s.name} with the rest of your channels</h2>
    <p>{s.name} sits on the same calendar as every other channel you connect. In one post you can pick several channels, write the content once and adjust it for each, and every channel keeps its own settings. Save a draft to review a post first, choose Add to Calendar to schedule it, or choose Post now to send it immediately. The <a href="/docs/posts">scheduling guide</a> covers drafts, repeats, previews and time slots.</p>
    <h2>Use Claude or ChatGPT with {s.name}</h2>
    <p>PostDelegate runs an MCP server, so an assistant you already use can look at your {s.name} channel, read its rules and create a draft for you to review. AI is bring-your-own, and PostDelegate never charges for it. Setup guides: <a href="/docs/mcp/claude">Claude</a>, <a href="/docs/mcp/chatgpt">ChatGPT</a>, and <a href="/guides/social-media-mcp-server">what a social media MCP server is</a>.</p>
  </>}
  <h2>Review the whole post</h2>
  <p>Check the destination, wording, media and time before scheduling. Look at the result in your workspace after publication; a queued item is not a published-post confirmation.</p>
  {!available && <p>For automation, see our <a href="/agents">integration previews</a>. No agent connection is implied by this platform page.</p>}
  <h2>Frequently asked questions</h2>
  <Faq items={faq.map((item) => ({ q: item.q, a: withLinks(item.a) }))} />
  {!!s.guides?.length && <>
    <h2>Guides</h2>
    <ul>{s.guides.map((guide) => <li><a href={guide.href}>{guide.label}</a></li>)}</ul>
  </>}
  <h2>{available ? `Schedule on ${alongside.length} more networks from the same calendar` : `Schedule on these ${openCount} networks today`}</h2>
  <div class="sch-grid"><NetworkGrid exclude={s.key} /></div>
</Doc>
<style>
  .sch-head { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 16px; margin: 0 0 22px; padding: 18px 20px; border: 1px solid #2c2c2c; border-radius: 18px; background: linear-gradient(180deg, #17151c, #131313); --stack-ring: #151417; }
  .sch-head p { display: flex; flex: 1 1 220px; flex-direction: column; gap: 2px; margin: 0; font-size: 14px; line-height: 1.5; }
  .sch-head p strong { color: #fff; font-size: 16px; }
  .sch-head.is-soon > :global(span[aria-hidden]) { filter: grayscale(1); opacity: .55; }
  .sch-grid { margin: 22px 0 36px; }
  .sch-grid :global(.ng-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
</style>
