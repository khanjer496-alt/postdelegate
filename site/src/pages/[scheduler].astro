---
import Doc from '../layouts/Doc.astro';
import { SCHEDULERS } from '../data/schedulers';
import { SITE } from '../data/site';
export function getStaticPaths() { return SCHEDULERS.map((s) => ({ params: { scheduler: s.slug }, props: { s } })); }
const { s } = Astro.props;
const others = SCHEDULERS.filter((other) => other.slug !== s.slug).slice(0, 6);
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Platforms', item: `${SITE.url}/platforms` },
  { '@type': 'ListItem', position: 2, name: s.name, item: `${SITE.url}/${s.slug}` }] };
---
<Doc title={`${s.name} coverage and rollout — PostDelegate`} description={s.intro} h1={s.h1} eyebrow={`${s.name} · rollout preview`} lead={s.intro} jsonLd={[crumbs]}>
  <a slot="actions" href={SITE.signup} class="button">Create a workspace</a>
  <a slot="actions" href="/tools/caption-checker" class="button button-outline">Try the caption checker</a>
  <aside class="doc-note"><strong>Channel rollout in progress.</strong> This page describes the Postiz foundation. It does not confirm that {s.name} is ready for every PostDelegate user. Check your workspace or <a href="/support">contact support</a> for availability.</aside>
  <h2>In the publishing foundation</h2>
  <ul>{s.plan.map((point) => <li>{point}</li>)}</ul>
  <h2>Before connecting</h2>
  <ul>{s.limits.map((point) => <li>{point}</li>)}</ul>
  <p>Use the <a href={s.docs} target="_blank" rel="noreferrer">upstream Postiz reference</a> to understand the provider. Its documentation describes the underlying platform, not the state of our hosted rollout.</p>
  <h2>Review the whole post</h2>
  <p>Check the destination, wording, media and time before scheduling. Look at the result in your workspace after publication; a queued item is not a published-post confirmation.</p>
  <p>For automation, see our <a href="/agents">integration previews</a>. No agent connection is implied by this platform page.</p>
  <h2>Explore more platform coverage</h2>
  <ul>{others.map((other) => <li><a href={`/${other.slug}`}>{other.name}</a></li>)}<li><a href="/platforms">All platform coverage</a></li></ul>
</Doc>
