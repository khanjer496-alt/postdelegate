---
import Doc from '../../layouts/Doc.astro';
import { GUIDES } from '../../data/guides';
import { SITE, CTA_LABEL } from '../../data/site';
const list = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'PostDelegate guides', url: `${SITE.url}/guides`, hasPart: GUIDES.map((guide) => ({ '@type': 'Article', headline: guide.title, url: `${SITE.url}/guides/${guide.slug}` })) };
---
<Doc title="Guides: Schedule Posts with AI and MCP | PostDelegate" description="Step-by-step guides for scheduling social media posts with Claude and ChatGPT over MCP, and for Bluesky, YouTube, client approvals and cross-posting." h1="Guides for planning, scheduling and automating your posts." eyebrow="Guides" lead="Practical walkthroughs that follow what PostDelegate does today. Each one links to the matching channel page and documentation." jsonLd={[list]}>
  <a slot="actions" href={SITE.signup} class="button">{CTA_LABEL}</a>
  <a slot="actions" href="/docs" class="button button-outline">Read the docs</a>
  <h2>Work with an AI assistant</h2>
  <div class="document-grid">
    {GUIDES.slice(0, 3).map((guide) => <a class="document-card" href={`/guides/${guide.slug}`}><h3>{guide.title}</h3><p>{guide.description}</p><span>Read the guide</span></a>)}
  </div>
  <h2>Schedule to a channel</h2>
  <div class="document-grid">
    {GUIDES.slice(3, 5).map((guide) => <a class="document-card" href={`/guides/${guide.slug}`}><h3>{guide.title}</h3><p>{guide.description}</p><span>Read the guide</span></a>)}
  </div>
  <h2>Workflows and reference</h2>
  <div class="document-grid">
    {GUIDES.slice(5).map((guide) => <a class="document-card" href={`/guides/${guide.slug}`}><h3>{guide.title}</h3><p>{guide.description}</p><span>Read the guide</span></a>)}
  </div>
</Doc>
