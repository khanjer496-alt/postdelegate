---
import Base from '../layouts/Base.astro';
import NetworkBadge from '../components/NetworkBadge.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { NETWORKS } from '../data/networks';
import { SITE, CTA_LABEL } from '../data/site';
const networks = [...NETWORKS].sort((a, b) => Number(!!b.available) - Number(!!a.available));
const href = (network: typeof NETWORKS[number]) => network.scheduler ? `/${network.scheduler}` : network.available ? `/docs/channels/${network.key}` : '/docs/channels/coming-soon';
---
<Base title="Platform coverage and channel rollout — PostDelegate" description="See which networks you can connect to PostDelegate today, from YouTube and Bluesky to WordPress and Slack, and which are coming soon as platforms approve us.">
  <PageHero eyebrow="Platform coverage" title="Your content belongs in one calendar." lead="Connect the networks marked available today. The rest are coming soon, opening as each platform approves PostDelegate.">
    <a href={SITE.signup} class="button">{CTA_LABEL}</a>
    <a href="/support" class="button button-outline">Ask about a channel</a>
  </PageHero>
  <section class="section"><div class="container">
    <p class="coverage-note muted">Networks marked available can be connected from Add Channel in your workspace. Account types and permissions still affect what each connection can do. See the <a href="/docs/channels">channel guides</a> for details.</p>
    <ul class="network-grid">
      {networks.map((network) => (
        <li><a href={href(network)} class="network-card">
          <NetworkBadge n={network} size="lg" />
          <span class="network-copy"><strong>{network.name}</strong><span>{network.available ? 'Connect it in your workspace' : 'Not connectable yet'}</span></span>
          <span class={network.available ? 'rollout-label is-available' : 'rollout-label'}>{network.available ? 'Available' : 'Coming soon'}</span>
        </a></li>
      ))}
    </ul>
    <p class="coverage-note muted">A Google login creates access to PostDelegate; it does not connect a YouTube channel or Google Business Profile. Each publishing destination has its own connection flow.</p>
  </div></section>
  <CtaBand />
</Base>
<style>
  .coverage-note { max-width: 760px; text-align: center; margin: 0 auto 34px; font-size: 15px; line-height: 1.85; }
  .network-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; list-style: none; padding: 0; margin: 0 0 35px; }
  .network-card { height: 100%; padding: 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 13px; border: 1px solid #363636; border-radius: 18px; background: #171717; color: #fff; text-decoration: none; transition: border-color .2s; }
  .network-card:hover { border-color: #888; }
  .network-copy { display: flex; flex: 1; min-width: 120px; flex-direction: column; gap: 5px; }
  .network-copy strong { font-size: 15px; font-weight: 750; }
  .network-copy > span { font-size: 11px; color: #b2b2ba; }
  .rollout-label { padding: 5px 8px; border: 1px solid #454545; border-radius: 100px; color: #b9b9c0; font-size: 10px; white-space: nowrap; }
  .rollout-label.is-available { border-color: #c8ff4d66; color: #c8ff4d; }
  .coverage-note a { color: #d1bfff; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1000px) { .network-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 580px) { .network-grid { grid-template-columns: 1fr; } }
</style>
