---
import Base from '../layouts/Base.astro';
import Pricing from '../components/Pricing.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, CTA_LABEL, CTA_NOTE } from '../data/site';
import { PLANS, TRIAL_DAYS } from '../data/plans';
import { AVAILABLE_NETWORKS } from '../data/networks';
const rows: [string, (plan: typeof PLANS[number]) => string][] = [
  ['Monthly price', (plan) => `$${plan.monthly}`],
  ['Yearly price', (plan) => `$${plan.yearly.toLocaleString('en-US')}`],
  ['Channels', (plan) => (plan.extraChannelMonthly ? `${plan.channels}, then $${plan.extraChannelMonthly}/month per extra channel, up to ${(plan.maxChannels || plan.channels).toLocaleString('en-US')}` : String(plan.channels))],
  ['Posts per month', () => 'No practical limit'],
  ['Team members', (plan) => (plan.teamMembers ? 'Yes' : 'No')],
  ['Public API and MCP', () => 'Yes'],
  ['Webhooks', (plan) => plan.webhooks.toLocaleString('en-US')],
  ['Free trial', () => `${TRIAL_DAYS} days`],
];
---
<Base title="Plans and pricing — PostDelegate" description={`PostDelegate plans start at $${PLANS[0].monthly} a month. Every plan starts with a ${TRIAL_DAYS}-day free trial, no credit card needed.`}>
  <PageHero eyebrow="Plans" title={`Pick a plan. Try it free for ${TRIAL_DAYS} days.`} lead="The plans differ in how many channels you connect, whether your team joins you and how many webhooks you run. Everything else comes with every plan.">
    <a href={SITE.signup} class="button">{CTA_LABEL}</a>
    <a href="/docs/billing" class="button button-outline">Read the billing guide</a>
    <p class="trial-note"><span aria-hidden="true"></span>{CTA_NOTE} · One trial per email</p>
  </PageHero>
  <section class="section"><div class="container"><Pricing heading={false} /></div></section>
  <section class="plan-compare"><div class="container">
    <h2>Compare plans</h2>
    <div class="compare-scroll">
      <table>
        <thead><tr><th scope="col"><span class="sr-only">Feature</span></th>{PLANS.map((plan) => <th scope="col">{plan.name}</th>)}</tr></thead>
        <tbody>{rows.map(([label, value]) => <tr><th scope="row">{label}</th>{PLANS.map((plan) => <td>{value(plan)}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </div></section>
  <section class="pricing-questions"><div class="container">
    <h2>Before you get started</h2>
    <div class="question-grid">
      <div><h3>How does the free trial work?</h3><p>Every plan starts with a {TRIAL_DAYS}-day free trial, and you do not need a credit card to start it. Add a card any time before the trial ends to keep your plan; the first payment is taken when the trial ends. If it ends without a card, your workspace is paused until you choose a plan. Your posts are kept, and your channels and team members are switched back on when you subscribe to a plan that includes them. Each email address gets one free trial.</p></div>
      <div><h3>Which channels can I connect?</h3><p>{AVAILABLE_NETWORKS.length} networks connect today, including YouTube, Bluesky, WordPress and Kick. Facebook, Instagram, TikTok, LinkedIn, X and others open as platform approvals come through. See <a href="/platforms">platform coverage</a>.</p></div>
      <div><h3>What if I need more than 100 channels?</h3><p>Ultimate includes 100 channels, then each extra channel costs $1 a month, or $9.60 a year on yearly billing, up to 900 extra channels (1,000 in total). A workspace admin adds them under <strong>Extra channels</strong> on the Billing page once the plan is paid. Changes are prorated, and you cannot go below the channels you already have connected.</p></div>
      <div><h3>Can I change or cancel my plan?</h3><p>Workspace admins can change plan, update the payment method or cancel from <strong>Billing</strong> in the app. Cancellation takes effect at the end of the period you have already paid for.</p></div>
      <div><h3>What about AI and automation?</h3><p>AI writing, the Agent and AI images run on your workspace's own OpenAI API key, added by an admin in <strong>Settings → AI</strong>. You pay OpenAI directly, and PostDelegate never charges for AI. AI video is not available. Every plan includes the REST API and MCP server, so you can also bring your own assistant, such as ChatGPT or Claude.</p></div>
    </div>
  </div></section>
  <CtaBand />
</Base>
<style>
  .trial-note { flex-basis: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 4px; color: #d6d6d6; font-size: 13px; font-weight: 600; }
  .trial-note span { width: 7px; height: 7px; border-radius: 50%; background: #c8ff4d; }
  .pricing-questions { padding: 0 0 80px; background: var(--bg, #0d0d0d); }
  h2 { text-align: center; font-size: clamp(30px, 4vw, 44px); font-weight: 800; letter-spacing: -.04em; margin-bottom: 36px; }
  .question-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 50px; max-width: 880px; margin: auto; }
  h3 { font-size: 18px; font-weight: 750; margin-bottom: 10px; }
  .question-grid p { color: var(--muted, #b9b9b9); font-size: 15px; line-height: 1.85; }
  .question-grid a { color: var(--text, #fff); text-decoration: underline; text-underline-offset: 4px; }
  .question-grid strong { color: var(--text, #fff); }
  .plan-compare { padding: 0 0 100px; background: var(--bg, #0d0d0d); }
  .compare-scroll { max-width: 880px; margin: auto; overflow-x: auto; border: 1px solid #303030; border-radius: 22px; background: #171717; }
  table { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 14px; }
  thead th { color: var(--text, #fff); font-size: 15px; font-weight: 750; }
  th, td { padding: 15px 18px; border-bottom: 1px solid #303030; text-align: left; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  tbody th { color: var(--muted, #b9b9b9); font-weight: 600; }
  td { color: var(--text, #fff); }
  @media (max-width: 600px) { .question-grid { grid-template-columns: 1fr; gap: 26px; } }
</style>
