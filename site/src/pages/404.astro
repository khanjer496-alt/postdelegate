---
import Doc from '../layouts/Doc.astro';
import { SITE } from '../data/site';
---
<Doc title="Page not found — PostDelegate" description="The page you were looking for is not on the PostDelegate website." h1="This page took a day off." eyebrow="Page not found" lead="The link may be old, or the address may have a typo. Here are a few good places to pick up again." cta={false} noindex>
  <a slot="actions" href="/" class="button">Back to the home page</a>
  <a slot="actions" href="/docs" class="button button-outline">Read the docs</a>
  <div class="document-grid">
    <a href="/docs" class="document-card"><h2>Documentation</h2><p>Guides for posts, media, channels, the REST API and MCP.</p><span>Open the docs →</span></a>
    <a href="/platforms" class="document-card"><h2>Channels</h2><p>See which networks you can connect today and what is coming soon.</p><span>Explore channels →</span></a>
    <a href="/support" class="document-card"><h2>Support</h2><p>Tell us what you were looking for and we will point you to it.</p><span>Contact support →</span></a>
    <a href={SITE.app} class="document-card"><h2>Your workspace</h2><p>Go straight to your calendar, drafts and media library.</p><span>Open the workspace →</span></a>
  </div>
</Doc>
