---
import Doc from '../layouts/Doc.astro';
import { SITE } from '../data/site';
// Changes that are live in the app, newest first. Dates are the release day in Dubai time (UTC+4).
// Add an entry only once the release that contains it is live on app.postdelegate.com.
const releases: { date: string; items: { title: string; text: string; href?: string }[] }[] = [
  { date: '2026-11-06', items: [
    { title: 'Google Business Profile is live', text: 'Sign in with Google, pick a business location and schedule updates, events and offers with an optional image and button.', href: '/docs/channels/google-business' },
  ] },
  { date: '2026-11-05', items: [
    { title: 'Mastodon is live', text: 'Sign in with a mastodon.social account and schedule posts and threads with up to four images or one video.', href: '/docs/channels/mastodon' },
  ] },
  { date: '2026-11-02', items: [
    { title: 'Five more Studio templates', text: 'Image slideshow, before/after, top list, quote card, and AI UGC, which writes and voices a short script on your own OpenAI key. Add your own music to your videos.', href: '/docs/studio#templates' },
    { title: 'Studio from Claude, ChatGPT or the API', text: 'Assistants and scripts can create, render and schedule Studio videos through MCP and the public API.', href: '/docs/studio#from-claude-chatgpt-or-the-api' },
    { title: 'Transfer ownership', text: 'Hand a workspace to another admin. While you are its only owner, you transfer it before you can delete your account.', href: '/docs/team#transfer-ownership' },
    { title: 'New screens in every app language', text: 'The newest screens, including Studio, approvals and billing, are translated into every language the app offers.' },
    { title: 'Fixes', text: 'Clearer errors when a channel rejects a post; fixes for Telegram, Twitch, Kick, Nostr, Slack, Hashnode and Medium posts; approvals that cover every channel in a post; and invitation fixes.' },
  ] },
  { date: '2026-11-01', items: [
    { title: 'Content Studio', text: 'Turn a video from your media library into a vertical 1080×1920 video of up to 90 seconds, with a hook line over the clip or captions that light up word by word.', href: '/docs/studio' },
    { title: 'Bulk video scheduling', text: 'Add up to 50 videos, pick your channels, and PostDelegate spreads them across each channel’s posting time slots, with a preview of every date before anything is scheduled.', href: '/docs/bulk-import' },
    { title: 'Views analytics', text: 'A Views section that charts the views each channel gains per day and ranks posts by views gained. YouTube shares view counts today.', href: '/docs/analytics#views' },
    { title: 'YouTube: publish later and the AI content label', text: 'Upload a video as private and let YouTube make it public at the time you set, and mark realistic altered or AI-made content.', href: '/docs/channels/youtube#publish-later-on-youtube' },
    { title: 'Extra channels on Ultimate', text: 'Ultimate includes 100 channels; add more at $1 a month each, up to 1,000 channels in total.', href: '/docs/billing#extra-channels' },
    { title: 'Agent files', text: 'Hosted instruction files for assistants: a Claude skill, AGENTS.md for coding agents, ChatGPT instructions and a Cursor rule.', href: '/docs/mcp/agent-files' },
    { title: 'Telegram is live', text: 'Add @PostDelegateBot to a channel or group and schedule text, photos, videos and albums.', href: '/docs/channels/telegram' },
    { title: 'Discord is live', text: 'Connect a Discord server and schedule announcements. Posts only go to channels in the connected server, with role mentions and follow-ups in a thread.', href: '/docs/channels/discord' },
    { title: 'Fixes', text: 'Kick posts publish again; opening /studio directly no longer fails; the trim bar finds the length of every clip; Studio explains what is missing in plain words; and moving to a bigger plan during the no-card trial now asks for a card.' },
  ] },
  { date: '2026-10-31', items: [
    { title: 'Approvals and the AI review inbox', text: 'Post statuses, client approval links that need no account, and an inbox where drafts from AI assistants wait for a person.', href: '/docs/approvals' },
    { title: 'Bring your own OpenAI key', text: 'AI writing, the Agent and AI images run on your workspace’s own OpenAI key. PostDelegate never charges for AI.', href: '/docs/ai' },
    { title: 'Analytics history and reports', text: 'Daily history, trends, top posts, best times, CSV export, PDF and scheduled reports, and a weekly summary email.', href: '/docs/analytics' },
    { title: 'CSV import, evergreen posts and campaigns', text: 'Import up to 200 posts from a CSV file, recycle evergreen posts on a schedule, and group work into campaigns and an ideas board.', href: '/docs/evergreen' },
    { title: '7-day free trial with no card', text: 'Every plan starts with a 7-day free trial that needs no credit card.', href: '/docs/billing#the-7-day-trial' },
  ] },
];
const fmt = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Doc title="Changelog — what's new in PostDelegate" description="What changed in PostDelegate, newest first: Google Business Profile, Mastodon, Studio templates, ownership transfer, bulk video and more." h1="Changelog." eyebrow="What's new" lead="Changes that are live in the app, newest first, dated in Dubai time. Network approvals are tracked on the roadmap.">
  <a slot="actions" href="/roadmap" class="button button-outline">See the roadmap</a>
  {releases.map((release) => (
    <section class="release">
      <h2><time datetime={release.date}>{fmt(release.date)}</time></h2>
      <ul>{release.items.map((item) => <li><strong>{item.title}.</strong> {item.text}{item.href && <> <a href={item.href}>Read more</a></>}</li>)}</ul>
    </section>
  ))}
  <p>Something missing or broken? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
</Doc>
