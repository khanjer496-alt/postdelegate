# Install as /etc/postiz/alerts.env, root:root 0600; never commit real values.
# The topic URL / webhook URL is a secret: anyone who knows it can post alerts.
# ntfy.sh: https://ntfy.sh/<long-random-topic>   (subscribe in the ntfy phone app)
# Slack / Discord incoming webhook URLs are detected automatically.
ALERT_WEBHOOK_URL=CHANGE_ME
# Optional tuning (defaults shown):
# ALERT_WEBHOOK_FORMAT=auto       # auto | json | text
# HEALTH_FAIL_THRESHOLD=2         # consecutive failed runs (10 min apart) before the first alert
# HEALTH_REMINDER_HOURS=6
# HEALTH_DISK_MAX_PCT=85
# HEALTH_BACKUP_MAX_AGE_HOURS=26
# HEALTH_OFFSITE_MAX_AGE_HOURS=26
# APP_HEALTH_URL=https://app.postdelegate.com/api/auth/can-register
