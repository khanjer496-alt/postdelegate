# Install as /etc/postiz/backup-r2.env, root:root 0600; never commit real values.
# Credentials for the PRIVATE off-site backup bucket only. Use a bucket-scoped
# R2 token (Object Read & Write) that is different from the media bucket token.
BACKUP_R2_ACCOUNT_ID=CHANGE_ME_32_CHARACTER_CLOUDFLARE_ACCOUNT_ID
BACKUP_R2_ACCESS_KEY_ID=CHANGE_ME
BACKUP_R2_SECRET_ACCESS_KEY=CHANGE_ME
BACKUP_R2_BUCKET=postdelegate-backups
# PUBLIC age recipient(s), starting with age1. The matching private key stays
# offline in the owner's password manager and is never copied to this server.
# Separate several recipients with spaces.
AGE_RECIPIENT=CHANGE_ME
# Optional tuning (defaults shown):
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_MAX_AGE_HOURS=26
# BACKUP_VERIFY_READBACK=1
