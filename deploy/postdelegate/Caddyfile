app.postdelegate.com {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
    }
    handle /source {
        redir * /source/postdelegate-source.tar.gz 302
    }
    handle_path /source/* {
        root * /source
        file_server
    }
    handle {
        reverse_proxy postiz:5000
    }
}
