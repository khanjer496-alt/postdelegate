app.postdelegate.com {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
    }
    handle /source {
        redir * /source/postdelegate-source.tar.gz 302
    }
    handle_path /source/* {
        root * /source
        file_server
    }
    @privacy path /legal/privacy /legal/privacy/
    handle @privacy {
        root * /legal-public
        rewrite * /privacy.html
        file_server
    }
    @terms path /legal/terms /legal/terms/
    handle @terms {
        root * /legal-public
        rewrite * /terms.html
        file_server
    }
    handle {
        reverse_proxy postiz:5000
    }
}
